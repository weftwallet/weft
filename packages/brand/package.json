{
  "name": "@weftwallet/brand",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weftwallet/weft.git",
    "directory": "packages/brand"
  },
  "description": "Weft's logos, product marks, design tokens and product registry",
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./products": {
      "types": "./products.d.mts",
      "default": "./products.mjs"
    },
    "./products.json": "./products.json",
    "./logo/*": "./logo/*"
  },
  "files": [
    "logo",
    "tokens.css",
    "tokens.json",
    "products.json",
    "products.mjs",
    "products.d.mts",
    "SYSTEM.md"
  ],
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "marks": "node scripts/marks.mjs",
    "loaders": "node scripts/loaders.mjs"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "opentype.js": "1.3.4"
  }
}

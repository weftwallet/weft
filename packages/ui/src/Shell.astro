---
/**
 * The page every Weft site except the docs is built in: the product's mark and
 * name, its own navigation, a switcher to the other products, the theme
 * control, and the footer. The docs keep Starlight's frame, with the same
 * mark and links.
 */
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { products, type ProductId } from "@weftwallet/brand/products";
import { productHref, siteProducts } from "./links";
import ProductSwitcher from "./ProductSwitcher.astro";
import ThemeControl from "./ThemeControl.astro";
import "./base.css";

interface Props {
  /** The product this page belongs to. */
  product: ProductId;
  /** The page's own title; the product's name is added after it. */
  title?: string;
  description?: string;
  /** Wider content, for tools that need the room. */
  wide?: boolean;
}

const { product, title, description, wide = false } = Astro.props;
const require = createRequire(import.meta.url);
const svg = (file: string) => readFileSync(require.resolve(`@weftwallet/brand/${file}`), "utf8");
const markOf = (id: ProductId) => svg(products[id].markSmall).replace(/<svg /, '<svg aria-hidden="true" focusable="false" ').replace(/\s+role="img"/, "").replace(/\s+aria-label="[^"]*"/, "");
const me = products[product];
const word = product === "site" ? "" : me.name.replace(/^Weft /, "").toLowerCase();
const pageTitle = title ? `${title} | ${me.name}` : me.name;
const icon = `data:image/svg+xml;base64,${Buffer.from(svg(me.markSmall)).toString("base64")}`;
const github = "https://github.com/ifeanyi-ugwu/weft";
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={icon} />
    <script is:inline>
      // Before the first paint, so a chosen theme never flashes the other one.
      try {
        const t = localStorage.getItem("weft-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="shell-skip" href="#main">Skip to the content</a>
    <header class="shell-head">
      <div class="shell-bar">
        <a class="shell-lockup" href={productHref(product)}>
          <Fragment set:html={markOf(product)} />
          <span class="shell-word">weft{word && <span class="shell-word__product"> {word}</span>}</span>
        </a>
        <nav class="shell-nav" aria-label={me.name}><slot name="nav" /></nav>
        <div class="shell-tools">
          <ProductSwitcher product={product} />
          <ThemeControl />
        </div>
      </div>
    </header>

    <main id="main" class:list={["shell-main", { "shell-main--wide": wide }]}>
      <slot />
    </main>

    <footer class="shell-foot">
      <div class="shell-foot__inner">
        <ul class="shell-foot__products">
          {
            siteProducts.map((p) => (
              <li>
                <a href={productHref(p.id)}>
                  <Fragment set:html={markOf(p.id)} />
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p>
          Weft is open source under the Apache 2.0 licence. <a href={github}>Source on GitHub</a>.
        </p>
      </div>
    </footer>


    <style>
      .shell-skip {
        position: absolute;
        left: var(--weft-space-4);
        top: var(--weft-space-2);
        z-index: 20;
        padding: var(--weft-space-2) var(--weft-space-3);
        border-radius: var(--weft-radius-sm);
        background: var(--weft-bg-overlay);
        transform: translateY(-200%);
      }
      .shell-skip:focus-visible {
        transform: none;
      }
      .shell-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .shell-head {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--weft-bg) 88%, transparent);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--weft-line);
      }
      .shell-bar,
      .shell-foot__inner {
        max-width: 1200px;
        margin: 0 auto;
        padding-inline: max(var(--weft-space-4), env(safe-area-inset-left, 0px)) max(var(--weft-space-4), env(safe-area-inset-right, 0px));
      }
      .shell-bar {
        height: 60px;
        display: flex;
        align-items: center;
        gap: var(--weft-space-6);
      }
      .shell-lockup {
        display: flex;
        align-items: center;
        gap: var(--weft-space-2);
        color: var(--weft-text-strong);
        text-decoration: none;
        flex: none;
      }
      .shell-lockup :global(svg) {
        width: 28px;
        height: 28px;
        display: block;
      }
      .shell-word {
        font: 500 var(--weft-type-lg) / 1 var(--weft-font-mono);
        letter-spacing: -0.03em;
      }
      .shell-word__product {
        color: var(--weft-text-subtle);
      }
      .shell-nav {
        display: flex;
        align-items: center;
        gap: var(--weft-space-1);
        min-width: 0;
        overflow-x: auto;
      }
      .shell-nav :global(a) {
        padding: var(--weft-space-2) var(--weft-space-3);
        border-radius: var(--weft-radius-sm);
        color: var(--weft-text-muted);
        font-size: var(--weft-type-md);
        line-height: var(--weft-leading-md);
        text-decoration: none;
        white-space: nowrap;
        transition: color var(--weft-duration-fast) var(--weft-ease-out), background-color var(--weft-duration-fast) var(--weft-ease-out);
      }
      .shell-nav :global(a:hover) {
        color: var(--weft-text);
      }
      .shell-nav :global(a[aria-current="page"]) {
        color: var(--weft-text-strong);
        background: var(--weft-bg-raised);
      }
      .shell-tools {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: var(--weft-space-3);
      }
      .shell-main {
        max-width: 1200px;
        margin: 0 auto;
        padding-inline: max(var(--weft-space-4), env(safe-area-inset-left, 0px)) max(var(--weft-space-4), env(safe-area-inset-right, 0px));
        padding-block: var(--weft-space-12) var(--weft-space-24);
        display: flex;
        flex-direction: column;
        gap: var(--weft-space-8);
      }
      .shell-main:not(.shell-main--wide) {
        max-width: 880px;
      }
      .shell-foot {
        border-top: 1px solid var(--weft-line);
        padding-block: var(--weft-space-10);
        font-size: var(--weft-type-md);
        line-height: var(--weft-leading-md);
        color: var(--weft-text-subtle);
      }
      .shell-foot__inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--weft-space-6);
      }
      .shell-foot__products {
        display: flex;
        flex-wrap: wrap;
        gap: var(--weft-space-2) var(--weft-space-6);
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .shell-foot__products a {
        display: flex;
        align-items: center;
        gap: var(--weft-space-2);
        color: var(--weft-text-muted);
        text-decoration: none;
      }
      .shell-foot__products a:hover {
        color: var(--weft-text);
      }
      .shell-foot__products :global(svg) {
        width: 16px;
        height: 16px;
        display: block;
      }
      @media (max-width: 720px) {
        .shell-bar {
          gap: var(--weft-space-3);
        }
      }
    </style>
  </body>
</html>

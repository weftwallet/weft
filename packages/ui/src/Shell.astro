---
/**
 * The page every Weft site except the docs is built in: the header
 * (header.css: the product's mark and name, its own navigation, a switcher
 * to the other products, the theme control), the content and the footer.
 * The docs render the same header from Starlight's overrides, and the
 * explorer from its templates; header.css documents the markup.
 */
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { products, type ProductId } from "@weftwallet/brand/products";
import { productHref, siteProducts } from "./links";
import ProductSwitcher from "./ProductSwitcher.astro";
import ThemeControl from "./ThemeControl.astro";
import "./base.css";

interface Props {
  /** The product this page belongs to. */
  product: ProductId;
  /** The page's own title; the product's name is added after it. */
  title?: string;
  description?: string;
  /** Wider content, for tools that need the room. */
  wide?: boolean;
}

/**
 * Slots: the default is the page; "nav" is the product's own links (plain
 * <a> elements, the current one with aria-current="page"); "search" is a
 * search form for the tools, where the product has one (header.css has its
 * markup, form.shell-search).
 */

const { product, title, description, wide = false } = Astro.props;
const require = createRequire(import.meta.url);
const svg = (file: string) => readFileSync(require.resolve(`@weftwallet/brand/${file}`), "utf8");
const markOf = (id: ProductId) => svg(products[id].markSmall).replace(/<svg /, '<svg aria-hidden="true" focusable="false" ').replace(/\s+role="img"/, "").replace(/\s+aria-label="[^"]*"/, "");
const me = products[product];
const word = product === "site" ? "" : me.name.replace(/^Weft /, "").toLowerCase();
const pageTitle = title ? `${title} | ${me.name}` : me.name;
const icon = `data:image/svg+xml;base64,${Buffer.from(svg(me.markSmall)).toString("base64")}`;
// The product's loader, for anything marked .is-working (base.css).
const loader = `--weft-loader: url("data:image/svg+xml;base64,${Buffer.from(svg(me.loaderSmall)).toString("base64")}")`;
const github = "https://github.com/ifeanyi-ugwu/weft";
// Before the first paint: the stored theme, and the page transition's
// direction. One file, shared with the docs and the explorer.
const early = readFileSync(require.resolve("@weftwallet/ui/early.js"), "utf8");
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={icon} />
    <script is:inline data-theme-key="weft-theme" set:html={early}></script>
  </head>
  <body style={loader}>
    <a class="shell-skip" href="#main">Skip to the content</a>
    <p id="weft-status" class="visually-hidden" role="status"></p>
    <header class="shell-head">
      <div class="shell-bar">
        <a class="shell-lockup" href={productHref(product)}>
          <Fragment set:html={markOf(product)} />
          <span class="shell-word">weft{word && <span class="shell-word__product"> {word}</span>}</span>
        </a>
        <nav class="shell-nav" aria-label={me.name}><slot name="nav" /></nav>
        <div class="shell-tools">
          <slot name="search" />
          <ProductSwitcher product={product} />
          <ThemeControl />
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class:list={["shell-main", { "shell-main--wide": wide }]}>
      <slot />
    </main>

    <footer class="shell-foot">
      <div class="shell-foot__inner">
        <ul class="shell-foot__products">
          {
            siteProducts.map((p) => (
              <li>
                <a href={productHref(p.id)}>
                  <Fragment set:html={markOf(p.id)} />
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p>
          Weft is open source under the Apache 2.0 licence. <a href={github}>Source on GitHub</a>.
        </p>
      </div>
    </footer>


    <style>
      .shell-skip {
        position: absolute;
        left: var(--weft-space-4);
        top: var(--weft-space-2);
        z-index: 20;
        padding: var(--weft-space-2) var(--weft-space-3);
        border-radius: var(--weft-radius-sm);
        background: var(--weft-bg-overlay);
        transform: translateY(-200%);
      }
      .shell-skip:focus-visible {
        transform: none;
      }
      #main:focus {
        outline: none;
      }
      .shell-main {
        max-width: 1200px;
        margin: 0 auto;
        padding-inline: max(var(--weft-space-4), env(safe-area-inset-left, 0px)) max(var(--weft-space-4), env(safe-area-inset-right, 0px));
        padding-block: var(--weft-space-12) var(--weft-space-24);
        display: flex;
        flex-direction: column;
        gap: var(--weft-space-8);
      }
      .shell-main:not(.shell-main--wide) {
        max-width: 880px;
      }
      .shell-foot {
        border-top: 1px solid var(--weft-line);
        padding-block: var(--weft-space-10);
        font-size: var(--weft-type-md);
        line-height: var(--weft-leading-md);
        color: var(--weft-text-subtle);
      }
      .shell-foot__inner {
        max-width: 1200px;
        margin: 0 auto;
        padding-inline: max(var(--weft-space-4), env(safe-area-inset-left, 0px)) max(var(--weft-space-4), env(safe-area-inset-right, 0px));
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--weft-space-6);
      }
      .shell-foot__products {
        display: flex;
        flex-wrap: wrap;
        gap: var(--weft-space-2) var(--weft-space-6);
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .shell-foot__products a {
        display: flex;
        align-items: center;
        gap: var(--weft-space-2);
        color: var(--weft-text-muted);
        text-decoration: none;
        transition: color var(--weft-duration-fast) var(--weft-ease-out);
      }
      .shell-foot__products :global(svg) {
        width: 16px;
        height: 16px;
        display: block;
      }
      @media (hover: hover) {
        .shell-foot__products a:hover {
          color: var(--weft-text);
        }
      }
    </style>
  </body>
</html>

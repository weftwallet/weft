---
/**
 * The page every Weft site except the docs is built in: the product's mark and
 * name, its own navigation, a switcher to the other products, the theme
 * control, and the footer. The docs keep Starlight's frame, with the same
 * mark and links.
 */
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { products, type ProductId } from "@weftwallet/brand/products";
import { productHref, siteProducts } from "./links";
import "./base.css";

interface Props {
  /** The product this page belongs to. */
  product: ProductId;
  /** The page's own title; the product's name is added after it. */
  title?: string;
  description?: string;
  /** Wider content, for tools that need the room. */
  wide?: boolean;
}

const { product, title, description, wide = false } = Astro.props;
const require = createRequire(import.meta.url);
const svg = (file: string) => readFileSync(require.resolve(`@weftwallet/brand/${file}`), "utf8");
const markOf = (id: ProductId) => svg(products[id].markSmall).replace(/<svg /, '<svg aria-hidden="true" focusable="false" ').replace(/\s+role="img"/, "").replace(/\s+aria-label="[^"]*"/, "");
const me = products[product];
const word = product === "site" ? "" : me.name.replace(/^Weft /, "").toLowerCase();
const pageTitle = title ? `${title} | ${me.name}` : me.name;
const icon = `data:image/svg+xml;base64,${Buffer.from(svg(me.markSmall)).toString("base64")}`;
const github = "https://github.com/ifeanyi-ugwu/weft";
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={icon} />
    <script is:inline>
      // Before the first paint, so a chosen theme never flashes the other one.
      try {
        const t = localStorage.getItem("weft-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="shell-skip" href="#main">Skip to the content</a>
    <header class="shell-head">
      <div class="shell-bar">
        <a class="shell-lockup" href={productHref(product)}>
          <Fragment set:html={markOf(product)} />
          <span class="shell-word">weft{word && <span class="shell-word__product"> {word}</span>}</span>
        </a>
        <nav class="shell-nav" aria-label={me.name}><slot name="nav" /></nav>
        <div class="shell-tools">
          <details class="shell-switcher" data-switcher>
            <summary>
              <svg class="shell-switcher__grid" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1.5" /><rect x="14" y="4" width="6" height="6" rx="1.5" /><rect x="4" y="14" width="6" height="6" rx="1.5" /><rect x="14" y="14" width="6" height="6" rx="1.5" /></svg>
              <span class="shell-switcher__label">Products</span>
              <svg class="shell-switcher__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </summary>
            <ul class="shell-switcher__menu">
              {
                siteProducts.map((p) => (
                  <li>
                    <a href={productHref(p.id)} aria-current={p.id === product ? "page" : undefined}>
                      <Fragment set:html={markOf(p.id)} />
                      <span>
                        <strong>{p.name}</strong>
                        <span>{p.summary}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
          <div class="shell-theme" role="group" aria-label="Theme">
            <button type="button" data-theme-choice="system" aria-pressed="true" title="Match the system">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
              <span class="shell-sr">System</span>
            </button>
            <button type="button" data-theme-choice="light" aria-pressed="false" title="Light">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
              <span class="shell-sr">Light</span>
            </button>
            <button type="button" data-theme-choice="dark" aria-pressed="false" title="Dark">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
              <span class="shell-sr">Dark</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="main" class:list={["shell-main", { "shell-main--wide": wide }]}>
      <slot />
    </main>

    <footer class="shell-foot">
      <div class="shell-foot__inner">
        <ul class="shell-foot__products">
          {
            siteProducts.map((p) => (
              <li>
                <a href={productHref(p.id)}>
                  <Fragment set:html={markOf(p.id)} />
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p>
          Weft is open source under the Apache 2.0 licence. <a href={github}>Source on GitHub</a>.
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]");
      const mark = (choice: string) => buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeChoice === choice)));
      mark(root.dataset.theme ?? "system");
      buttons.forEach((b) =>
        b.addEventListener("click", () => {
          const choice = b.dataset.themeChoice!;
          const apply = () => {
            if (choice === "system") delete root.dataset.theme;
            else root.dataset.theme = choice;
            mark(choice);
          };
          try {
            if (choice === "system") localStorage.removeItem("weft-theme");
            else localStorage.setItem("weft-theme", choice);
          } catch {}
          const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (document.startViewTransition && !still) document.startViewTransition(apply);
          else apply();
        }),
      );

      // The products menu closes on Escape and on a click outside it.
      const switcher = document.querySelector<HTMLDetailsElement>("[data-switcher]");
      if (switcher) {
        document.addEventListener("click", (e) => {
          if (switcher.open && !switcher.contains(e.target as Node)) switcher.open = false;
        });
        switcher.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && switcher.open) {
            switcher.open = false;
            switcher.querySelector("summary")?.focus();
          }
        });
      }
    </script>

    <style>
      .shell-skip {
        position: absolute;
        left: var(--weft-space-4);
        top: var(--weft-space-2);
        z-index: 20;
        padding: var(--weft-space-2) var(--weft-space-3);
        border-radius: var(--weft-radius-sm);
        background: var(--weft-bg-overlay);
        transform: translateY(-200%);
      }
      .shell-skip:focus-visible {
        transform: none;
      }
      .shell-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .shell-head {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--weft-bg) 88%, transparent);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--weft-line);
      }
      .shell-bar,
      .shell-foot__inner {
        max-width: 1200px;
        margin: 0 auto;
        padding-inline: max(var(--weft-space-4), env(safe-area-inset-left, 0px)) max(var(--weft-space-4), env(safe-area-inset-right, 0px));
      }
      .shell-bar {
        height: 60px;
        display: flex;
        align-items: center;
        gap: var(--weft-space-6);
      }
      .shell-lockup {
        display: flex;
        align-items: center;
        gap: var(--weft-space-2);
        color: var(--weft-text-strong);
        text-decoration: none;
        flex: none;
      }
      .shell-lockup :global(svg) {
        width: 28px;
        height: 28px;
        display: block;
      }
      .shell-word {
        font: 500 var(--weft-type-lg) / 1 var(--weft-font-mono);
        letter-spacing: -0.03em;
      }
      .shell-word__product {
        color: var(--weft-text-subtle);
      }
      .shell-nav {
        display: flex;
        align-items: center;
        gap: var(--weft-space-1);
        min-width: 0;
        overflow-x: auto;
      }
      .shell-nav :global(a) {
        padding: var(--weft-space-2) var(--weft-space-3);
        border-radius: var(--weft-radius-sm);
        color: var(--weft-text-muted);
        font-size: var(--weft-type-md);
        line-height: var(--weft-leading-md);
        text-decoration: none;
        white-space: nowrap;
        transition: color var(--weft-duration-fast) var(--weft-ease-out), background-color var(--weft-duration-fast) var(--weft-ease-out);
      }
      .shell-nav :global(a:hover) {
        color: var(--weft-text);
      }
      .shell-nav :global(a[aria-current="page"]) {
        color: var(--weft-text-strong);
        background: var(--weft-bg-raised);
      }
      .shell-tools {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: var(--weft-space-3);
      }
      .shell-switcher {
        position: relative;
      }
      .shell-switcher summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: var(--weft-space-1);
        height: 36px;
        padding: 0 var(--weft-space-3);
        border: 1px solid var(--weft-line);
        border-radius: var(--weft-radius-lg);
        color: var(--weft-text-muted);
        font-size: var(--weft-type-md);
        cursor: pointer;
        transition: border-color var(--weft-duration-fast) var(--weft-ease-out), color var(--weft-duration-fast) var(--weft-ease-out);
      }
      .shell-switcher summary::-webkit-details-marker {
        display: none;
      }
      .shell-switcher summary:hover,
      .shell-switcher[open] summary {
        border-color: var(--weft-line-strong);
        color: var(--weft-text);
      }
      .shell-switcher__chevron {
        transition: transform var(--weft-duration-base) var(--weft-ease-out);
      }
      .shell-switcher[open] .shell-switcher__chevron {
        transform: rotate(180deg);
      }
      .shell-switcher__grid {
        display: none;
      }
      .shell-switcher__menu {
        position: absolute;
        right: 0;
        top: calc(100% + var(--weft-space-2));
        width: min(340px, calc(100vw - 2 * var(--weft-space-4)));
        margin: 0;
        padding: var(--weft-space-2);
        list-style: none;
        background: var(--weft-bg-overlay);
        border: 1px solid var(--weft-line-strong);
        border-radius: var(--weft-radius-xl);
        box-shadow: var(--weft-shadow-3);
        animation: shell-arrive var(--weft-duration-base) var(--weft-ease-out) both;
      }
      @keyframes shell-arrive {
        from {
          opacity: 0;
          transform: translateY(calc(var(--weft-shift-md) * -1));
        }
      }
      .shell-switcher__menu a {
        display: flex;
        gap: var(--weft-space-3);
        align-items: flex-start;
        padding: var(--weft-space-3);
        border-radius: var(--weft-radius-lg);
        color: var(--weft-text);
        text-decoration: none;
        transition: background-color var(--weft-duration-fast) var(--weft-ease-out);
      }
      .shell-switcher__menu a:hover {
        background: var(--weft-bg-raised);
      }
      .shell-switcher__menu a[aria-current="page"] {
        background: var(--weft-accent-soft);
      }
      .shell-switcher__menu :global(svg) {
        width: 24px;
        height: 24px;
        flex: none;
        display: block;
      }
      .shell-switcher__menu a > span {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: var(--weft-type-md);
        line-height: var(--weft-leading-md);
      }
      .shell-switcher__menu strong {
        font-weight: 600;
        color: var(--weft-text-strong);
      }
      .shell-switcher__menu a > span > span {
        color: var(--weft-text-muted);
        font-size: var(--weft-type-xs);
        line-height: var(--weft-leading-xs);
      }
      .shell-theme {
        display: flex;
        padding: 2px;
        gap: 2px;
        border: 1px solid var(--weft-line);
        border-radius: var(--weft-radius-lg);
      }
      .shell-theme button {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: var(--weft-radius-sm);
        background: transparent;
        color: var(--weft-text-subtle);
        cursor: pointer;
        transition: color var(--weft-duration-fast) var(--weft-ease-out), background-color var(--weft-duration-fast) var(--weft-ease-out);
      }
      .shell-theme button:hover {
        color: var(--weft-text);
      }
      .shell-theme button[aria-pressed="true"] {
        background: var(--weft-bg-raised);
        color: var(--weft-text-strong);
      }
      .shell-main {
        max-width: 1200px;
        margin: 0 auto;
        padding-inline: max(var(--weft-space-4), env(safe-area-inset-left, 0px)) max(var(--weft-space-4), env(safe-area-inset-right, 0px));
        padding-block: var(--weft-space-12) var(--weft-space-24);
        display: flex;
        flex-direction: column;
        gap: var(--weft-space-8);
      }
      .shell-main:not(.shell-main--wide) {
        max-width: 880px;
      }
      .shell-foot {
        border-top: 1px solid var(--weft-line);
        padding-block: var(--weft-space-10);
        font-size: var(--weft-type-md);
        line-height: var(--weft-leading-md);
        color: var(--weft-text-subtle);
      }
      .shell-foot__inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--weft-space-6);
      }
      .shell-foot__products {
        display: flex;
        flex-wrap: wrap;
        gap: var(--weft-space-2) var(--weft-space-6);
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .shell-foot__products a {
        display: flex;
        align-items: center;
        gap: var(--weft-space-2);
        color: var(--weft-text-muted);
        text-decoration: none;
      }
      .shell-foot__products a:hover {
        color: var(--weft-text);
      }
      .shell-foot__products :global(svg) {
        width: 16px;
        height: 16px;
        display: block;
      }
      @media (max-width: 720px) {
        .shell-bar {
          gap: var(--weft-space-3);
        }
        .shell-switcher__label {
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip-path: inset(50%);
        }
        .shell-switcher__chevron {
          display: none;
        }
        .shell-switcher__grid {
          display: block;
        }
      }
    </style>
  </body>
</html>

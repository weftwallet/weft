---
/**
 * The theme toggle every Weft site shows: one 36px button. It follows the
 * device until pressed; a press flips light and dark and keeps the choice
 * in localStorage; pressing back to the device's own theme forgets the
 * choice, so the page follows the device again. The page's early script
 * (early.js) applies a stored choice before the first paint, and the icon
 * follows the page's theme by CSS, so it is right from the first paint too.
 * The styles are in header.css and the behaviour in theme-control.js, which
 * the header inlines after itself (Shell.astro, the docs' Header.astro), so
 * the explorer can render the same control from its own template; both
 * files document the markup.
 */
interface Props {
  /** Where the choice is kept. The docs use Starlight's key. */
  storageKey?: string;
  /**
   * Set data-theme to the device's theme when following the device, rather
   * than removing it. Starlight's styles need data-theme to be set.
   */
  alwaysSet?: boolean;
}

const { storageKey = "weft-theme", alwaysSet = false } = Astro.props;
const id = Math.random().toString(36).slice(2, 7);
const rays = "M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06";
---

<button type="button" class="weft-theme shell-tool" aria-pressed="false" aria-label="Dark theme" aria-describedby={`weft-theme-desc-${id}`} data-weft-theme={storageKey} data-always-set={alwaysSet ? "" : undefined}>
  <svg class="weft-theme__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <mask id={`weft-theme-mask-${id}`}><rect x="-4" y="-4" width="24" height="24" fill="#fff"></rect><circle class="weft-theme__cut" cx="12.5" cy="3.5" r="4.6" fill="#000"></circle></mask>
    <circle class="weft-theme__core" cx="8" cy="8" r="6" fill="currentColor" mask={`url(#weft-theme-mask-${id})`}></circle>
    <g class="weft-theme__rays" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d={rays}></path></g>
  </svg>
  <span class="weft-theme__desc" id={`weft-theme-desc-${id}`}>Following your device</span>
</button>

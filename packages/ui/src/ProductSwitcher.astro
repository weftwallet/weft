---
/**
 * The menu of Weft's products, as every site's header shows it: a button
 * that opens a list of the products with their marks and what each is for.
 * The docs use it too, so moving between products works the same from all
 * of them. The styles are in header.css and the behaviour in
 * product-switcher.js, so the explorer can render the same control from its
 * own template; both files document the markup. The menu is a .reversible
 * (motion.css): it closes from wherever it is, however quickly it is closed.
 */
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { products, type ProductId } from "@weftwallet/brand/products";
import { productHref, siteProducts } from "./links";

interface Props {
  /** The product this page belongs to, marked as current in the list. */
  product: ProductId;
}

const { product } = Astro.props;
const require = createRequire(import.meta.url);
const markOf = (id: ProductId, className?: string) =>
  readFileSync(require.resolve(`@weftwallet/brand/${products[id].markSmall}`), "utf8")
    .replace(/<!--[\s\S]*?-->\s*/g, "")
    .replace(/<svg /, `<svg aria-hidden="true" focusable="false" ${className ? `class="${className}" ` : ""}`)
    .replace(/\s+role="img"/, "")
    .replace(/\s+aria-label="[^"]*"/, "");
// One switcher per page is the rule; the id keeps aria-controls valid if a
// page (the docs' mobile menu) renders a second.
const menuId = `weft-products-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="weft-switcher" data-weft-switcher>
  <button type="button" class="weft-switcher__button" aria-expanded="false" aria-haspopup="true" aria-controls={menuId}>
    <Fragment set:html={markOf(product, "weft-switcher__mark")} />
    <span class="weft-switcher__label">Products</span>
    <svg class="weft-switcher__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
  </button>
  <ul class="weft-switcher__menu reversible reversible--down" id={menuId}>
    {
      siteProducts.map((p) => (
        <li>
          <a href={productHref(p.id)} aria-current={p.id === product ? "page" : undefined}>
            <Fragment set:html={markOf(p.id)} />
            <span>
              <strong>{p.name}</strong>
              <span>{p.summary}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import "./product-switcher.js";
</script>

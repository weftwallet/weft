---
/**
 * The products grid every site's header shows first in its row: a 16px
 * grid in a 36px hit area that opens a list of Weft's products, with their
 * marks and what each is for, the current one marked. The docs use it too,
 * so moving between products works the same from all of them. The styles
 * are in header.css and the behaviour in product-switcher.js, so the
 * explorer can render the same control from its own template; both files
 * document the markup. The menu is a .reversible (motion.css): it closes
 * from wherever it is, however quickly it is closed.
 */
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { products, type ProductId } from "@weftwallet/brand/products";
import { productHref, siteProducts } from "./links";

interface Props {
  /** The product this page belongs to, marked as current in the list. */
  product: ProductId;
}

const { product } = Astro.props;
const require = createRequire(import.meta.url);
const markOf = (id: ProductId) =>
  readFileSync(require.resolve(`@weftwallet/brand/${products[id].markSmall}`), "utf8")
    .replace(/<!--[\s\S]*?-->\s*/g, "")
    .replace(/<svg /, '<svg aria-hidden="true" focusable="false" ')
    .replace(/\s+role="img"/, "")
    .replace(/\s+aria-label="[^"]*"/, "");
// One grid per page is the rule; the id keeps aria-controls valid if a page
// renders a second.
const menuId = `weft-products-${Math.random().toString(36).slice(2, 7)}`;
// Icons on the 16px grid.
const grid = '<rect x="2" y="2" width="5" height="5" rx="1.25"></rect><rect x="9" y="2" width="5" height="5" rx="1.25"></rect><rect x="2" y="9" width="5" height="5" rx="1.25"></rect><rect x="9" y="9" width="5" height="5" rx="1.25"></rect>';
const check = '<path d="M3.5 8.5l3 3 6-7"></path>';
---

<div class="weft-switcher" data-weft-switcher>
  <button type="button" class="weft-switcher__button" aria-expanded="false" aria-controls={menuId} aria-label="Weft products" title="Weft products">
    <svg class="weft-switcher__grid" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false" set:html={grid} />
  </button>
  <ul class="weft-switcher__menu reversible reversible--down" id={menuId}>
    {
      siteProducts.map((p) => (
        <li>
          <a href={productHref(p.id)} aria-current={p.id === product ? "page" : undefined}>
            <Fragment set:html={markOf(p.id)} />
            <span class="weft-switcher__text">
              <span class="weft-switcher__name">{p.name}</span>
              <span class="weft-switcher__summary">{p.summary}</span>
            </span>
            {p.id === product && <svg class="weft-switcher__check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={check} />}
          </a>
        </li>
      ))
    }
  </ul>
</div>

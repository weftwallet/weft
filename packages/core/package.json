{
  "name": "@weftwallet/core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "weft-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chain": {
      "weft-source": "./src/chain.ts",
      "types": "./dist/chain.d.ts",
      "import": "./dist/chain.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./chain": {
        "types": "./dist/chain.d.ts",
        "import": "./dist/chain.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@peculiar/x509": "^2.2.0",
    "@weftwallet/protocol": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}

---
/**
 * The button that opens the page list on a phone, as a 36px tool in the
 * header's row rather than Starlight's floating round button. It keeps
 * Starlight's popover target, so the menu itself is unchanged.
 */
---

<button popovertarget="starlight__sidebar" class="shell-menu-toggle md:sl-hidden print:hidden" aria-label={Astro.locals.t("menuButton.accessibleLabel")}>
  <svg class="shell-menu-toggle__open" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"></path></svg>
  <svg class="shell-menu-toggle__close" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"></path></svg>
</button>

<style is:global>
  body:has(#starlight__sidebar:popover-open) {
    overflow: hidden;
  }
  @media (min-width: 50rem) {
    body:has(#starlight__sidebar:popover-open) {
      overflow: auto;
    }
  }
</style>

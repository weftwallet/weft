---
// The docs' lockup, as every Weft header draws it (packages/ui/src/header.css):
// the 28px small mark and "weft docs". Still, like every other product's.
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { products } from "@weftwallet/brand/products";

const require = createRequire(import.meta.url);
const mark = readFileSync(require.resolve(`@weftwallet/brand/${products.docs.markSmall}`), "utf8")
  .replace(/<!--[\s\S]*?-->\s*/g, "")
  .replace(/<svg /, '<svg aria-hidden="true" focusable="false" ')
  .replace(/\s+role="img"/, "")
  .replace(/\s+aria-label="[^"]*"/, "");
---

<a class="shell-lockup" href="/" aria-label="Weft Docs, home">
  <Fragment set:html={mark} />
  <span class="shell-word">weft<span class="shell-word__product"> docs</span></span>
</a>

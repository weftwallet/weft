---
// An interactive dApp for trying Weft against any network that publishes an
// invite: the local playground stack, a hosted demo, or your own.
---

<div class="pg not-content">
  <section class="pg-card">
    <div class="pg-head">
      <h2>1. Network</h2>
      <span class="pg-pill" id="pg-weft" data-state="pending">Looking for Weft…</span>
    </div>
    <label class="pg-label"
      >Invite URL
      <div class="pg-row">
        <input id="pg-invite" type="url" placeholder="http://localhost:8787/.well-known/weft-invite.json" />
        <button type="button" id="pg-load" class="pg-secondary">Load</button>
      </div>
    </label>
    <p class="pg-hint" id="pg-invite-status">
      Run <code>pnpm playground:up</code> for a local network, or paste any organisation's invite URL.
    </p>
    <dl class="pg-details" id="pg-invite-details" hidden>
      <dt>Network</dt><dd id="pg-net"></dd>
      <dt>Organisation</dt><dd id="pg-org"></dd>
      <dt>Channels</dt><dd class="mono" id="pg-channels"></dd>
    </dl>
  </section>

  <section class="pg-card">
    <div class="pg-head">
      <h2>2. Identity</h2>
      <span class="pg-pill" id="pg-conn" data-state="pending">Not connected</span>
    </div>
    <div class="pg-row pg-wrap">
      <button type="button" id="pg-join" class="pg-secondary" disabled>Join with Weft</button>
      <button type="button" id="pg-connect" disabled>Connect</button>
      <button type="button" id="pg-disconnect" class="pg-secondary" hidden>Disconnect</button>
    </div>
    <p class="pg-hint">
      Join once to enrol (local demo users: <code>alice</code>/<code>alicepw</code>, <code>bob</code>/<code>bobpw</code>),
      then connect this page.
    </p>
    <dl class="pg-details" id="pg-identity" hidden>
      <dt>Name</dt><dd id="pg-id-name"></dd>
      <dt>MSP ID</dt><dd class="mono" id="pg-id-msp"></dd>
      <dt>Role</dt><dd class="mono" id="pg-id-role"></dd>
      <dt>Attributes</dt><dd class="mono" id="pg-id-attrs"></dd>
      <dt>Expires</dt><dd id="pg-id-exp"></dd>
    </dl>
  </section>

  <section class="pg-card">
    <h2>3. Call the contract</h2>
    <div class="pg-presets" aria-label="Examples for the basic contract">
      <span class="pg-hint">Try:</span>
      <button type="button" data-preset="InitLedger">InitLedger</button>
      <button type="button" data-preset="GetAllAssets">GetAllAssets</button>
      <button type="button" data-preset="ReadAsset">ReadAsset</button>
      <button type="button" data-preset="CreateAsset">CreateAsset</button>
      <button type="button" data-preset="TransferAsset">TransferAsset</button>
      <button type="button" data-preset="DeleteAsset">DeleteAsset</button>
    </div>
    <div class="pg-grid">
      <label class="pg-label">Channel<select id="pg-channel"><option value="mychannel">mychannel</option></select></label>
      <label class="pg-label">Contract (chaincode)<input id="pg-chaincode" value="basic" class="mono" /></label>
      <label class="pg-label">Function<input id="pg-fn" value="GetAllAssets" class="mono" /></label>
    </div>
    <div class="pg-label">
      Arguments
      <div id="pg-args" class="pg-args"></div>
      <button type="button" id="pg-add-arg" class="pg-link">+ Add argument</button>
    </div>
    <div class="pg-row pg-wrap">
      <button type="button" id="pg-evaluate" class="pg-teal" disabled>Evaluate (read)</button>
      <button type="button" id="pg-submit" class="pg-amber" disabled>Submit (write)</button>
    </div>
    <div id="pg-result-wrap" hidden>
      <h3>Result</h3>
      <pre id="pg-result" class="pg-out"></pre>
      <a id="pg-result-explorer" class="pg-out-link" target="_blank" rel="noreferrer" hidden>See it in the explorer</a>
      <h3>The same call in code</h3>
      <pre id="pg-code" class="pg-out"></pre>
    </div>
  </section>

  <section class="pg-card" aria-labelledby="pg-el-heading">
    <div class="pg-head">
      <h2 id="pg-el-heading">4. Vote in an election</h2>
      <span class="pg-pill" id="pg-el-state" data-state="pending">Connect first</span>
    </div>
    <p class="pg-hint">
      Uses the <a href="/guides/elections/">ballot contract</a>, which the local playground deploys with an open election, <code>board-2026</code>.
      Your choice is sent as private data. The ledger gets only a commitment, which your receipt lets you check.
    </p>
    <div class="pg-row">
      <input id="pg-el-id" class="mono" value="board-2026" aria-label="Election ID" spellcheck="false" />
      <button type="button" id="pg-el-load" class="pg-secondary" disabled>Load</button>
    </div>
    <div id="pg-el" class="pg-stack" hidden>
      <dl class="pg-details">
        <dt>Election</dt><dd id="pg-el-title"></dd>
        <dt>Voting</dt><dd id="pg-el-closes"></dd>
        <dt>Result</dt><dd id="pg-el-result"></dd>
      </dl>
      <fieldset class="pg-options" id="pg-el-options"><legend class="pg-hint">Your choice</legend></fieldset>
      <div class="pg-row pg-wrap">
        <button type="button" id="pg-el-vote" class="pg-amber" disabled>Cast vote</button>
        <button type="button" id="pg-el-close" class="pg-secondary" hidden>Close and count</button>
      </div>
    </div>
    <p class="pg-hint" id="pg-el-message" aria-live="polite"></p>
    <div id="pg-receipt" class="pg-stack" hidden>
      <h3>Your receipt</h3>
      <p class="pg-hint">Keep it. With the choice and the salt, anyone can check this commitment is your vote; without them, no one can tell.</p>
      <pre id="pg-receipt-json" class="pg-out" data-tone="ok"></pre>
      <div class="pg-row pg-wrap">
        <a id="pg-receipt-check" class="pg-button" target="_blank" rel="noreferrer" hidden>Check it in the explorer</a>
        <button type="button" id="pg-receipt-copy" class="pg-secondary">Copy receipt</button>
      </div>
    </div>
    <details class="pg-new">
      <summary>Start your own election</summary>
      <div class="pg-grid">
        <label class="pg-label">ID<input id="pg-new-id" class="mono" placeholder="lunch-friday" spellcheck="false" /></label>
        <label class="pg-label">Question<input id="pg-new-title" placeholder="Where should we eat?" /></label>
        <label class="pg-label">Choices <span class="pg-hint">comma-separated</span><input id="pg-new-options" placeholder="Noodles, Tacos" /></label>
        <label class="pg-label">Voting closes in<select id="pg-new-minutes"><option value="2">2 minutes</option><option value="10">10 minutes</option><option value="60">1 hour</option><option value="1440">1 day</option></select></label>
      </div>
      <button type="button" id="pg-new-create" class="pg-amber" disabled>Create election</button>
      <p class="pg-hint">Only your organisation can close it, once voting has closed. Closing counts the private ballots and publishes the result.</p>
    </details>
  </section>

  <section class="pg-card" id="pg-explorers" aria-labelledby="pg-ex-heading" hidden>
    <div class="pg-head">
      <h2 id="pg-ex-heading">5. Compare the explorers</h2>
      <button type="button" id="pg-ex-refresh" class="pg-link">Refresh</button>
    </div>
    <p class="pg-hint">
      Each organisation runs its own <a href="/operators/explorer/">explorer</a>, reads the ledger from its own peer, and publishes only what its
      policy allows. They compare signed checkpoints, so every block page says how many organisations report the same block.
    </p>
    <ul class="pg-explorers" id="pg-ex-list"></ul>
    <h3>Things to try</h3>
    <ul class="pg-try" id="pg-ex-try"></ul>
  </section>

  <section class="pg-card">
    <div class="pg-head">
      <h2>Provider log</h2>
      <button type="button" id="pg-clear" class="pg-link">Clear</button>
    </div>
    <p class="pg-hint">Every <code>window.weft</code> request and response, with timings.</p>
    <ol id="pg-log" class="pg-log"></ol>
  </section>
</div>

<script>
  const LOCAL_INVITE = "http://localhost:8787/.well-known/weft-invite.json";

  type Preset = { fn: string; args: string[]; kind: "evaluate" | "submit" };
  const PRESETS: Record<string, Preset> = {
    InitLedger: { fn: "InitLedger", args: [], kind: "submit" },
    GetAllAssets: { fn: "GetAllAssets", args: [], kind: "evaluate" },
    ReadAsset: { fn: "ReadAsset", args: ["asset1"], kind: "evaluate" },
    CreateAsset: { fn: "CreateAsset", args: ["asset7", "teal", "5", "Ifeanyi", "300"], kind: "submit" },
    TransferAsset: { fn: "TransferAsset", args: ["asset6", "Christopher"], kind: "submit" },
    DeleteAsset: { fn: "DeleteAsset", args: ["asset7"], kind: "submit" },
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const w = window as any;
  let weft: any = null;
  let connected = false;
  /** The organisation's explorer, when the invite names one. */
  let explorerBase: string | null = null;
  // Declared here because updateButtons, which runs as the page loads, reads them.
  let election: Election | null = null;
  let myMsp: string | null = null;
  /** Elections this page has voted in, so it doesn't offer a second ballot. */
  const votedIn = new Set<string>();

  /* ---------------- log ---------------- */

  function log(direction: "→" | "←" | "•", title: string, body?: unknown, tone: "ok" | "err" | "info" = "info") {
    const li = document.createElement("li");
    li.dataset.tone = tone;
    const head = document.createElement("div");
    head.className = "pg-log-head";
    head.textContent = `${new Date().toLocaleTimeString()}  ${direction} ${title}`;
    li.append(head);
    if (body !== undefined) {
      const pre = document.createElement("pre");
      pre.textContent = typeof body === "string" ? body : JSON.stringify(body, null, 2);
      li.append(pre);
    }
    $("pg-log").prepend(li);
  }

  async function call(method: string, params?: unknown) {
    if (!weft) throw new Error("Weft is not installed in this browser.");
    log("→", method, params);
    const started = performance.now();
    try {
      const result = await weft.request(params === undefined ? { method } : { method, params });
      log("←", `${method} · ${Math.round(performance.now() - started)} ms`, result, "ok");
      return result;
    } catch (error: any) {
      log("←", `${method} failed · ${Math.round(performance.now() - started)} ms`, { code: error?.code, message: error?.message, data: error?.data }, "err");
      // 4100: the wallet no longer treats this site as connected.
      if (error?.code === 4100 && connected) setConnected(false);
      throw error;
    }
  }

  /* ---------------- wallet detection ---------------- */

  function setWeftPill(state: "ok" | "missing") {
    const pill = $("pg-weft");
    pill.dataset.state = state;
    pill.textContent = state === "ok" ? `Weft ${weft.version} detected` : "Install Weft";
    if (state === "missing") {
      // Turn the pill into a link to the install guide.
      const link = Object.assign(document.createElement("a"), {
        id: "pg-weft",
        className: "pg-pill",
        href: "/start/install/",
        textContent: pill.textContent,
        title: "Install Weft, then reload this page.",
      });
      link.dataset.state = "missing";
      pill.replaceWith(link);
    }
  }

  function detect() {
    if (w.weft?.isWeft) {
      weft = w.weft;
      setWeftPill("ok");
      weft.on("identityChanged", (identity: any) => {
        log("•", "event identityChanged", identity);
        showIdentity(identity);
      });
      weft.on("networkChanged", (payload: any) => {
        log("•", "event networkChanged", payload);
        selectChannel(payload.channel);
      });
      weft.on("certificateStatus", (payload: any) => {
        log("•", "event certificateStatus", payload);
        $("pg-id-exp").textContent =
          payload.state === "expired" ? "Expired, renew it in Weft" : `${new Date(payload.notAfter).toLocaleDateString()} (${payload.daysLeft} days left)`;
      });
      weft.on("disconnect", (payload: any) => {
        log("•", "event disconnect", payload);
        setConnected(false, DISCONNECT_REASONS[payload?.reason] ?? "Disconnected");
      });
      void refreshIdentity();
      updateButtons();
      return;
    }
    setWeftPill("missing");
  }
  window.addEventListener("weft#initialized", detect, { once: true });
  setTimeout(() => !weft && detect(), 1200);

  const DISCONNECT_REASONS: Record<string, string> = {
    user: "Disconnected in Weft",
    site: "Disconnected",
    "no-identity": "No identity in Weft",
    "wallet-updated": "Weft was updated. Reload this page.",
    "identity-changed": "Identity switched in Weft. Connect again.",
  };

  function setConnected(value: boolean, label?: string) {
    connected = value;
    const pill = $("pg-conn");
    pill.dataset.state = value ? "ok" : "pending";
    pill.textContent = label ?? (value ? "Connected" : "Not connected");
    if (!value) showIdentity(null);
    updateButtons();
  }

  function selectChannel(channel: string) {
    const select = $<HTMLSelectElement>("pg-channel");
    if (![...select.options].some((o) => o.value === channel)) {
      select.append(Object.assign(document.createElement("option"), { value: channel, textContent: channel }));
    }
    select.value = channel;
  }

  async function refreshIdentity() {
    try {
      const identity = await weft.request({ method: "weft_identity" });
      if (identity) {
        showIdentity(identity);
        setConnected(true);
        return;
      }
    } catch {
      /* not connected */
    }
    updateButtons();
  }

  function showIdentity(identity: any) {
    if (!identity) {
      $("pg-identity").hidden = true;
      return;
    }
    $("pg-id-name").textContent = identity.name;
    $("pg-id-msp").textContent = identity.mspId;
    $("pg-id-role").textContent = identity.role ?? "none";
    const attrs = Object.entries(identity.attributes ?? {}).filter(([k]) => !k.startsWith("hf."));
    $("pg-id-attrs").textContent = attrs.length ? attrs.map(([k, v]) => `${k}=${v}`).join(", ") : "none";
    $("pg-id-exp").textContent = new Date(identity.notAfter).toLocaleDateString();
    $("pg-identity").hidden = false;
  }

  function updateButtons() {
    const haveInvite = Boolean(inviteUrl());
    $<HTMLButtonElement>("pg-join").disabled = !weft || !haveInvite;
    $<HTMLButtonElement>("pg-connect").disabled = !weft;
    $("pg-connect").hidden = connected;
    $("pg-disconnect").hidden = !connected;
    $<HTMLButtonElement>("pg-evaluate").disabled = !weft || !connected;
    $<HTMLButtonElement>("pg-submit").disabled = !weft || !connected;
    $<HTMLButtonElement>("pg-el-load").disabled = !weft || !connected;
    $<HTMLButtonElement>("pg-new-create").disabled = !weft || !connected;
    updateElectionButtons();
    if (!connected) setElectionState("pending", weft ? "Connect first" : "Install Weft");
    else if ($("pg-el-state").textContent === "Connect first") setElectionState("pending", "Not loaded");
  }

  /* ---------------- invite ---------------- */

  function inviteUrl(): string | null {
    const value = $<HTMLInputElement>("pg-invite").value.trim();
    try {
      return /^https?:/.test(value) ? new URL(value).toString() : null;
    } catch {
      return null;
    }
  }

  async function loadInvite(quiet = false) {
    const url = inviteUrl();
    updateButtons();
    if (!url) return;
    try {
      const response = await fetch(url, { headers: { accept: "application/json" } });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const invite = await response.json();
      $("pg-net").textContent = invite.network;
      $("pg-org").textContent = `${invite.organization} (${invite.mspId})`;
      $("pg-channels").textContent = invite.channels.join(", ");
      $("pg-invite-details").hidden = false;
      $("pg-invite-status").textContent = `Loaded from ${new URL(url).host}.`;
      const select = $<HTMLSelectElement>("pg-channel");
      select.replaceChildren(...invite.channels.map((c: string) => Object.assign(document.createElement("option"), { value: c, textContent: c })));
      explorerBase = typeof invite.explorerUrl === "string" ? invite.explorerUrl.replace(/\/+$/, "") : null;
      void loadExplorers();
    } catch (error) {
      $("pg-invite-details").hidden = true;
      if (!quiet) $("pg-invite-status").textContent = `Couldn't load the invite: ${error instanceof Error ? error.message : error}.`;
    }
  }

  const fromQuery = new URLSearchParams(location.search).get("invite");
  if (fromQuery) {
    $<HTMLInputElement>("pg-invite").value = fromQuery;
    void loadInvite();
  } else {
    // Quietly look for the local playground stack.
    fetch(LOCAL_INVITE, { signal: AbortSignal.timeout(1500) })
      .then((r) => {
        if (!r.ok) return;
        $<HTMLInputElement>("pg-invite").value = LOCAL_INVITE;
        $("pg-invite-status").textContent = "Found the local playground stack.";
        void loadInvite(true);
      })
      .catch(() => {});
  }
  $("pg-load").addEventListener("click", () => void loadInvite());
  $("pg-invite").addEventListener("input", updateButtons);

  /* ---------------- identity actions ---------------- */

  $("pg-join").addEventListener("click", async () => {
    const url = inviteUrl();
    if (!url) return;
    try {
      await call("weft_addNetwork", { url });
    } catch {
      /* logged */
    }
  });

  $("pg-connect").addEventListener("click", async () => {
    const button = $<HTMLButtonElement>("pg-connect");
    button.disabled = true;
    button.textContent = "Waiting for Weft…";
    try {
      showIdentity(await call("weft_connect"));
      setConnected(true);
    } catch {
      /* logged */
    } finally {
      button.textContent = "Connect";
      updateButtons();
    }
  });

  // The wallet answers with a disconnect event, which updates the page.
  $("pg-disconnect").addEventListener("click", () => void call("weft_disconnect").catch(() => {}));

  /* ---------------- contract calls ---------------- */

  function argInputs() {
    return Array.from($("pg-args").querySelectorAll<HTMLInputElement>("input"));
  }

  function addArg(value = "") {
    const row = document.createElement("div");
    row.className = "pg-arg";
    const input = Object.assign(document.createElement("input"), { value, className: "mono", placeholder: `argument ${argInputs().length}` });
    input.setAttribute("aria-label", `Argument ${argInputs().length}`);
    const remove = Object.assign(document.createElement("button"), { type: "button", textContent: "Remove", className: "pg-link" });
    remove.addEventListener("click", () => row.remove());
    row.append(input, remove);
    $("pg-args").append(row);
  }
  $("pg-add-arg").addEventListener("click", () => addArg());

  function applyPreset(name: string) {
    const preset = PRESETS[name];
    if (!preset) return;
    $<HTMLInputElement>("pg-fn").value = preset.fn;
    $("pg-args").replaceChildren();
    preset.args.forEach((a) => addArg(a));
    $("pg-evaluate").classList.toggle("pg-suggested", preset.kind === "evaluate");
    $("pg-submit").classList.toggle("pg-suggested", preset.kind === "submit");
  }
  document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((b) => b.addEventListener("click", () => applyPreset(b.dataset.preset!)));

  function currentCall() {
    return {
      channel: $<HTMLSelectElement>("pg-channel").value,
      chaincode: $<HTMLInputElement>("pg-chaincode").value.trim(),
      fn: $<HTMLInputElement>("pg-fn").value.trim(),
      args: argInputs().map((i) => i.value),
    };
  }

  function codeFor(kind: "evaluate" | "submit", c: ReturnType<typeof currentCall>) {
    const args = c.args.map((a) => JSON.stringify(a)).join(", ");
    return `import { getWeft } from "@weftwallet/sdk";

const weft = await getWeft();
const contract = weft.contract({ channel: ${JSON.stringify(c.channel)}, chaincode: ${JSON.stringify(c.chaincode)} });
const result = await contract.${kind}(${[JSON.stringify(c.fn), args].filter(Boolean).join(", ")});`;
  }

  async function run(kind: "evaluate" | "submit") {
    const c = currentCall();
    $("pg-result-wrap").hidden = false;
    $("pg-result-explorer").hidden = true;
    $("pg-code").textContent = codeFor(kind, c);
    $("pg-result").textContent = kind === "submit" ? "Waiting for approval, endorsement and commit…" : "Waiting for approval…";
    $("pg-result").dataset.tone = "pending";
    const buttons = [$<HTMLButtonElement>("pg-evaluate"), $<HTMLButtonElement>("pg-submit")];
    buttons.forEach((b) => (b.disabled = true));
    try {
      const result = await call(kind === "submit" ? "weft_submit" : "weft_evaluate", c);
      let pretty = result.text;
      try {
        pretty = JSON.stringify(JSON.parse(result.text), null, 2);
      } catch {
        /* not JSON */
      }
      const meta = kind === "submit" ? `Committed in block ${result.blockNumber} · tx ${result.transactionId}\n\n` : "";
      $("pg-result").textContent = `${meta}${pretty ?? `(binary result, base64) ${result.base64}`}` || "(empty result)";
      $("pg-result").dataset.tone = "ok";
      showTxLink($<HTMLAnchorElement>("pg-result-explorer"), kind === "submit" ? c.channel : null, result.transactionId);
      if (kind === "submit") void loadExplorers();
    } catch (error: any) {
      const detail = error?.data?.status ? ` (${error.data.status})` : "";
      $("pg-result").textContent = `Error ${error?.code ?? ""}: ${error?.message ?? error}${detail}`;
      $("pg-result").dataset.tone = "err";
    } finally {
      updateButtons();
    }
  }

  $("pg-evaluate").addEventListener("click", () => void run("evaluate"));
  $("pg-submit").addEventListener("click", () => void run("submit"));
  $("pg-clear").addEventListener("click", () => $("pg-log").replaceChildren());

  /** Links a committed transaction to the organisation's explorer, if there is one. */
  function showTxLink(link: HTMLAnchorElement, channel: string | null, txId: string | undefined) {
    if (!explorerBase || !channel || !txId) {
      link.hidden = true;
      return;
    }
    link.href = `${explorerBase}/channels/${encodeURIComponent(channel)}/transactions/${encodeURIComponent(txId)}`;
    link.hidden = false;
  }

  /* ---------------- elections ---------------- */

  type Election = {
    id: string;
    title: string;
    options: string[];
    closesAt: string;
    creatorMsp: string;
    state: "open" | "closed";
    tally?: { counts: Record<string, number>; total: number };
  };

  const electionChannel = () => $<HTMLSelectElement>("pg-channel").value;
  const ballot = (fn: string, args: string[], transient?: Record<string, string>) => ({
    channel: electionChannel(),
    chaincode: "ballot",
    fn,
    args,
    ...(transient ? { transient } : {}),
  });

  function setElectionState(state: "ok" | "pending" | "missing", text: string) {
    const pill = $("pg-el-state");
    pill.dataset.state = state;
    pill.textContent = text;
  }

  function electionMessage(text: string, tone: "info" | "err" = "info") {
    const p = $("pg-el-message");
    p.textContent = text;
    p.dataset.tone = tone;
  }

  /** What went wrong, in the contract's words where it gave some. */
  function reason(error: any): string {
    const detail = error?.data?.details?.map((d: any) => d.message).find(Boolean) ?? error?.message ?? String(error);
    if (/chaincode ballot not found|could not find chaincode with name 'ballot'|ballot.*not.*(found|installed|defined)/i.test(detail)) {
      return "This network has no ballot contract. The local playground deploys one; for your own network, see Run an election.";
    }
    return detail.replace(/^.*?(There's no election|Voting has closed|This identity has already voted|Only \S+ can close|Voting is open until)/, "$1");
  }

  const isOpen = (e: Election) => e.state === "open" && Date.now() < Date.parse(e.closesAt);

  function chosen(): string | null {
    return $("pg-el-options").querySelector<HTMLInputElement>("input:checked")?.value ?? null;
  }

  function updateElectionButtons() {
    const vote = $<HTMLButtonElement>("pg-el-vote");
    const voted = !!election && votedIn.has(election.id);
    vote.disabled = !connected || !election || !isOpen(election) || !chosen() || voted;
    vote.textContent = voted ? "Voted" : "Cast vote";
    $("pg-el-options").querySelectorAll<HTMLInputElement>("input").forEach((i) => (i.disabled = !election || !isOpen(election) || voted));
    const close = $<HTMLButtonElement>("pg-el-close");
    close.hidden = !election || election.state !== "open" || isOpen(election) || election.creatorMsp !== myMsp;
    close.disabled = !connected;
  }

  function showElection(e: Election) {
    election = e;
    $("pg-el").hidden = false;
    $("pg-el-title").textContent = e.title;
    const closes = new Date(e.closesAt);
    $("pg-el-closes").textContent =
      e.state === "closed" ? "Closed and counted" : isOpen(e) ? `Open until ${closes.toLocaleString()}` : `Closed at ${closes.toLocaleString()}, not counted yet`;
    $("pg-el-result").textContent = e.tally
      ? Object.entries(e.tally.counts)
          .sort((a, b) => b[1] - a[1])
          .map(([o, n]) => `${o} ${n}`)
          .join(" · ") + ` (${e.tally.total} ballots)`
      : "Published when the election is closed";
    const options = $("pg-el-options");
    const previous = chosen();
    options.querySelectorAll("label").forEach((l) => l.remove());
    for (const option of e.options) {
      const label = document.createElement("label");
      label.className = "pg-option";
      const input = Object.assign(document.createElement("input"), { type: "radio", name: "pg-el-option", value: option, checked: option === previous });
      input.disabled = !isOpen(e);
      input.addEventListener("change", updateElectionButtons);
      label.append(input, document.createTextNode(option));
      options.append(label);
    }
    options.hidden = e.state === "closed";
    setElectionState("ok", e.state === "closed" ? "Counted" : isOpen(e) ? "Open" : "Voting closed");
    updateElectionButtons();
  }

  async function loadElection(id = $<HTMLInputElement>("pg-el-id").value.trim()) {
    if (!id) return;
    electionMessage("");
    try {
      myMsp = (await weft.request({ method: "weft_identity" }))?.mspId ?? null;
      const result = await call("weft_evaluate", ballot("GetElection", [id]));
      showElection(JSON.parse(result.text));
    } catch (error) {
      election = null;
      $("pg-el").hidden = true;
      setElectionState("missing", "Not found");
      electionMessage(reason(error), "err");
      updateElectionButtons();
    }
  }

  function hex(bytes: Uint8Array) {
    return Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
  }

  async function castVote() {
    const option = chosen();
    if (!election || !option) return;
    const button = $<HTMLButtonElement>("pg-el-vote");
    button.disabled = true;
    button.textContent = "Waiting for Weft…";
    // The salt is the voter's secret: without it, no one can tell which choice
    // the commitment is for.
    const salt = hex(crypto.getRandomValues(new Uint8Array(16)));
    try {
      electionMessage(`You're voting for ${option}. Weft lists it as a private input called "ballot", hidden until you choose Show.`);
      const result = await call("weft_submit", ballot("CastVote", [election.id], { ballot: JSON.stringify({ option, salt }) }));
      const receipt = { ...JSON.parse(result.text), option, salt, blockNumber: result.blockNumber };
      votedIn.add(election.id);
      showReceipt(receipt);
      electionMessage(`Your ballot is in block ${result.blockNumber}.`);
      void loadExplorers();
    } catch (error) {
      const message = reason(error);
      if (/already voted/.test(message)) votedIn.add(election.id);
      electionMessage(message, "err");
    } finally {
      updateElectionButtons();
    }
  }

  function showReceipt(r: { electionId: string; txId: string; commitment: string; option: string; salt: string }) {
    $("pg-receipt").hidden = false;
    $("pg-receipt-json").textContent = JSON.stringify(r, null, 2);
    const link = $<HTMLAnchorElement>("pg-receipt-check");
    if (explorerBase) {
      // The choice and salt go in the fragment, which the browser never sends
      // to the explorer's server; the explorer's page checks them locally.
      const query = new URLSearchParams({ tx: r.txId, commitment: r.commitment });
      const local = new URLSearchParams({ option: r.option, salt: r.salt });
      link.href = `${explorerBase}/channels/${encodeURIComponent(electionChannel())}/elections/${encodeURIComponent(r.electionId)}?${query}#${local}`;
      link.hidden = false;
    } else {
      link.hidden = true;
    }
  }

  async function closeElection() {
    if (!election) return;
    const button = $<HTMLButtonElement>("pg-el-close");
    button.disabled = true;
    try {
      const result = await call("weft_submit", ballot("CloseElection", [election.id]));
      showElection(JSON.parse(result.text));
      electionMessage(`Counted in block ${result.blockNumber}. Each explorer now compares this result with the commitments it has.`);
      void loadExplorers();
    } catch (error) {
      electionMessage(reason(error), "err");
    } finally {
      updateElectionButtons();
    }
  }

  async function createElection() {
    const id = $<HTMLInputElement>("pg-new-id").value.trim();
    const title = $<HTMLInputElement>("pg-new-title").value.trim();
    const options = $<HTMLInputElement>("pg-new-options").value.split(",").map((o) => o.trim()).filter(Boolean);
    const minutes = Number($<HTMLSelectElement>("pg-new-minutes").value);
    if (!id || !title || options.length < 2) {
      electionMessage("Give the election an ID, a question and at least two choices.", "err");
      return;
    }
    const closesAt = new Date(Date.now() + minutes * 60_000).toISOString();
    try {
      await call("weft_submit", ballot("CreateElection", [id, title, JSON.stringify(options), closesAt]));
      $<HTMLInputElement>("pg-el-id").value = id;
      ($("pg-new-create").closest("details") as HTMLDetailsElement).open = false;
      $("pg-receipt").hidden = true;
      await loadElection(id);
      electionMessage(`Created ${id}. Vote now; once voting closes, come back and close it to count.`);
    } catch (error) {
      electionMessage(reason(error), "err");
    }
  }

  $("pg-el-load").addEventListener("click", () => void loadElection());
  $("pg-el-id").addEventListener("keydown", (e) => e.key === "Enter" && void loadElection());
  $("pg-el-vote").addEventListener("click", () => void castVote());
  $("pg-el-close").addEventListener("click", () => void closeElection());
  $("pg-new-create").addEventListener("click", () => void createElection());
  $("pg-receipt-copy").addEventListener("click", () => void navigator.clipboard.writeText($("pg-receipt-json").textContent ?? ""));
  // An open election closes while the page is open; keep the buttons honest.
  setInterval(() => election && election.state === "open" && showElection(election), 15_000);

  /* ---------------- explorers ---------------- */

  type ChannelStatus = {
    channel: string;
    height: number;
    level: string;
    publishes?: { values: "show" | "hash"; submitter: "show" | "hide"; membersOnly: string[]; elections: boolean };
  };
  type Peer = { url: string; mspId: string | null; state: string; agreedUpTo: number | null; mismatchAt: number | null };

  async function getJson(url: string) {
    const response = await fetch(url, { signal: AbortSignal.timeout(4000), headers: { accept: "application/json" } });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json();
  }

  function describe(c: ChannelStatus | undefined): string {
    if (!c) return "Doesn't publish this channel.";
    if (!c.publishes) return `Publishes ${c.channel} (${c.level}).`;
    const p = c.publishes;
    const parts = [
      p.values === "show" ? "values shown" : "values as hashes",
      p.submitter === "show" ? "submitters shown" : "submitters hidden",
    ];
    if (p.membersOnly.length) parts.push(`members only: ${p.membersOnly.join(", ")}`);
    if (p.elections) parts.push("election pages");
    return `${c.level === "members" ? "Members only" : "Public"}: ${parts.join(", ")}.`;
  }

  function agreement(peers: Peer[]): string {
    if (peers.length === 0) return "Not comparing with other organisations.";
    return peers
      .map((p) => {
        const who = p.mspId ?? new URL(p.url).host;
        if (p.state === "agree") return `Agrees with ${who} up to block ${p.agreedUpTo}.`;
        if (p.state === "mismatch") return `Disagrees with ${who} from block ${p.mismatchAt}.`;
        if (p.state === "unreachable") return `Can't reach ${who}.`;
        return `Checking with ${who}…`;
      })
      .join(" ");
  }

  async function loadExplorers() {
    const card = $("pg-explorers");
    if (!explorerBase) {
      card.hidden = true;
      return;
    }
    card.hidden = false;
    const channel = electionChannel();
    // The invite names this organisation's explorer; it knows the others.
    let peers: Peer[] = [];
    try {
      peers = await getJson(`${explorerBase}/api/v1/channels/${encodeURIComponent(channel)}/organisations`);
    } catch {
      /* listed as unreachable below */
    }
    const bases = [explorerBase, ...peers.map((p) => p.url.replace(/\/+$/, ""))];
    const rows = await Promise.all(
      bases.map(async (base) => {
        try {
          const [status, theirPeers] = await Promise.all([
            getJson(`${base}/api/v1/status`),
            getJson(`${base}/api/v1/channels/${encodeURIComponent(channel)}/organisations`).catch(() => []),
          ]);
          const c = (status.channels as ChannelStatus[]).find((x) => x.channel === channel);
          return { base, name: status.name as string, c, peers: theirPeers as Peer[], ok: true };
        } catch {
          return { base, name: new URL(base).host, c: undefined, peers: [], ok: false };
        }
      }),
    );
    const list = $("pg-ex-list");
    list.replaceChildren(
      ...rows.map((r) => {
        const li = document.createElement("li");
        li.className = "pg-explorer";
        const head = document.createElement("div");
        head.className = "pg-head";
        const link = Object.assign(document.createElement("a"), { href: `${r.base}/channels/${encodeURIComponent(channel)}`, target: "_blank", rel: "noreferrer", textContent: `${r.name}'s explorer` });
        const pill = Object.assign(document.createElement("span"), { className: "pg-pill", textContent: r.ok ? (r.c ? `${r.c.height} blocks` : "No channel") : "Unreachable" });
        pill.dataset.state = r.ok && r.c ? "ok" : "missing";
        head.append(link, pill);
        const what = Object.assign(document.createElement("p"), { className: "pg-hint", textContent: r.ok ? describe(r.c) : `Couldn't reach ${r.base}.` });
        li.append(head, what);
        if (r.ok && r.c) li.append(Object.assign(document.createElement("p"), { className: "pg-hint", textContent: agreement(r.peers) }));
        return li;
      }),
    );
    const block = Math.max(1, (rows[0]?.c?.height ?? 2) - 1);
    const tries: [string, string | null][] = [
      [`Open block ${block} on each explorer: the same block, and each says how many organisations report it.`, null],
    ];
    const members = rows.find((r) => r.c?.publishes?.membersOnly.length);
    if (members) {
      tries.push([
        `Sign in to ${members.name}'s explorer with Weft to see what it publishes to members only (${members.c!.publishes!.membersOnly.join(", ")}).`,
        `${members.base}/channels/${encodeURIComponent(channel)}`,
      ]);
    }
    const hiding = rows.find((r) => r.c?.publishes?.submitter === "hide");
    if (hiding) tries.push([`Compare a transaction on ${hiding.name}'s explorer: it doesn't say who submitted it.`, null]);
    const ballots = rows.find((r) => r.c?.publishes?.elections);
    if (ballots) {
      tries.push([`See the elections, their ballots and results, and check a receipt.`, `${ballots.base}/channels/${encodeURIComponent(channel)}/elections`]);
    }
    tries.push([`See every organisation's explorer on one page, and compare a block's hash across them.`, `/operators/network/?explorer=${encodeURIComponent(explorerBase)}`]);
    $("pg-ex-try").replaceChildren(
      ...tries.map(([text, href]) => {
        const li = document.createElement("li");
        if (href) li.append(Object.assign(document.createElement("a"), { href, target: "_blank", rel: "noreferrer", textContent: text }));
        else li.textContent = text;
        return li;
      }),
    );
  }
  $("pg-ex-refresh").addEventListener("click", () => void loadExplorers());
</script>


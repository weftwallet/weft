---
/**
 * Starlight's header replaced by the one every Weft product renders
 * (packages/ui/src/header.css documents the markup): the lockup, the docs'
 * own links in the centre, and on the right the tools, search, the
 * products switcher and the theme control. Under 900px the links take a
 * second row, as on every other site; theme.css gives the bar the room.
 */
import Search from "@astrojs/starlight/components/Search.astro";
import ProductSwitcher from "@weftwallet/ui/ProductSwitcher.astro";
import ThemeControl from "@weftwallet/ui/ThemeControl.astro";
import SiteTitle from "./SiteTitle.astro";

// The docs' sections, each to its first page. The current one is the
// section the page's path starts with.
const sections = [
  ["Start", "/start/what-is-weft/", "/start/"],
  ["Using Weft", "/guides/signing/", "/guides/"],
  ["Build a dApp", "/dapps/quickstart/", "/dapps/"],
  ["Run a network", "/operators/relay/", "/operators/"],
  ["Reference", "/reference/security/", "/reference/"],
] as const;
const path = Astro.url.pathname;
---

<div class="shell-bar">
  <SiteTitle />
  <nav class="shell-nav" aria-label="Weft Docs">
    {sections.map(([label, href, prefix]) => <a href={href} aria-current={path.startsWith(prefix) ? "page" : undefined}>{label}</a>)}
  </nav>
  <div class="shell-tools">
    <Search class="shell-search-tool" />
    <ProductSwitcher product="docs" />
    <ThemeControl storageKey="starlight-theme" alwaysSet />
  </div>
</div>

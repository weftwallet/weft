---
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import Shell from "@weftwallet/ui/Shell.astro";
import { productHref } from "@weftwallet/ui/links";

const docs = (path: string) => productHref("docs", path);
const require = createRequire(import.meta.url);
const markSmall = readFileSync(require.resolve("@weftwallet/brand/logo/mark-small.svg"), "utf8")
  .replace(/<!--[\s\S]*?-->\s*/g, "")
  .replace(/<svg /, '<svg aria-hidden="true" focusable="false" ')
  .replace(/\s+role="img"/, "")
  .replace(/\s+aria-label="[^"]*"/, "");

// The three pieces, named under the cloth.
const pieces = [
  ["The extension", "Holds your identities and signs. It shows every request before signing."],
  ["The relay", "Runs inside your organisation, next to its peers. It builds the unsigned messages and forwards the signed bytes. It never sees your key."],
  ["The invite", "A link your administrator shares. It tells Weft where the CA and the relay are, so nobody types a URL."],
];
// The four things the approve window shows. The numbers match the markers
// on the window beside them.
const shown = [
  ["Who is asking", "The web app's address, and which of your identities it wants to use."],
  ["Read or write", "Whether it only reads the ledger or changes it."],
  ["What it calls", "The channel, the contract, the function and every argument, decoded."],
  ["Who must endorse", "Which organisations must endorse it before it is committed."],
];
// The operational side, each piece with where to read about it.
const pieces2 = [
  ["Relay", "One stateless service your organisation runs next to its peers.", docs("/operators/relay/")],
  ["Invite", "A link that configures the whole network for your users: CA, relay, MSP ID and channels.", docs("/operators/invites/")],
  ["Explorer", "Your organisation's view of its ledger, every block's hash checked in the reader's browser.", docs("/operators/explorer/")],
  ["Weft Network", "Every organisation's explorer side by side, and whether their ledgers agree.", productHref("network")],
];
const code = [
  'const weft = window.weft;',
  'await weft.request({ method: "weft_connect" });',
  'await weft.request({',
  '  method: "weft_submit",',
  '  params: {',
  '    channel: "mychannel", chaincode: "basic",',
  '    fn: "TransferAsset", args: ["asset7", "Org2MSP"],',
  '  },',
  '});',
];
---

<Shell product="site" description="Weft is a browser extension that holds the certificate your organisation's CA issued you and signs Fabric transactions for you, after showing you each one." wide>
  <Fragment slot="nav">
    <a href={docs("/")}>Docs</a>
    <a href={productHref("playground")}>Playground</a>
    <a href={productHref("network")}>Network</a>
  </Fragment>

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__ground" aria-hidden="true"></div>
    <div class="hero__text">
      <h1 id="hero-title">Your Fabric identity, in your own browser</h1>
      <p class="hero__sub">Weft is a browser extension that holds the certificate your organisation's CA issued you. A web app asks it to sign, you read the transaction and approve it, and the ledger records your identity as the signer.</p>
      <div class="actions">
        <a class="btn btn--primary" href={docs("/start/install/")}>Install Weft</a>
        <a class="btn" href="#how">See how a transaction is signed</a>
      </div>
      <p class="hero__proof">Open source, Apache 2.0. Keys never leave the browser. Works with any Fabric network that runs the relay.</p>
    </div>
    <div class="hero__stage">
      <canvas id="hero-loom" aria-hidden="true"></canvas>
      <button type="button" class="hero__replay" id="hero-replay" aria-label="Replay the logo animation"></button>
    </div>
  </section>

  <section class="problem stage-section" aria-labelledby="problem-title">
    <div class="col">
      <span class="eyebrow">Why Weft exists</span>
      <h2 id="problem-title">A portal server signs for every user</h2>
      <p class="muted">In a portal-based Fabric application, the portal holds the users' identities and submits transactions under them, and the ledger records the portal as the signer. With Weft, the identity stays in the person's browser, the web app asks for a signature, and the ledger records the person who approved it.</p>
    </div>
    <div class="flow" role="img" aria-label="Before: a person uses a portal server, which holds the identity and signs, and sends to the peers. With Weft: the person's browser holds the identity and signs, a relay forwards the signed bytes, and the peers receive them.">
      <div class="flow__row">
        <span class="flow__label">Before</span>
        <div class="flow__box"><span>Person</span></div>
        <span class="flow__arrow"></span>
        <div class="flow__box flow__box--warn"><span>Portal server</span><small>holds identity, signs</small></div>
        <span class="flow__arrow"></span>
        <div class="flow__box"><span>Peers</span></div>
      </div>
      <div class="flow__row">
        <span class="flow__label">With Weft</span>
        <div class="flow__box flow__box--accent"><span>Person's browser</span><small>holds identity, signs</small></div>
        <span class="flow__arrow"></span>
        <div class="flow__box"><span>Relay</span><small>forwards signed bytes</small></div>
        <span class="flow__arrow"></span>
        <div class="flow__box"><span>Peers</span></div>
      </div>
    </div>
  </section>

  <section class="cloth stage-section" id="how" aria-labelledby="cloth-title">
    <div class="col">
      <span class="eyebrow">How it works</span>
      <h2 id="cloth-title" tabindex="-1">Every transaction, shown first</h2>
      <p class="muted">A web app asks Weft to sign. Weft decodes the request, shows you what it calls, and signs only if you approve. The organisations it needs endorse it, and it is committed to the ledger each of them keeps.</p>
      <dl class="pieces">
        {
          pieces.map(([term, detail]) => (
            <div>
              <dt>{term}</dt>
              <dd>{detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="cloth__loom">
      <div class="cloth__stage">
        <canvas id="cloth-loom" aria-hidden="true"></canvas>
        <ol class="ledger" id="ledger" aria-label="Transactions in the animation, one per row" hidden></ol>
      </div>
      <!-- Space kept for "Play again", so nothing moves when it appears. -->
      <div class="cloth__after">
        <button type="button" class="cloth__again" id="cloth-again" aria-label="Play again, the transactions animation" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4"></path></svg>
          Play again
        </button>
      </div>
    </div>
  </section>

  <section class="read stage-section" aria-labelledby="read-title">
    <div class="col">
      <span class="eyebrow">Before you sign</span>
      <h2 id="read-title">What you read before you sign</h2>
      <p class="muted">Weft signs only what you have read and approved. The window Weft opens shows four things, and refuses the request if what the network sends differs from what you approved.</p>
      <dl class="shown">
        {
          shown.map(([term, detail]) => (
            <div>
              <dt>{term}</dt>
              <dd>{detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="approve" aria-label="The window Weft opens for a transaction, as an example">
      <div class="approve__head">
        <span class="approve__brand"><Fragment set:html={markSmall} />weft</span>
        <p class="approve__title">Sign this transaction?</p>
        <div class="approve__origin" data-shown="1">
          <span class="approve__origin-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="10" height="7" rx="1.5"></rect><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"></path></svg></span>
          <span class="approve__origin-text"><span>asset-transfer.example</span><small>wants you to sign a transaction</small></span>
        </div>
      </div>
      <div class="approve__body">
        <div class="approve__notice" data-shown="2">
          <span class="approve__tag">Submit</span>
          <span>This changes the ledger. Once endorsed and committed it cannot be undone.</span>
        </div>
        <dl class="approve__details" data-shown="3">
          <dt>Signing as</dt>
          <dd><span>alice</span> <span class="mono approve__msp">Org1MSP</span></dd>
          <dt>Channel</dt>
          <dd class="mono">mychannel</dd>
          <dt>Contract</dt>
          <dd class="mono">basic</dd>
          <dt>Function</dt>
          <dd class="mono approve__fn">TransferAsset</dd>
        </dl>
        <div class="approve__args">
          <span class="eyebrow">Arguments</span>
          <div class="approve__arg"><span>0</span><span class="mono">asset7</span></div>
          <div class="approve__arg"><span>1</span><span class="mono">Org2MSP</span></div>
        </div>
        <div class="approve__endorse" data-shown="4">
          <span>Sent for endorsement to</span>
          <span class="approve__chips"><span class="approve__chip mono">Org1MSP</span><span class="approve__chip mono">Org2MSP</span></span>
        </div>
      </div>
      <div class="approve__foot" aria-hidden="true">
        <span class="btn">Reject</span>
        <span class="btn btn--write">Sign and submit</span>
      </div>
    </div>
  </section>

  <section class="build stage-section" aria-labelledby="build-title">
    <div class="col">
      <span class="eyebrow">For builders</span>
      <h2 id="build-title">Ask for a signature from a web page</h2>
      <p class="muted">Call a contract from the page the way an Ethereum dApp asks MetaMask. Weft decodes the request and shows it to the person before anything is signed.</p>
      <div class="links">
        <a href={docs("/dapps/quickstart/")}>Read the quickstart</a>
        <a href={productHref("playground")}>Try it in the playground</a>
      </div>
    </div>
    <div class="build__stage">
      <pre class="code" tabindex="0" aria-label="Nine lines of JavaScript calling window.weft.request"><code>{code.join("\n")}</code></pre>
      <div class="approve approve--compact" aria-label="The window the code opens: Sign this transaction? Function TransferAsset with arguments asset7 and Org2MSP">
        <div class="approve__head">
          <span class="approve__brand"><Fragment set:html={markSmall} />weft</span>
          <p class="approve__title">Sign this transaction?</p>
          <div class="approve__origin">
            <span class="approve__origin-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"></circle><path d="M2 8h12M8 2c2 2 2 10 0 12M8 2c-2 2-2 10 0 12"></path></svg></span>
            <span class="approve__origin-text"><span>localhost:5173</span><small>wants you to sign a transaction</small></span>
          </div>
        </div>
        <div class="approve__body">
          <dl class="approve__details">
            <dt>Function</dt>
            <dd class="mono approve__fn">TransferAsset</dd>
            <dt>Arguments</dt>
            <dd class="mono">asset7, Org2MSP</dd>
          </dl>
        </div>
        <div class="approve__foot" aria-hidden="true">
          <span class="btn">Reject</span>
          <span class="btn btn--write">Sign and submit</span>
        </div>
      </div>
    </div>
  </section>

  <section class="orgs text-section" aria-labelledby="orgs-title">
    <div class="col">
      <span class="eyebrow">For organisations</span>
      <h2 id="orgs-title">Four open-source pieces</h2>
      <p class="muted">The relay is one service you run next to your peers. The invite and the explorer are things you publish, and Weft Network reads the explorers.</p>
    </div>
    <dl class="rows">
      {
        pieces2.map(([name, detail, href]) => (
          <div>
            <dt><a href={href}>{name}</a></dt>
            <dd>{detail}</dd>
            <svg class="rows__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="install text-section" aria-labelledby="install-title">
    <div class="col">
      <h2 id="install-title">Install Weft</h2>
      <p class="muted">Weft runs in Chrome, Edge, Brave and other Chromium browsers. It is not in the browser stores yet: build it from the source, or ask your administrator for the build.</p>
      <div class="actions">
        <a class="btn btn--primary" href={docs("/start/install/")}>Install Weft</a>
      </div>
    </div>
  </section>
</Shell>

<script>
  import glyphs from "../loom/glyphs.json";
  import * as hero from "../loom/hero.js";
  import * as cloth from "../loom/cloth.js";

  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const heroCanvas = document.getElementById("hero-loom") as HTMLCanvasElement;
  const clothCanvas = document.getElementById("cloth-loom") as HTMLCanvasElement;
  const replay = document.getElementById("hero-replay") as HTMLButtonElement;
  const ledger = document.getElementById("ledger") as HTMLOListElement;
  const again = document.getElementById("cloth-again") as HTMLButtonElement;
  const clothTitle = document.getElementById("cloth-title") as HTMLHeadingElement;

  function startHero() {
    // The loom is drawn on a clear canvas, so the page shows round it; the
    // faint warps run over it.
    // The words beside it arrive on their own, from the stylesheet, at 0.4s.
    const a = hero.create(heroCanvas, glyphs, { frozen: still ? hero.T.total : undefined, clear: true });
    let playingUntil = still ? 0 : performance.now() + hero.T.total;
    const busy = () => {
      replay.setAttribute("aria-disabled", "true");
      setTimeout(() => replay.removeAttribute("aria-disabled"), playingUntil - performance.now());
    };
    if (!still) busy();

    // The mark is a button, the mark's own size, laid over it: click, tap
    // or Enter weaves it again from the word, which stays faintly in place.
    const place = () => {
      const m = a.markRect();
      if (m) Object.assign(replay.style, { left: `${m[0]}px`, top: `${m[1]}px`, width: `${m[2]}px`, height: `${m[2]}px` });
    };
    new ResizeObserver(() => requestAnimationFrame(place)).observe(heroCanvas);
    requestAnimationFrame(place);
    replay.addEventListener("click", () => {
      if (still || performance.now() < playingUntil) return;
      a.again();
      playingUntil = performance.now() + hero.T.total;
      busy();
    });
    return a;
  }

  function startCloth() {
    const b = cloth.create(clothCanvas, glyphs, { frozen: still ? cloth.T.total : undefined, autoplay: false });
    let done = still;
    let pinned = -1;

    // The finished cloth is a ledger: buttons laid over its rows. Hover,
    // focus or a tap chooses a row; a tap keeps it chosen until the next.
    const build = () => {
      const g = b.rows();
      if (!g) return;
      ledger.replaceChildren(
        ...g.rows.map((row, r) => {
          const li = document.createElement("li");
          const button = document.createElement("button");
          button.type = "button";
          button.className = "ledger__row";
          button.textContent = row.call;
          button.setAttribute("aria-pressed", String(r === pinned));
          Object.assign(button.style, { top: `${row.y}px`, height: `${row.h}px`, width: `${g.right}px` });
          button.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && b.select(r));
          button.addEventListener("focus", () => b.select(r));
          button.addEventListener("blur", () => b.select(pinned));
          button.addEventListener("click", () => {
            pinned = pinned === r ? -1 : r;
            ledger.querySelectorAll("button").forEach((o, i) => o.setAttribute("aria-pressed", String(i === pinned)));
            b.select(pinned === -1 ? r : pinned);
          });
          li.append(button);
          return li;
        }),
      );
      ledger.hidden = false;
    };
    ledger.addEventListener("pointerleave", () => done && b.select(pinned));
    new ResizeObserver(() => done && requestAnimationFrame(build)).observe(clothCanvas);

    // Finished, the cloth is a ledger again and "Play again" appears in the
    // space kept for it. With reduced motion the cloth opens finished and
    // there is nothing to play again, so the button stays hidden.
    const finished = () => {
      done = true;
      build();
      if (!still) again.hidden = false;
    };
    // Weaves the cloth once more, from an empty loom. The button goes while
    // it plays, so focus moves to the section's heading, the nearest thing
    // that stays (SYSTEM.md, Navigation).
    let playing = 0;
    const play = () => {
      clearTimeout(playing);
      done = false;
      pinned = -1;
      b.reset();
      ledger.hidden = true;
      again.hidden = true;
      b.play();
      playing = window.setTimeout(finished, cloth.T.total);
    };
    again.addEventListener("click", () => {
      if (still) return;
      clothTitle.focus({ preventScroll: true });
      play();
    });

    // Woven once, when the top third of the loom is in view, whatever the
    // loom's height, so it plays on a phone too. A reader who has scrolled
    // past it before it began sees it finished, so it is never blank.
    if (still) build();
    else {
      let started = false;
      const header = () => document.querySelector(".shell-head")?.getBoundingClientRect().bottom ?? 0;
      const begin = (past: boolean) => {
        if (started) return;
        started = true;
        seen.disconnect();
        removeEventListener("scroll", look);
        if (past) {
          b.show(cloth.T.total);
          finished();
          return;
        }
        play();
      };
      function look() {
        const r = clothCanvas.getBoundingClientRect();
        if (r.bottom <= header()) begin(true);
        else if (r.top + r.height / 3 <= innerHeight && r.bottom > header()) begin(false);
      }
      const seen = new IntersectionObserver(look, { threshold: [0, 0.25, 0.5, 0.75, 1] });
      seen.observe(clothCanvas);
      addEventListener("scroll", look, { passive: true });
      look();
    }
    return b;
  }

  const start = () => {
    const a = startHero();
    const b = startCloth();
    // The loom takes the page's colours, so it follows a theme change.
    const recolor = () => requestAnimationFrame(() => (a.recolor(), b.recolor()));
    new MutationObserver(recolor).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", recolor);
  };

  // The organisations' names on the loom are drawn in the mono, so wait for it.
  (document.fonts?.ready ?? Promise.resolve()).then(start);
</script>

<style>
  /* The hero: the words on the left, the loom weaving the lockup beside
     them. Faint warps across it only: translucent lines at a fixed 32px
     pitch from the hero's left edge, the text colour at 4%, fading out
     before the next section. They are drawn over the loom at every width,
     so they run through the mark and tint it without cutting it; the words
     sit over them. */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--weft-space-8);
    align-items: center;
    padding-block: var(--weft-space-8) var(--weft-space-4);
  }
  .hero__ground {
    position: absolute;
    inset: calc(var(--weft-space-12) * -1) 0 0 0;
    z-index: 1;
    pointer-events: none;
    background-image: linear-gradient(to right, color-mix(in srgb, var(--weft-text) 4%, transparent) 1px, transparent 1px);
    background-size: 32px 100%;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);
  }
  .hero__text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-5);
    max-width: 42rem;
  }
  /* The words are on screen from 0.4s, as the warps drop, one after the
     other at the stagger; the weave beside them finishes on its own time. A
     one-way arrival, so keyframes. */
  .hero__text > * {
    animation: hero-words var(--weft-duration-slow) var(--weft-ease-out) 400ms both;
  }
  .hero__text > :nth-child(2) {
    animation-delay: calc(400ms + var(--weft-stagger));
  }
  .hero__text > :nth-child(3) {
    animation-delay: calc(400ms + var(--weft-stagger) * 2);
  }
  .hero__text > :nth-child(4) {
    animation-delay: calc(400ms + var(--weft-stagger) * 3);
  }
  @keyframes hero-words {
    from {
      opacity: 0;
      transform: translateY(var(--weft-shift-md));
    }
  }
  .hero h1 {
    font-size: var(--weft-type-display);
    line-height: var(--weft-leading-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .hero__sub {
    font-size: var(--weft-type-lg);
    line-height: var(--weft-leading-lg);
    color: var(--weft-text-muted);
    max-width: 34rem;
  }
  .hero__proof {
    font-size: var(--weft-type-md);
    line-height: var(--weft-leading-md);
    color: var(--weft-text-subtle);
  }
  .hero__stage {
    position: relative;
    height: 320px;
  }
  .hero__replay {
    position: absolute;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    /* The tile's corner, as a share of its size. */
    border-radius: 24%;
  }
  .hero__replay[aria-disabled="true"] {
    cursor: default;
  }
  .hero__replay:focus-visible {
    outline-offset: 4px;
  }
  .hero__stage canvas,
  .cloth__stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--weft-space-3);
  }

  /* The sections: space-24 before one with a stage, space-16 before one
     that is text, counting the Shell's own gap between sections. */
  .stage-section {
    padding-top: calc(var(--weft-space-24) - var(--weft-space-8));
  }
  .text-section {
    padding-top: calc(var(--weft-space-16) - var(--weft-space-8));
  }
  h2 {
    font-size: var(--weft-type-2xl);
    line-height: var(--weft-leading-2xl);
    letter-spacing: -0.02em;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-4);
    min-width: 0;
  }
  .col > .eyebrow + h2 {
    margin-top: calc(var(--weft-space-2) * -1);
  }
  .muted {
    color: var(--weft-text-muted);
    max-width: 34rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--weft-space-2) var(--weft-space-5);
    font-size: var(--weft-type-md);
    line-height: var(--weft-leading-md);
  }

  /* The problem: text beside a before-and-after diagram, drawn in HTML so
     its labels stay readable at every width. */
  .problem {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--weft-space-12);
    align-items: center;
  }
  .flow {
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-6);
  }
  .flow__row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) var(--weft-space-8) minmax(0, 7fr) var(--weft-space-8) minmax(0, 4fr);
    align-items: center;
  }
  .flow__label {
    grid-column: 1 / -1;
    margin-bottom: var(--weft-space-2);
    font: 500 var(--weft-type-xs) / var(--weft-leading-xs) var(--weft-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--weft-text-subtle);
  }
  .flow__box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 60px;
    padding: var(--weft-space-2) var(--weft-space-3);
    border: 1.5px solid var(--weft-line-strong);

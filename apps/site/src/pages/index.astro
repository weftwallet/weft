---
import Shell from "@weftwallet/ui/Shell.astro";
import { productHref } from "@weftwallet/ui/links";

const docs = (path: string) => productHref("docs", path);
const shown = [
  ["Who's asking", "The site's address, and which of your identities it wants to use."],
  ["What it calls", "The channel, the contract and the function, and every argument decoded."],
  ["Read or write", "Whether it only reads the ledger or changes it, said plainly."],
  ["What happens next", "Which organisations must approve it, and afterwards whether they did."],
];
const audiences = [
  {
    title: "Signing transactions",
    body: "Your organisation sends you an invite. Weft enrols you with its CA, keeps your key encrypted in the browser, and tells you before your certificate expires.",
    links: [
      ["Install Weft", docs("/start/install/")],
      ["Reading a signature request", docs("/guides/signing/")],
    ],
  },
  {
    title: "Building a dApp",
    body: "Call a Fabric contract from a web page, the way an Ethereum dApp asks MetaMask. Weft shows the user each request and signs it with their own identity.",
    links: [
      ["Quickstart", docs("/dapps/quickstart/")],
      ["Try the playground", productHref("playground")],
    ],
  },
  {
    title: "Running a network",
    body: "Run a small relay for your organisation and publish an invite. An explorer shows your ledger as you choose, and the network page puts every organisation's side by side.",
    links: [
      ["Deploy the relay", docs("/operators/relay/")],
      ["Weft Network", productHref("network")],
    ],
  },
];
---

<Shell product="site" description="An identity wallet for Hyperledger Fabric. Every transaction Weft signs is decoded and shown to you first." wide>
  <Fragment slot="nav">
    <a href={docs("/")}>Docs</a>
    <a href={productHref("playground")}>Playground</a>
    <a href={productHref("network")}>Network</a>
  </Fragment>

  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title" class="visually-hidden">Weft, an identity wallet for Hyperledger Fabric</h1>
    <div class="hero__stage">
      <div class="hero__ground" aria-hidden="true"></div>
      <canvas id="hero-loom" aria-hidden="true"></canvas>
      <button type="button" class="hero__replay" id="hero-replay" aria-label="Weave the mark again"></button>
    </div>
    <div class="hero__text" data-arrive>
      <script is:inline>
        // Hidden before the first paint, so the words never show and then
        // vanish: they arrive with the word (below). If the loom never
        // starts, they come in anyway.
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const words = document.currentScript.parentElement;
          words.dataset.arrive = "waiting";
          setTimeout(() => words.dataset.arrive === "waiting" && (words.dataset.arrive = "here"), 8000);
        }
      </script>
      <p class="hero__tagline">An identity wallet for Hyperledger Fabric.</p>
      <p class="hero__sub">Weft holds the certificate your organisation's CA issued you, and signs only what you approve, after showing you exactly what it does.</p>
      <div class="actions">
        <a class="btn btn--primary" href={docs("/start/install/")}>Install Weft</a>
        <a class="btn" href={productHref("playground")}>Try the playground</a>
        <a class="btn" href={docs("/start/what-is-weft/")}>How it works</a>
      </div>
    </div>
  </section>

  <section class="cloth" aria-labelledby="cloth-title">
    <div class="cloth__text">
      <span class="eyebrow">How it works</span>
      <h2 id="cloth-title">Every transaction, shown first</h2>
      <p>A dApp asks Weft to sign. Weft decodes the request, shows you what it calls, and signs only if you approve. Then the organisations it needs endorse it, and it's woven into the ledger every one of them keeps.</p>
    </div>
    <div class="cloth__stage">
      <canvas id="cloth-loom" aria-hidden="true"></canvas>
      <ol class="ledger" id="ledger" aria-label="The transactions woven into the cloth" hidden></ol>
    </div>
  </section>

  <section class="sheet" aria-labelledby="sheet-title">
    <div class="sheet__text">
      <span class="eyebrow">Before you sign</span>
      <h2 id="sheet-title">Nothing is signed that you haven't read</h2>
      <dl class="shown">
        {
          shown.map(([term, detail]) => (
            <div>
              <dt>{term}</dt>
              <dd>{detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <img
      src="/hero-product.png"
      width="953"
      height="1020"
      loading="lazy"
      alt="The Weft wallet showing an identity and its recent transactions, next to a signature request for a TransferShipment transaction."
    />
  </section>

  <section class="who" aria-labelledby="who-title">
    <h2 id="who-title">Weft is for three kinds of people</h2>
    <ul class="who__list">
      {
        audiences.map((a) => (
          <li>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            <div class="who__links">
              {a.links.map(([label, href]) => (
                <a href={href}>{label}</a>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Shell>

<script>
  import glyphs from "../loom/glyphs.json";
  import * as hero from "../loom/hero.js";
  import * as cloth from "../loom/cloth.js";

  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const heroCanvas = document.getElementById("hero-loom") as HTMLCanvasElement;
  const clothCanvas = document.getElementById("cloth-loom") as HTMLCanvasElement;
  const replay = document.getElementById("hero-replay") as HTMLButtonElement;
  const ledger = document.getElementById("ledger") as HTMLOListElement;
  const text = document.querySelector<HTMLElement>("[data-arrive]")!;

  function startHero() {
    // The page's ground shows through around the loom, faint warps and all.
    const a = hero.create(heroCanvas, glyphs, { frozen: still ? hero.T.total : undefined, clear: true });
    let playingUntil = still ? 0 : performance.now() + hero.T.total;
    const busy = () => {
      replay.setAttribute("aria-disabled", "true");
      setTimeout(() => replay.removeAttribute("aria-disabled"), playingUntil - performance.now());
    };
    if (!still) busy();

    // The hero's words arrive as the word sets itself again beside the mark.
    // The early script in the markup has already hidden them.
    if (!still) setTimeout(() => (text.dataset.arrive = "here"), hero.T.wordAgain + 200);

    // The mark is a button, the mark's own size, laid over it: click, tap
    // or Enter weaves it again from the word, which stays faintly in place.
    const place = () => {
      const m = a.markRect();
      if (m) Object.assign(replay.style, { left: `${m[0]}px`, top: `${m[1]}px`, width: `${m[2]}px`, height: `${m[2]}px` });
    };
    new ResizeObserver(() => requestAnimationFrame(place)).observe(heroCanvas);
    requestAnimationFrame(place);
    replay.addEventListener("click", () => {
      if (still || performance.now() < playingUntil) return;
      a.again();
      playingUntil = performance.now() + hero.T.total;
      busy();
    });
    return a;
  }

  function startCloth() {
    const b = cloth.create(clothCanvas, glyphs, { frozen: still ? cloth.T.total : undefined, autoplay: false });
    let done = still;
    let pinned = -1;

    // The finished cloth is a ledger: buttons laid over its rows. Hover,
    // focus or a tap chooses a row; a tap keeps it chosen until the next.
    const build = () => {
      const g = b.rows();
      if (!g) return;
      ledger.replaceChildren(
        ...g.rows.map((row, r) => {
          const li = document.createElement("li");
          const button = document.createElement("button");
          button.type = "button";
          button.className = "ledger__row";
          button.textContent = row.call;
          button.setAttribute("aria-pressed", String(r === pinned));
          Object.assign(button.style, { top: `${row.y}px`, height: `${row.h}px`, width: `${g.right}px` });
          button.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && b.select(r));
          button.addEventListener("focus", () => b.select(r));
          button.addEventListener("blur", () => b.select(pinned));
          button.addEventListener("click", () => {
            pinned = pinned === r ? -1 : r;
            ledger.querySelectorAll("button").forEach((o, i) => o.setAttribute("aria-pressed", String(i === pinned)));
            b.select(pinned === -1 ? r : pinned);
          });
          li.append(button);
          return li;
        }),
      );
      ledger.hidden = false;
    };
    ledger.addEventListener("pointerleave", () => b.select(pinned));
    new ResizeObserver(() => done && requestAnimationFrame(build)).observe(clothCanvas);

    // Woven once, when the bottom of the loom is in view: its bottom rows
    // are woven first. On a screen too short for the whole loom, the bottom
    // coming into view is enough. If it's on screen for a while without
    // that, or scrolled past, it's shown finished, so it's never blank.
    if (still) build();
    else {
      let started = false;
      let lingering = 0;
      const header = () => document.querySelector(".shell-head")?.getBoundingClientRect().bottom ?? 0;
      const begin = (finished: boolean) => {
        if (started) return;
        started = true;
        seen.disconnect();
        removeEventListener("scroll", look);
        clearTimeout(lingering);
        if (finished) {
          b.show(cloth.T.total);
          done = true;
          build();
          return;
        }
        b.play();
        setTimeout(() => {
          done = true;
          build();
        }, cloth.T.total);
      };
      function look() {
        const r = clothCanvas.getBoundingClientRect();
        const visible = r.top < innerHeight && r.bottom > header();
        if (visible && r.bottom <= innerHeight + 24) begin(false);
        else if (r.bottom <= header()) begin(true);
        else if (visible && !lingering) lingering = window.setTimeout(() => begin(true), 2500);
        else if (!visible) {
          clearTimeout(lingering);
          lingering = 0;
        }
      }
      const seen = new IntersectionObserver(look, { threshold: [0, 0.25, 0.5, 0.75, 1] });
      seen.observe(clothCanvas);
      addEventListener("scroll", look, { passive: true });
    }
    return b;
  }

  const start = () => {
    const a = startHero();
    const b = startCloth();
    // The loom takes the page's colours, so it follows a theme change.
    const recolor = () => requestAnimationFrame(() => (a.recolor(), b.recolor()));
    new MutationObserver(recolor).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", recolor);
  };

  // The organisations' names on the loom are drawn in the mono, so wait for it.
  (document.fonts?.ready ?? Promise.resolve()).then(start);
</script>

<style>
  /* Hero: the loom, then the words beneath it. */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--weft-space-6);
    margin-top: calc(var(--weft-space-12) * -1);
  }
  .hero__stage {
    position: relative;
    width: 100%;
    height: clamp(260px, 52vh, 520px);
  }
  /* Faint warps behind the hero only: hairlines on the layout's twelve
     columns, gone before the words. The loom the word is woven into. */
  .hero__ground {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(to right, color-mix(in srgb, var(--weft-bg), var(--weft-text) 4%) 1px, transparent 1px);
    background-size: calc(100% / 12) 100%;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);
  }
  .hero__replay {
    position: absolute;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    /* The tile's corner, as a share of its size. */
    border-radius: 24%;
  }
  .hero__replay[aria-disabled="true"] {
    cursor: default;
  }
  .hero__replay:focus-visible {
    outline-offset: 4px;
  }
  /* The cloth's rows as real buttons over the canvas: the readable ledger. */
  .ledger {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ledger[hidden] {
    display: none;
  }
  /* Made by the script, so outside Astro's scoping. */
  .ledger :global(.ledger__row) {
    position: absolute;
    left: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: transparent;
    font-size: 1px;
    cursor: pointer;
    border-radius: var(--weft-radius-sm);
  }
  .ledger :global(.ledger__row:focus-visible) {
    outline-offset: -2px;
  }
  .hero__stage canvas,
  .cloth__stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--weft-space-4);
    max-width: 40rem;
    text-align: center;
  }
  /* Visible unless the script is about to bring it in with the word. */
  .hero__text[data-arrive="waiting"] > * {
    opacity: 0;
    transform: translateY(var(--weft-shift-md));
  }
  .hero__text[data-arrive="here"] > * {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--weft-duration-slow) var(--weft-ease-out),
      transform var(--weft-duration-slow) var(--weft-ease-out);
  }
  /* The first child is the early script; the words follow it. */
  .hero__text[data-arrive="here"] > :nth-child(3) {
    transition-delay: var(--weft-stagger);
  }
  .hero__text[data-arrive="here"] > :nth-child(4) {
    transition-delay: calc(var(--weft-stagger) * 2);
  }
  .hero__tagline {
    font-size: var(--weft-type-2xl);
    line-height: var(--weft-leading-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--weft-text-strong);
    text-wrap: balance;
  }
  .hero__sub {
    font-size: var(--weft-type-lg);
    line-height: var(--weft-leading-lg);
    color: var(--weft-text-muted);
    text-wrap: balance;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--weft-space-3);
    padding-top: var(--weft-space-2);
  }

  /* Sections after the hero */
  section:not(.hero) {
    padding-top: var(--weft-space-24);
  }
  h2 {
    font-size: var(--weft-type-2xl);
    line-height: var(--weft-leading-2xl);
    letter-spacing: -0.02em;
  }

  .cloth {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--weft-space-8);
    align-items: center;
  }
  .cloth__text,
  .sheet__text {
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-4);
  }
  .cloth__text p {
    color: var(--weft-text-muted);
    max-width: 34rem;
  }
  .cloth__stage {
    position: relative;
    height: clamp(300px, 42vw, 440px);
  }

  .sheet {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--weft-space-12);
    align-items: center;
  }
  .sheet img {
    width: 100%;
    height: auto;
    display: block;
  }
  .shown {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-4);
  }
  .shown div {
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-1);
    padding-left: var(--weft-space-4);
    border-left: 2px solid var(--weft-accent-line);
  }
  .shown dt {
    font-weight: 600;
    color: var(--weft-text-strong);
  }
  .shown dd {
    margin: 0;
    color: var(--weft-text-muted);
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-8);
  }
  .who__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--weft-space-4);
  }
  .who__list li {
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-3);
    padding: var(--weft-space-6);
    background: var(--weft-bg-raised);
    border: 1px solid var(--weft-line);
    border-radius: var(--weft-radius-xl);
  }
  .who__list h3 {
    font-size: var(--weft-type-lg);
    line-height: var(--weft-leading-lg);
  }
  .who__list p {
    color: var(--weft-text-muted);
    flex: 1;
  }
  .who__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--weft-space-2) var(--weft-space-4);
    font-size: var(--weft-type-md);
  }

  @media (max-width: 860px) {
    .cloth,
    .sheet,
    .who__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .cloth__stage {
      height: 340px;
    }
  }
</style>

---
// The landing page behind invite links: previews the invite and hands it to
// the Weft extension with weft_addNetwork. With Weft and Weft Experimental
// both installed, it offers one button for each (docs/adr/0010).
import { productHref } from "@weftwallet/ui/links";
---

<div class="weft-join">
  <div id="join-missing" class="weft-card" hidden>
    <h2 class="weft-card__title">This link is missing its invite</h2>
    <p>Ask your administrator for the full link.</p>
  </div>

  <div id="join-main" class="weft-join" hidden>
    <div class="weft-card" id="join-preview">
      <span class="eyebrow">You've been invited to</span>
      <div class="weft-title" id="join-network">Reading the invite…</div>
      <dl class="weft-details" id="join-details" hidden>
        <dt>Organisation</dt><dd id="join-org"></dd>
        <dt>MSP ID</dt><dd class="mono" id="join-msp"></dd>
        <dt>Channels</dt><dd class="mono" id="join-channels"></dd>
      </dl>
      <p class="weft-muted" id="join-source"></p>
      <p class="weft-muted" id="join-preview-failed" hidden></p>
    </div>

    <div class="weft-actions" id="join-actions">
      <button type="button" class="btn btn--primary" id="join-open">Open in Weft</button>
    </div>
    <p class="weft-status" id="join-status" hidden></p>
    <div class="action-error" id="join-error" role="alert" hidden></div>

    <div class="weft-card" id="join-install" hidden>
      <h2 class="weft-card__title" id="join-install-title" tabindex="-1">Weft isn't installed in this browser</h2>
      <p>
        <a href={productHref("docs", "/start/install/")}>Install Weft</a>, then come back to this page. Or, in Weft, choose{" "}
        <em>Join from an invite</em> and paste this link:
      </p>
      <code id="join-weft-link"></code>
    </div>
  </div>
</div>

<script>
  import { announce, clearError, isBusy, reveal, setBusy, showError, technical, tokenMs } from "@weftwallet/ui/ui";
  import { onWallets, wallets, type WeftProvider, type WeftProviderDetail } from "@weftwallet/ui/wallets";

  const $ = (id: string) => document.getElementById(id)!;
  const raw = new URLSearchParams(window.location.search).get("weft-invite");
  let inviteUrl: URL | null = null;
  try {
    inviteUrl = raw ? new URL(raw) : null;
    if (inviteUrl && !/^https?:$/.test(inviteUrl.protocol)) inviteUrl = null;
  } catch {
    inviteUrl = null;
  }

  if (!inviteUrl) {
    $("join-missing").hidden = false;
  } else {
    const url = inviteUrl.toString();
    const host = inviteUrl.host;
    $("join-main").hidden = false;
    $("join-source").textContent = `Invite from ${host}`;
    $("join-weft-link").textContent = `weft://invite?u=${encodeURIComponent(url)}`;

    // Preview only. Weft fetches and validates the invite again itself. The
    // loader joins the words only if the answer takes longer than
    // wait-before-loader, so a quick one never flashes it.
    const loader = setTimeout(() => $("join-network").classList.add("is-working"), tokenMs("--weft-wait-before-loader", 300));
    fetch(url, { headers: { accept: "application/json" }, signal: AbortSignal.timeout(8000) })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))))
      .then((invite) => {
        $("join-network").textContent = String(invite.network ?? "a Fabric network");
        $("join-org").textContent = String(invite.organization ?? "");
        $("join-msp").textContent = String(invite.mspId ?? "");
        $("join-channels").textContent = Array.isArray(invite.channels) ? invite.channels.join(", ") : "";
        reveal($("join-details"));
      })
      .catch(() => {
        $("join-network").textContent = "a Fabric network";
        const note = $("join-preview-failed");
        note.textContent = `This page couldn't read the invite from ${host} to show its details. Weft reads it again when you open it, and tells you if it can't.`;
        note.hidden = false;
      })
      .finally(() => {
        clearTimeout(loader);
        $("join-network").classList.remove("is-working");
      });

    const waitForWeft = () =>
      new Promise<any>((resolve) => {
        const w = window as any;
        if (w.weft?.isWeft) return resolve(w.weft);
        const timer = setTimeout(() => resolve(null), 1500);
        window.addEventListener(
          "weft#initialized",
          () => {
            clearTimeout(timer);
            resolve(w.weft);
          },
          { once: true },
        );
      });

    const say = (text: string) => {
      const status = $("join-status");
      status.textContent = text;
      status.hidden = false;
      announce(text);
    };

    /**
     * Hands the invite to one wallet. `name` is the wallet's, in what the
     * page says, and `again` names the button to press again.
     */
    async function addTo(button: HTMLElement, find: () => Promise<WeftProvider | null>, name: string, again: string) {
      if (isBusy(button)) return;
      setBusy(button, true);
      clearError($("join-error"));
      $("join-status").hidden = true;
      try {
        const weft = await find();
        if (!weft) {
          reveal($("join-install"));
          $("join-install-title").focus();
          return;
        }
        say(`Continue in the ${name} window.`);
        await weft.request({ method: "weft_addNetwork", params: { url } });
        say(`You're enrolled. The network is in ${name}.`);
      } catch (error: any) {
        $("join-status").hidden = true;
        showError(
          $("join-error"),
          error?.code === 4001 ? `You rejected the request in ${name}, so the network wasn't added. ${again} again when you're ready.` : `${name} couldn't add the network. Try again, or ask your administrator to check the invite.`,
          error?.code === 4001 ? null : technical(error),
        );
      } finally {
        setBusy(button, false);
      }
    }

    $("join-open").addEventListener("click", () => addTo($("join-open"), waitForWeft, "Weft", "Open in Weft"));

    // Two wallets: one button for each, named after it, in place of Open in Weft.
    const showWallets = (list: WeftProviderDetail[]) => {
      if (list.length < 2) return;
      const actions = $("join-actions");
      const had = actions.contains(document.activeElement);
      const buttons = list.map((wallet, i) => {
        const label = `Add to ${wallet.info.name}`;
        const button = Object.assign(document.createElement("button"), { type: "button", className: i === 0 ? "btn btn--primary" : "btn", textContent: label });
        button.addEventListener("click", () => addTo(button, async () => wallet.provider, wallet.info.name, label));
        return button;
      });
      actions.replaceChildren(...buttons);
      if (had) buttons[0]!.focus();
    };
    showWallets(wallets());
    onWallets(showWallets);
  }
</script>

<style>
  .weft-join {
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-4);
    max-width: 32rem;
  }
  #join-main {
    margin-top: 0;
  }
  .weft-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--weft-space-2);
  }
  .weft-card {
    border: 1px solid var(--weft-line-strong);
    background: var(--weft-bg-raised);
    border-radius: var(--weft-radius-xl);
    padding: var(--weft-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-2);
  }
  .weft-card__title {
    font-size: var(--weft-type-lg);
    line-height: var(--weft-leading-lg);
  }
  .weft-card__title:focus {
    outline: none;
  }
  .weft-title {
    color: var(--weft-text-strong);
    font-size: var(--weft-type-2xl);
    line-height: var(--weft-leading-2xl);
    letter-spacing: -0.02em;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .weft-details {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--weft-space-2) var(--weft-space-4);
    margin: var(--weft-space-2) 0 0;
    font-size: var(--weft-type-md);
    line-height: var(--weft-leading-md);
  }
  .weft-details dt {
    color: var(--weft-text-subtle);
  }
  .weft-details dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .weft-muted {
    overflow-wrap: anywhere;
    color: var(--weft-text-subtle);
    font-size: var(--weft-type-md);
    line-height: var(--weft-leading-md);
  }
  .weft-status {
    color: var(--weft-text-muted);
  }
  #join-weft-link {
    overflow-wrap: anywhere;
    font-size: var(--weft-type-xs);
  }
</style>

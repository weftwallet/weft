---
/**
 * The network page: every organisation's explorer for one network, side by
 * side. It holds no data. It reads each explorer's public API from the
 * browser, finds the other organisations' explorers through the ones it
 * knows, and compares block hashes directly. A member can sign in with Weft
 * once; each explorer that names this page then gives it a token for what it
 * publishes to members.
 */
---

<div class="nw">
  <div class="nw-card nw-source">
    <form class="field" id="nw-form" novalidate>
      <label for="nw-input">An explorer, or your organisation's invite</label>
      <div class="nw-row" id="nw-row">
        <input id="nw-input" class="input" type="url" placeholder="https://explorer.org1.example.com" spellcheck="false" aria-describedby="nw-status" />
        <button type="submit" class="btn btn--primary" id="nw-load">Load</button>
      </div>
    </form>
    <p class="nw-hint" id="nw-status">
      Give one explorer: the page finds the others through it. Or open this page with <code>?explorer=&lt;url&gt;</code>.
    </p>
    <div class="action-error" id="nw-error" role="alert" hidden></div>
    <div class="nw-signin" id="nw-signin" hidden>
      <p class="nw-hint" id="nw-signin-text">Members of the network can sign in with Weft to include members-only channels.</p>
      <button type="button" class="btn" id="nw-signin-button">Sign in with Weft</button>
      <div class="action-error" id="nw-signin-error" role="alert" hidden></div>
    </div>
  </div>

  <div id="nw-channels" class="nw-channels"></div>
  <div id="nw-notes" class="nw-notes"></div>
</div>

<script>
  import type { BlockHeader, MemberCas, SignedCheckpoint } from "@weftwallet/core/chain";
  import { announce, clearError, closesInReverse, conceal, fetchProblem, grouped, isBusy, isWebUrl, reveal, setBusy, setFieldError, showError, technical, watchFields } from "@weftwallet/ui/ui";

  const LOCAL_INVITE = "http://localhost:8787/.well-known/weft-invite.json";
  const MAX_EXPLORERS = 24;
  const REFRESH_MS = 15_000;

  type Publishes = { values: "show" | "hash"; submitter: "show" | "hide"; privateData?: "names" | "hashes"; membersOnly: string[]; elections: boolean };
  type ChannelStatus = { channel: string; height: number; level: string; publishes?: Publishes; state?: string };
  type Status = { name: string; mspId?: string | null; channels: ChannelStatus[] };
  type Peer = { url: string; mspId: string | null; state: string; agreedUpTo: number | null; mismatchAt: number | null };
  type Explorer = { base: string; status: Status | null; peers: Record<string, Peer[]>; error?: string };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> = {}, ...children: (Node | string)[]) => {
    const node = Object.assign(document.createElement(tag), props);
    node.append(...children);
    return node;
  };
  /** Sets an element's text only when it changed, so nothing is disturbed for nothing. */
  const text = (node: Element, value: string) => {
    if (node.textContent !== value) node.textContent = value;
  };
  const trim = (url: string) => url.replace(/\/+$/, "");
  const count = (n: number) => (n === 2 ? "Both" : `All ${n}`);

  let starts: string[] = [];
  let explorers: Explorer[] = [];
  let timer: ReturnType<typeof setTimeout> | null = null;
  /** Which load is current: an older one that finishes late is dropped. */
  let generation = 0;
  /** One "compare a block" panel per channel, kept across refreshes so its results stay. */
  const compares = new Map<string, HTMLElement>();
  /** What the page last said about each channel, to announce only changes. */
  const said = new Map<string, string>();
  const membersOf = (channel: string) => explorers.filter((e) => e.status?.channels.some((c) => c.channel === channel));

  /** Bearer tokens from explorers that accepted the sign-in, by base URL. */
  const tokens = new Map<string, string>();
  /** The signed sign-in, kept in memory to sign in to explorers found later. */
  let signedIn: { message: string; signature: string; certificate: string; mspId: string; name: string | null } | null = null;
  /** Explorers that refused the sign-in, and why. */
  const refused = new Map<string, string>();

  function authFor(url: string): Record<string, string> {
    for (const [base, token] of tokens) if (url.startsWith(`${base}/`)) return { authorization: `Bearer ${token}` };
    return {};
  }

  async function getJson(url: string) {
    const response = await fetch(url, { signal: AbortSignal.timeout(5000), headers: { accept: "application/json", ...authFor(url) } });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json();
  }

  /** The hint under the address: what the page found. Not a live region; announce() says what changed. */
  function setStatus(value: string, working = false) {
    const p = $("nw-status");
    p.textContent = value;
    p.classList.toggle("is-working", working);
  }

  /** Reads one explorer: its status, and for each channel who it compares with. */
  async function readExplorer(base: string): Promise<Explorer> {
    try {
      const status: Status = await getJson(`${base}/api/v1/status`);
      const peers: Record<string, Peer[]> = {};
      await Promise.all(
        status.channels.map(async (c) => {
          peers[c.channel] = await getJson(`${base}/api/v1/channels/${encodeURIComponent(c.channel)}/organisations`).catch(() => []);
        }),
      );
      return { base, status, peers };
    } catch (error) {
      return { base, status: null, peers: {}, error: error instanceof Error ? `${error.name === "TimeoutError" ? "Timed out" : error.message}` : String(error) };
    }
  }

  /** Starts from the explorers given and follows each one's list of the others. */
  async function discover(from: string[]): Promise<Explorer[]> {
    const seen = new Set<string>();
    const found: Explorer[] = [];
    let frontier = from.map(trim);
    while (frontier.length && found.length < MAX_EXPLORERS) {
      // An explorer lists the same peer once per channel they share.
      const batch = [...new Set(frontier)].filter((u) => !seen.has(u)).slice(0, MAX_EXPLORERS - found.length);
      batch.forEach((u) => seen.add(u));
      const read = await Promise.all(batch.map(readExplorer));
      found.push(...read);
      frontier = read.flatMap((e) => Object.values(e.peers).flat().map((p) => trim(p.url))).filter((u) => !seen.has(u));
    }
    return found;
  }

  const nameOf = (e: Explorer) => e.status?.name ?? new URL(e.base).host;
  const mspOf = (e: Explorer) => e.status?.mspId ?? null;

  function describe(c: ChannelStatus): string {
    const level = c.level === "members" ? "Members only" : "Public";
    if (!c.publishes) return level;
    const p = c.publishes;
    const parts = [p.values === "show" ? "values" : "values as hashes", p.submitter === "show" ? "submitters" : "no submitters"];
    if (p.membersOnly.length) parts.push(`members only: ${p.membersOnly.join(", ")}`);
    if (p.privateData === "hashes") parts.push("private data hashes");
    if (p.elections) parts.push("elections");
    return `${level}: ${parts.join(", ")}`;
  }

  /** One line for the whole channel, from what every explorer reports about the others. */
  function verdict(channel: string, members: Explorer[]): { tone: "ok" | "bad" | "quiet" | "one"; text: string } {
    const reports = members.flatMap((e) => (e.peers[channel] ?? []).map((p) => ({ from: e, peer: p })));
    const bad = reports.filter((r) => r.peer.state === "mismatch");
    if (bad.length) {
      const first = Math.min(...bad.map((r) => r.peer.mismatchAt ?? Infinity));
      const who = [...new Set(bad.map((r) => `${nameOf(r.from)} and ${r.peer.mspId ?? new URL(r.peer.url).host}`))].join("; ");
      return { tone: "bad", text: `Ledgers differ from block ${first}: ${who}.` };
    }
    if (members.length < 2) return { tone: "one", text: "Only one organisation publishes this channel, so there's nothing to compare yet." };
    const agreed = reports.map((r) => (r.peer.state === "agree" ? r.peer.agreedUpTo : null));
    if (!agreed.length || agreed.some((a) => a === null)) {
      return { tone: "quiet", text: `${members.length} organisations publish this channel. They're still comparing.` };
    }
    return { tone: "ok", text: `${count(members.length)} organisations agree on every block up to ${Math.min(...(agreed as number[]))}.` };
  }

  function agreementText(e: Explorer, channel: string): string {
    const peers = e.peers[channel] ?? [];
    if (!peers.length) return "Doesn't compare with anyone";
    return peers
      .map((p) => {
        const who = p.mspId ?? new URL(p.url).host;
        if (p.state === "agree") return `${who}: same up to ${p.agreedUpTo}`;
        if (p.state === "mismatch") return `${who}: differs from ${p.mismatchAt}`;
        if (p.state === "unreachable") return `${who}: can't reach`;
        if (p.state === "invalid") return `${who}: checkpoint rejected`;
        return `${who}: checking`;
      })
      .join(" · ");
  }

  const PILL = { ok: "Agree", bad: "Differ", quiet: "Comparing", one: "One organisation" } as const;

  /** A channel's card, made once; render() updates it in place. */
  function channelCard(channel: string): HTMLElement {
    const root = $("nw-channels");
    let card = root.querySelector<HTMLElement>(`:scope > section[data-channel="${CSS.escape(channel)}"]`);
    if (card) return card;
    const h2 = el("h2", { className: "mono" }, channel);
    const table = el(
      "div",
      { className: "nw-table" },
      el(
        "table",
        {},
        el(
          "thead",
          {},
          el(
            "tr",
            {},
            el("th", { scope: "col", textContent: "Organisation" }),
            el("th", { scope: "col", className: "nw-num", textContent: "Blocks" }),
            el("th", { scope: "col", textContent: "Publishes" }),
            el("th", { scope: "col", textContent: "Compares with" }),
          ),
        ),
        el("tbody"),
      ),
    );
    card = el("section", { className: "nw-card arrive" }, el("div", { className: "nw-head" }, h2, el("span", { className: "nw-pill" })), el("p", { className: "nw-verdict" }), table);
    card.dataset.channel = channel;
    card.setAttribute("aria-label", `Channel ${channel}`);
    if (!compares.has(channel)) compares.set(channel, compareBlock(channel));
    card.append(compares.get(channel)!);
    // In order, without moving the cards already there (moving one would take focus off it).
    const after = [...root.querySelectorAll<HTMLElement>(":scope > section[data-channel]")].find((c) => c.dataset.channel!.localeCompare(channel) > 0);
    root.insertBefore(card, after ?? null);
    return card;
  }

  /** An organisation's row in a channel's table, made once and updated in place. */
  function orgRow(tbody: HTMLElement, base: string): HTMLTableRowElement {
    let tr = tbody.querySelector<HTMLTableRowElement>(`:scope > tr[data-base="${CSS.escape(base)}"]`);
    if (tr) return tr;
    tr = el(
      "tr",
      { className: "arrive" },
      el("td", {}, el("a", { target: "_blank", rel: "noreferrer" }), el("div", { className: "nw-sub mono" })),
      el("td", { className: "mono nw-num" }),
      el("td"),
      el("td", { className: "nw-sub" }),
    );
    tr.dataset.base = base;
    tbody.append(tr);
    return tr;
  }

  /** Brings the page up to date in place, so focus, an open check and its results survive. */
  function render() {
    const reachable = explorers.filter((e) => e.status);
    const unreachable = explorers.filter((e) => !e.status);
    const updated = new Date().toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
    setStatus(
      `${reachable.length} ${reachable.length === 1 ? "explorer" : "explorers"} found${unreachable.length ? `, ${unreachable.length} unreachable` : ""}. Updated at ${updated}, and every ${REFRESH_MS / 1000} seconds.`,
    );
    const channels = [...new Set(reachable.flatMap((e) => e.status!.channels.map((c) => c.channel)))].sort();
    const changes: string[] = [];

    // Channels no longer published (after signing out, say) leave the way they came.
    $("nw-channels")
      .querySelectorAll<HTMLElement>(":scope > section[data-channel]")
      .forEach((card) => {
        if (channels.includes(card.dataset.channel!)) return;
        said.delete(card.dataset.channel!);
        conceal(card);
        setTimeout(() => card.hidden && card.remove(), 500);
      });

    for (const channel of channels) {
      const members = reachable.filter((e) => e.status!.channels.some((c) => c.channel === channel));
      const v = verdict(channel, members);
      const card = channelCard(channel);
      if (card.hidden || card.classList.contains("is-leaving")) reveal(card);
      const h2 = card.querySelector("h2")!;
      const membersOnly = members.some((e) => e.status!.channels.find((x) => x.channel === channel)?.level === "members");
      const tag = h2.querySelector(".nw-tag");
      if (membersOnly && !tag) h2.append(el("span", { className: "nw-tag", textContent: "members only" }));
      if (!membersOnly && tag) tag.remove();
      const pill = card.querySelector<HTMLElement>(".nw-pill")!;
      pill.className = `nw-pill nw-pill--${v.tone}`;
      text(pill, PILL[v.tone]);
      const verdictP = card.querySelector<HTMLElement>(".nw-verdict")!;
      verdictP.className = `nw-verdict nw-verdict--${v.tone}`;
      text(verdictP, v.text);
      // Heard only when the verdict itself changes, not when a block number inside it moves on.
      const gist = `${v.tone}:${v.text.replace(/\d+/g, "#")}`;
      if (said.has(channel) && said.get(channel) !== gist) changes.push(`${channel}: ${v.text}`);
      said.set(channel, gist);

      const tbody = card.querySelector("tbody")!;
      const bases = members.map((e) => e.base);
      tbody.querySelectorAll<HTMLElement>(":scope > tr[data-base]").forEach((tr) => !bases.includes(tr.dataset.base!) && tr.remove());
      for (const e of members) {
        const c = e.status!.channels.find((x) => x.channel === channel)!;
        const tr = orgRow(tbody, e.base);
        const [who, blocks, publishes, compares] = tr.querySelectorAll("td");
        const link = who!.querySelector("a")!;
        const href = `${e.base}/channels/${encodeURIComponent(channel)}`;
        if (link.getAttribute("href") !== href) link.href = href;
        text(link, nameOf(e));
        text(who!.querySelector("div")!, mspOf(e) ?? "");
        // A new block since you looked: the row gets the accent rule for four seconds.
        const before = Number(blocks!.dataset.height ?? c.height);
        blocks!.dataset.height = String(c.height);
        text(blocks!, String(c.height));
        if (c.height > before) {
          tr.classList.remove("is-new");
          void tr.offsetWidth;
          tr.classList.add("is-new");
        }
        text(publishes!, describe(c));
        text(compares!, agreementText(e, channel));
      }
    }

    // Notes under the channels: what couldn't be reached, or why there's nothing.
    const notes: string[] = [];
    if (unreachable.length) {
      notes.push(
        `Couldn't reach ${unreachable.map((e) => `${new URL(e.base).host} (${e.error})`).join(", ")}. ${unreachable.length === 1 ? "It may be down, or not allow" : "They may be down, or not allow"} other sites to read the API.`,
      );
    }
    if (channels.length === 0 && reachable.length > 0) {
      notes.push(signedIn ? "None of these explorers publishes a channel you can see." : "These explorers publish no public channels. Members can sign in to see the members-only ones.");
    }
    const box = $("nw-notes");
    const key = notes.join("\n");
    if (box.dataset.key !== key) {
      box.dataset.key = key;
      box.replaceChildren(...notes.map((n) => el("p", { className: "nw-hint", textContent: n })));
    }
    if (changes.length) announce(changes.join(" "));
  }

  /** Most blocks the page walks back from a checkpoint before giving up. */
  const MAX_WALK = 20_000;

  type Check = {
    e: Explorer;
    hash?: string;
    ok: boolean;
    pending?: boolean;
    text: string;
  };

  /** The channel configuration most explorers report, and who reports a different one. */
  async function channelMembers(channel: string, members: Explorer[]) {
    const read = await Promise.all(
      members.map(async (e) => ({ e, list: (await getJson(`${e.base}/api/v1/channels/${encodeURIComponent(channel)}/members`).catch(() => null)) as MemberCas[] | null })),
    );
    const key = (list: MemberCas[]) => JSON.stringify([...list].sort((a, b) => a.mspId.localeCompare(b.mspId)));
    const counts = new Map<string, number>();
    read.forEach((r) => r.list && counts.set(key(r.list), (counts.get(key(r.list)) ?? 0) + 1));
    const best = [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];
    return {
      members: best ? (JSON.parse(best) as MemberCas[]) : [],
      differing: read.filter((r) => !r.list || key(r.list) !== best).map((r) => nameOf(r.e)),
    };
  }

  /**
   * One explorer's evidence for block n: its signed checkpoint, checked
   * against the channel's CAs, and the headers from n up to that checkpoint,
   * each hash recomputed here.
   */
  async function checkExplorer(e: Explorer, channel: string, n: number, members: MemberCas[]): Promise<Check> {
    const api = `${e.base}/api/v1/channels/${encodeURIComponent(channel)}`;
    let signed: SignedCheckpoint;
    try {
      signed = await getJson(`${api}/checkpoint`);
    } catch {
      return { e, ok: false, text: "Doesn't publish a signed checkpoint for this channel." };
    }
    try {
      // The checking code, certificate parsing included, loads only when a check runs.
      const { checkHeaders, verifyCheckpoint } = await import("@weftwallet/core/chain");
      const verified = await verifyCheckpoint(signed, members);
      if (!verified.ok) return { e, ok: false, text: `Its checkpoint doesn't check out: ${verified.reason}` };
      const cp = verified.checkpoint;
      if (n > cp.number) return { e, ok: false, pending: true, text: `Hasn't signed up to block ${n} yet; its checkpoint is at block ${cp.number}.` };
      if (cp.number - n > MAX_WALK) return { e, ok: false, pending: true, text: `Block ${n} is more than ${MAX_WALK.toLocaleString("en-GB")} blocks before its checkpoint, too far to walk here.` };
      const headers: BlockHeader[] = [];
      for (let from = n; from <= cp.number; from += 1000) {
        const page: BlockHeader[] = await getJson(`${api}/headers?from=${from}&to=${Math.min(from + 999, cp.number)}`).catch(() => []);
        if (!page.length) break;
        headers.push(...page);
      }
      const chain = await checkHeaders(headers);
      if (!chain.ok) return { e, ok: false, text: chain.reason };
      if (chain.from !== n || chain.to !== cp.number) return { e, ok: false, text: `Didn't serve every header from ${n} to ${cp.number}.` };
      if (headers[headers.length - 1]!.hash !== cp.hash) return { e, ok: false, text: `Its headers don't end at the hash its checkpoint signs.` };
      const hash = headers[0]!.hash;
      const steps = cp.number - n;
      return {
        e,
        hash,
        ok: true,
        text: `${cp.mspId} signed block ${cp.number}${steps ? `, and ${steps} ${steps === 1 ? "link leads" : "links lead"} back to this block` : ""}. Signature and certificate check out.`,
      };
    } catch (error) {
      return { e, ok: false, text: `The check stopped with an error: ${error instanceof Error ? error.message : String(error)}` };
    }
  }

  let compareCount = 0;

  /** Checks one block in every explorer, in this browser. */
  function compareBlock(channel: string) {
    const id = `nw-block-${++compareCount}`;
    const latest = () => Math.max(0, Math.min(...membersOf(channel).map((e) => e.status!.channels.find((x) => x.channel === channel)!.height)) - 1);
    const input = el("input", { type: "number", min: "0", value: String(latest()), className: "input mono", id });
    const label = el("label", { htmlFor: id, textContent: "Block number" });
    const out = el("ul", { className: "nw-hashes" });
    const failed = el("div", { className: "action-error", hidden: true });
    failed.setAttribute("role", "alert");
    const button = el("button", { type: "submit", className: "btn btn--primary", textContent: "Check" });
    const row = el("div", { className: "nw-row" }, input, button);
    const form = el("form", { className: "field nw-check" }, label, row);
    form.noValidate = true;
    const blockError = () => {
      const value = input.value.trim();
      const top = latest();
      if (!/^\d+$/.test(value)) return "Enter a block number: a whole number, 0 or more.";
      return Number(value) > top ? `The newest block every organisation has is ${top}. Enter ${top} or less.` : null;
    };
    const check = watchFields([{ field: input, after: row, check: blockError }]);
    const run = async () => {
      if (isBusy(button) || !check.checkAll()) return;
      const n = Number(input.value);
      const explorersHere = membersOf(channel);
      setBusy(button, true);
      clearError(failed);
      out.replaceChildren(el("li", { className: "nw-hint is-working", textContent: `Checking block ${n} in ${explorersHere.length} explorers…` }));
      try {
        const { members, differing } = await channelMembers(channel, explorersHere);
        const checks = await Promise.all(explorersHere.map((e) => checkExplorer(e, channel, n, members)));
        const hashes = new Set(checks.filter((c) => c.ok).map((c) => c.hash));
        const agreed = checks.filter((c) => c.ok);
        const summary =
          agreed.length === checks.length && hashes.size === 1
            ? `${count(checks.length)} organisations signed a ledger with the same block ${n}. Checked in this browser.`
            : hashes.size > 1
              ? `The organisations' signed ledgers have different blocks at ${n}.`
              : `${agreed.length} of ${checks.length} organisations' ledgers could be checked for block ${n}.`;
        const majority = [...hashes][0];
        out.replaceChildren(
          ...checks.map((c) => {
            const tone = c.pending ? "quiet" : !c.ok ? "bad" : hashes.size > 1 && c.hash !== majority ? "bad" : "ok";
            return el(
              "li",
              { className: `nw-hash nw-hash--${tone} arrive` },
              el("span", { className: "nw-hash-who", textContent: nameOf(c.e) }),
              el(
                "span",
                {},
                // In full, grouped in fours, so the hashes can be compared block by block.
                ...(c.hash ? [el("span", { className: "mono nw-hash-value", textContent: grouped(c.hash) })] : []),
                el("span", { className: "nw-sub nw-hash-why", textContent: c.text }),
              ),
            );
          }),
          el("li", { className: `nw-hint nw-summary`, textContent: summary }),
          ...(differing.length
            ? [el("li", { className: "nw-hint", textContent: `${differing.join(", ")} reported a different channel configuration; the page used the one most explorers report.` })]
            : []),
        );
        announce(summary);
      } catch (error) {
        out.replaceChildren();
        showError(failed, `The check didn't finish. Check again, or try another block.`, technical(error));
      } finally {
        setBusy(button, false);
      }
    };
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      void run();
    });
    const details = el(
      "details",
      { className: "disclosure nw-compare" },
      el("summary", { textContent: "Check a block in your browser" }),
      el(
        "div",
        { className: "nw-compare__body" },
        el(
          "p",
          { className: "nw-hint" },
          "For each organisation, the page checks its signed checkpoint against the CAs in the channel configuration, then recomputes every block hash from there back to this block. It doesn't rely on what the explorers say about each other. It can't check a block's transactions, which need the block's raw data; that rests on each explorer's own data hash check.",
        ),
        form,
        failed,
        out,
      ),
    );
    closesInReverse(details);
    details.addEventListener("toggle", () => {
      if (!details.open || out.childElementCount) return;
      input.value = String(latest());
      setFieldError(input, null);
      void run();
    });
    return details;
  }

  /** Hands the sign-in to every explorer found that hasn't had it yet. Returns whether any new one accepted. */
  async function signInEverywhere(): Promise<boolean> {
    if (!signedIn) return false;
    const fresh = explorers.filter((e) => !tokens.has(e.base) && !refused.has(e.base));
    const results = await Promise.all(
      fresh.map(async (e) => {
        try {
          const response = await fetch(`${e.base}/auth/network`, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(signedIn),
            signal: AbortSignal.timeout(8000),
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(body.error ?? `HTTP ${response.status}`);
          tokens.set(e.base, body.token);
          if (signedIn && !signedIn.name && body.name) signedIn.name = body.name;
          return true;
        } catch (error) {
          refused.set(e.base, error instanceof Error ? (error.name === "TimeoutError" ? "didn't answer in time" : error.message) : String(error));
          return false;
        }
      }),
    );
    showSignIn();
    return results.some(Boolean);
  }

  async function refresh() {
    explorers = await discover(starts);
    // Members-only channels can name explorers the public view didn't.
    if (await signInEverywhere()) explorers = await discover(starts);
  }

  /** Refreshes on a timer, one refresh at a time. */
  function schedule() {
    if (timer) clearTimeout(timer);
    const mine = generation;
    timer = setTimeout(async () => {
      await refresh();
      if (mine !== generation) return;
      render();
      schedule();
    }, REFRESH_MS);
  }

  function showSignIn() {
    const box = $("nw-signin");
    box.hidden = explorers.length === 0;
    const button = $<HTMLButtonElement>("nw-signin-button");
    if (isBusy(button)) return;
    const textP = $("nw-signin-text");
    if (!signedIn) {
      text(
        textP,
        (window as any).weft?.isWeft
          ? "Members of the network can sign in with Weft to include members-only channels."
          : "Members of the network can sign in with Weft to include members-only channels. Install Weft in this browser to sign in.",
      );
      text(button, "Sign in with Weft");
      button.disabled = !(window as any).weft?.isWeft;
      return;
    }
    const who = `${signedIn.name ?? "you"} (${signedIn.mspId})`;
    const accepted = explorers.filter((e) => tokens.has(e.base)).map(nameOf);
    const no = [...refused].map(([base, why]) => `${explorers.find((e) => e.base === base) ? nameOf(explorers.find((e) => e.base === base)!) : new URL(base).host} (${why})`);
    text(textP, `Signed in as ${who}${accepted.length ? ` at ${accepted.join(", ")}` : ""}.${no.length ? ` Not accepted by ${no.join("; ")}.` : ""}`);
    text(button, "Sign out");
    button.disabled = false;
  }

  function randomNonce() {
    return btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(24)))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  }

  /** What a wallet error means, for the sign-in. */
  function signInProblem(error: any): string {
    if (error?.code === 4001) return "You declined in Weft, so you're not signed in. Sign in again when you're ready.";
    if (error?.code === 4300) return "Weft has no identity yet. Join your organisation's network in Weft first.";
    if (error?.code === 4301) return "Your certificate has expired. Renew it in Weft, then sign in again.";
    if (error?.code === -32002) return "Weft already has a request from this page waiting. Finish it in the Weft window first.";
    return "Sign-in didn't complete. Try again.";
  }

  $("nw-signin-button").addEventListener("click", async () => {
    const button = $<HTMLButtonElement>("nw-signin-button");
    if (isBusy(button)) return;
    clearError($("nw-signin-error"));
    setBusy(button, true);
    if (signedIn) {
      signedIn = null;
      tokens.clear();
      refused.clear();
      generation++;
      try {
        await refresh();
        render();
        announce("Signed out. Members-only channels are no longer shown.");
      } finally {
        setBusy(button, false);
        showSignIn();
        schedule();
      }
      return;
    }
    const weft = (window as any).weft;
    try {
      await weft.request({ method: "weft_connect" });
      const signed = await weft.request({
        method: "weft_signIn",
        params: { nonce: randomNonce(), statement: "Sign in to this network's explorers, for the members-only channels." },
      });
      signedIn = { message: signed.message, signature: signed.signature, certificate: signed.certificate, mspId: signed.mspId, name: null };
      generation++;
      await signInEverywhere();
      await refresh();
      render();
      announce(`Signed in as ${signedIn.name ?? signedIn.mspId}.`);
      schedule();
    } catch (error: any) {
      showError($("nw-signin-error"), signInProblem(error), technical(error));
    } finally {
      setBusy(button, false);
      showSignIn();
    }
  });
  window.addEventListener("weft#initialized", showSignIn, { once: true });

  async function load(from: string[], quiet = false) {
    const mine = ++generation;
    starts = from;
    const button = $("nw-load");
    setBusy(button, true);
    clearError($("nw-error"));
    if (!quiet) setStatus("Looking for explorers…", true);
    try {
      const found = await discover(from);
      if (mine !== generation) return;
      explorers = found;
      await signInEverywhere();
      const ok = explorers.filter((e) => e.status).length;
      if (!ok) {
        setStatus("");
        const failures = explorers.map((e) => `${e.base}: ${e.error}`).join("\n");
        showError($("nw-error"), `Couldn't read ${from.map((u) => new URL(u).host).join(", ")}. Check the address, that the explorer is running, and that it allows other sites to read its API.`, failures);
        return;
      }
      // A different network: start from nothing.
      if (!quiet) {
        $("nw-channels").replaceChildren();
        compares.clear();
        said.clear();
      }
      render();
      showSignIn();
      announce(`${ok} ${ok === 1 ? "explorer" : "explorers"} found.`);
      schedule();
    } finally {
      if (mine === generation) setBusy(button, false);
    }
  }

  /** An invite names its organisation's explorer; anything else is taken as an explorer. */
  async function resolve(input: string): Promise<string[]> {
    const url = trim(input.trim());
    if (/\.json$|weft-invite/.test(url)) {
      let invite: any;
      try {
        invite = await getJson(url);
      } catch (error) {
        throw Object.assign(new Error(fetchProblem(error, "The invite's address")), { details: `${url}\n${(error as Error)?.message ?? error}` });
      }
      if (typeof invite.explorerUrl !== "string") throw Object.assign(new Error("That invite doesn't name an explorer. Ask its organisation for their explorer's address, and enter that instead."), { details: url });
      return [invite.explorerUrl];
    }
    return [url];
  }

  const addressField = watchFields([
    {
      field: $<HTMLInputElement>("nw-input"),
      after: $("nw-row"),
      check: () => {
        const value = $<HTMLInputElement>("nw-input").value.trim();
        if (!value) return "Enter an explorer's address, or your organisation's invite URL.";
        return isWebUrl(value) ? null : "Enter a full address starting with http:// or https://.";
      },
    },
  ]);

  $("nw-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    if (isBusy($("nw-load")) || !addressField.checkAll()) return;
    clearError($("nw-error"));
    try {
      const from = await resolve($<HTMLInputElement>("nw-input").value);
      history.replaceState(null, "", `?explorer=${encodeURIComponent(from[0]!)}`);
      await load(from);
    } catch (error: any) {
      showError($("nw-error"), error?.message ?? String(error), error?.details);
    }
  });

  const params = new URLSearchParams(location.search);
  const given = [...params.getAll("explorer"), ...params.getAll("invite")];
  if (given.length) {
    $<HTMLInputElement>("nw-input").value = given[0]!;
    Promise.all(given.map(resolve))
      .then((lists) => load(lists.flat()))
      .catch((error) => showError($("nw-error"), error?.message ?? String(error), error?.details));
  } else {
    // Quietly look for the local playground, as the playground page does.
    getJson(LOCAL_INVITE)
      .then((invite) => {
        if (typeof invite.explorerUrl !== "string") return;
        $<HTMLInputElement>("nw-input").value = invite.explorerUrl;
        return load([invite.explorerUrl]);
      })
      .catch(() => {});
  }
</script>


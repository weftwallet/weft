---
/**
 * The page a host serves for an address Weft Network has no page for
 * (SystemPage.astro: one layout for every product's 404). Weft Network has
 * two pages, the network view and the invite maker, so both are offered.
 */
import Shell from "@weftwallet/ui/Shell.astro";
import SystemPage from "@weftwallet/ui/SystemPage.astro";
import { productHref } from "@weftwallet/ui/links";
---

<Shell product="network" title="Page not found" description="There's no page at this address in Weft Network.">
  <Fragment slot="nav">
    <a href={productHref("network")}><span class="shell-nav__full">Weft Network</span><span class="shell-nav__short">Network</span></a>
    <a href={productHref("network", "/invite/")}><span class="shell-nav__full">Invite maker, for operators</span><span class="shell-nav__short">Invite maker</span></a>
    <a href={productHref("docs", "/operators/network/")}>How it works</a>
  </Fragment>

  <SystemPage
    product="network"
    eyebrow="Error 404"
    heading="There's no page at this address"
    lead={["The address may be mistyped, or the page may have moved."]}
    address
    actions={[
      { label: "Go to Weft Network", kind: "primary", href: productHref("network") },
      { label: "Open the invite maker", href: productHref("network", "/invite/") },
    ]}
    back
  />
</Shell>

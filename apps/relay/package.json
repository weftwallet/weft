{
  "name": "@weftwallet/relay",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Stateless relay between the Weft wallet and a Fabric peer Gateway service",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@grpc/grpc-js": "^1.14.6",
    "@hyperledger/fabric-gateway": "^1.13.0",
    "@weftwallet/core": "workspace:*",
    "@weftwallet/protocol": "workspace:*",
    "fastify": "^5.12.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@hyperledger/fabric-protos": "^0.2.2",
    "@peculiar/x509": "^2.2.0",
    "@types/node": "^26.6.5",
    "vitest": "^5.0.5"
  }
}

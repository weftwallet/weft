---
// An interactive dApp for trying Weft against any network that publishes an
// invite: the public demo network when one is hosted (products.json, "demo"),
// the local playground stack, or your own.
import { productHref } from "@weftwallet/ui/links";
import PrivateElection from "./PrivateElection.astro";
const docs = (path: string) => productHref("docs", path);
interface Props {
  /** The demo network's invite URL, when one is hosted; the page opens on it. */
  demoInvite?: string | null;
}
const { demoInvite = null } = Astro.props;
---

<div class="pg" data-docs={productHref("docs")} data-network={productHref("network")} data-demo-invite={demoInvite ?? undefined}>
  <div class="pg-main">
  <section class="pg-card" aria-labelledby="pg-net-heading">
    <div class="pg-head pg-head--status">
      <h2 id="pg-net-heading">1. Network</h2>
      <span class="pg-chips" data-demo={demoInvite ? "" : undefined}>
        <span class="pg-pill" id="pg-weft" data-state="pending">Looking for Weft…</span>
        <span class="pg-pill" id="pg-demo" data-state="pending" hidden={!demoInvite}>Demo network</span>
      </span>
      <script is:inline>
        // An invite in the address opens the page on that network, not the
        // demo's: before the first paint, so the chip is never shown.
        if (new URLSearchParams(location.search).get("invite")) document.getElementById("pg-demo").hidden = true;
      </script>
    </div>
    <form class="field" id="pg-invite-form" novalidate>
      <label for="pg-invite">Invite URL</label>
      <div class="pg-row" id="pg-invite-row">
        <input id="pg-invite" class="input" type="url" placeholder={demoInvite ?? "http://localhost:8787/.well-known/weft-invite.json"} spellcheck="false" aria-describedby="pg-invite-status" />
        <button type="submit" id="pg-load" class="btn">Load invite</button>
      </div>
      <p class="field__status" id="pg-invite-error"></p>
    </form>
    <p class="pg-hint" id="pg-invite-status">
      {demoInvite ? "Loading the demo network. Or paste any organisation's invite URL." : <Fragment>Run <code>pnpm playground:up</code> for a local network, or paste any organisation's invite URL.</Fragment>}
    </p>
    <div class="action-error" id="pg-invite-failed" role="alert" hidden></div>
    <dl class="pg-details" id="pg-invite-details" hidden>
      <dt>Network</dt><dd id="pg-net"></dd>
      <dt>Organisation</dt><dd id="pg-org"></dd>
      <dt>Channels</dt><dd class="mono" id="pg-channels"></dd>
    </dl>
  </section>

  <section class="pg-card" aria-labelledby="pg-id-heading">
    <div class="pg-head pg-head--status">
      <h2 id="pg-id-heading">2. Identity</h2>
      <span class="pg-pill" id="pg-conn" data-state="pending">Not connected</span>
    </div>
    <div class="pg-row pg-wrap">
      <button type="button" id="pg-join" class="btn" disabled>Join with Weft</button>
      <button type="button" id="pg-connect" class="btn btn--primary" disabled>Connect</button>
      <button type="button" id="pg-disconnect" class="btn" hidden>Disconnect</button>
    </div>
    <p class="pg-hint pg-why" id="pg-id-why" data-looking><a href={docs("/start/install/")}>Install Weft</a> in this browser, then reload this page to join and connect.</p>
    <div class="action-error" id="pg-id-error" role="alert" hidden></div>
    <p class="pg-hint">
      Join once to enrol (local demo users: <code>alice</code>/<code>alicepw</code>, <code>bob</code>/<code>bobpw</code>),
      then connect this page.
    </p>
    <dl class="pg-details" id="pg-identity" hidden>
      <dt>Name</dt><dd id="pg-id-name"></dd>
      <dt>MSP ID</dt><dd class="mono" id="pg-id-msp"></dd>
      <dt>Role</dt><dd class="mono" id="pg-id-role"></dd>
      <dt>Attributes</dt><dd class="mono" id="pg-id-attrs"></dd>
      <dt>Expires</dt><dd id="pg-id-exp"></dd>
    </dl>
  </section>

  <section class="pg-card" aria-labelledby="pg-call-heading">
    <h2 id="pg-call-heading">3. Call the contract</h2>
    <div class="pg-presets" role="group" aria-labelledby="pg-presets-label">
      <span class="pg-hint" id="pg-presets-label">Examples for the basic contract:</span>
      <button type="button" class="btn btn--small" data-preset="InitLedger" aria-pressed="false">InitLedger</button>
      <button type="button" class="btn btn--small" data-preset="GetAllAssets" aria-pressed="true">GetAllAssets</button>
      <button type="button" class="btn btn--small" data-preset="ReadAsset" aria-pressed="false">ReadAsset</button>
      <button type="button" class="btn btn--small" data-preset="CreateAsset" aria-pressed="false">CreateAsset</button>
      <button type="button" class="btn btn--small" data-preset="TransferAsset" aria-pressed="false">TransferAsset</button>
      <button type="button" class="btn btn--small" data-preset="DeleteAsset" aria-pressed="false">DeleteAsset</button>
    </div>
    <div class="pg-grid">
      <div class="field">
        <label for="pg-channel">Channel</label>
        <span class="select"><select id="pg-channel" class="input"><button><selectedcontent></selectedcontent></button><option value="mychannel">mychannel</option></select></span>
        <p class="field__status" aria-hidden="true"></p>
      </div>
      <div class="field">
        <label for="pg-chaincode">Contract <span class="field__hint">chaincode name</span></label>
        <input id="pg-chaincode" class="input mono" value="basic" spellcheck="false" />
        <p class="field__status" id="pg-chaincode-error"></p>
      </div>
      <div class="field">
        <label for="pg-fn">Function</label>
        <input id="pg-fn" class="input mono" value="GetAllAssets" spellcheck="false" />
        <p class="field__status" id="pg-fn-error"></p>
      </div>
    </div>
    <div class="field">
      <span class="field__label" id="pg-args-label">Arguments</span>
      <div id="pg-args" class="pg-args" role="group" aria-labelledby="pg-args-label"></div>
      <p class="pg-hint" id="pg-args-empty">No arguments. Add one if the function takes any.</p>
      <button type="button" id="pg-add-arg" class="btn btn--text">Add argument</button>
    </div>
    <div class="pg-row pg-wrap">
      <button type="button" id="pg-evaluate" class="btn btn--primary" disabled>Evaluate (read)</button>
      <button type="button" id="pg-submit" class="btn btn--write" disabled>Submit (write)</button>
    </div>
    <p class="pg-hint pg-why" id="pg-call-why" data-looking>Calls go through Weft, which isn't installed in this browser.</p>
    <p class="pg-hint" id="pg-suggest" hidden></p>
    <div id="pg-result-wrap" class="pg-stack" hidden>
      <h3>Result</h3>
      <div class="pg-result-slot">
        <div class="action-error" id="pg-result-error" role="alert" hidden></div>
        <pre id="pg-result" class="pg-out pg-out--result"></pre>
      </div>
      <a id="pg-result-explorer" class="pg-out-link" target="_blank" rel="noreferrer" hidden>View in the explorer</a>
      <h3>The same call in code</h3>
      <pre id="pg-code" class="pg-out"></pre>
    </div>
  </section>

  <section class="pg-card" aria-labelledby="pg-el-heading">
    <div class="pg-head pg-head--status">
      <h2 id="pg-el-heading">4. Vote in an election</h2>
      <span class="pg-pill" id="pg-el-state" data-state="pending">Connect first</span>
    </div>
    <p class="pg-hint">
      Uses the <a href={docs("/guides/elections/")}>ballot contract</a>, which the local playground deploys with an open election, <code>board-2026</code>.
      Your choice is sent as private data. The ledger gets only a commitment, which your receipt lets you check.
    </p>
    <form class="field" id="pg-el-form" novalidate>
      <label for="pg-el-id">Election ID</label>
      <div class="pg-row" id="pg-el-row">
        <input id="pg-el-id" class="input mono" value="board-2026" spellcheck="false" />
        <button type="submit" id="pg-el-load" class="btn" disabled>Load election</button>
      </div>
      <p class="field__status" id="pg-el-id-error"></p>
    </form>
    <p class="pg-hint pg-why" id="pg-el-why" data-looking>Calls go through Weft, which isn't installed in this browser.</p>
    <div class="action-error" id="pg-el-error" role="alert" hidden></div>
    <div id="pg-el" class="pg-stack" hidden>
      <dl class="pg-details">
        <dt>Election</dt><dd id="pg-el-title"></dd>
        <dt>Voting</dt><dd id="pg-el-closes"></dd>
        <dt>Result</dt><dd id="pg-el-result"></dd>
      </dl>
      <fieldset class="pg-options" id="pg-el-options"><legend class="pg-hint">Your choice</legend></fieldset>
      <div class="pg-row pg-wrap">
        <button type="button" id="pg-el-vote" class="btn btn--write" disabled>Cast vote</button>
        <button type="button" id="pg-el-close" class="btn" hidden>Close and count</button>
      </div>
      <div class="action-error" id="pg-vote-error" role="alert" hidden></div>
    </div>
    <p class="pg-hint" id="pg-el-message" tabindex="-1"></p>
    <div id="pg-receipt" class="pg-stack" hidden>
      <h3>Your receipt</h3>
      <p class="pg-hint">Keep it. With the choice and the salt, anyone can check this commitment is your vote; without them, no one can tell.</p>
      <p class="pg-receipt-line pg-receipt-line--unsaved" id="pg-receipt-saved">This page doesn't keep your receipt. Save it before you leave.</p>
      <pre id="pg-receipt-json" class="pg-out" data-tone="ok"></pre>
      <div class="pg-row pg-wrap">
        <button type="button" id="pg-receipt-download" class="btn btn--primary">Download receipt</button>
        <button type="button" id="pg-receipt-copy" class="btn">Copy receipt</button>
        <a id="pg-receipt-check" class="btn" target="_blank" rel="noreferrer" hidden>Check your receipt in the explorer</a>
      </div>
      <div class="action-error" id="pg-receipt-error" role="alert" hidden></div>
    </div>
    <details class="disclosure pg-new" id="pg-new">
      <summary>Start your own election</summary>
      <form class="pg-stack" id="pg-new-form" novalidate>
        <div class="pg-grid">
          <div class="field">
            <label for="pg-new-id">ID</label>
            <input id="pg-new-id" class="input mono" placeholder="lunch-friday" spellcheck="false" />
            <p class="field__status" id="pg-new-id-error"></p>
          </div>
          <div class="field">
            <label for="pg-new-title">Question</label>
            <input id="pg-new-title" class="input" placeholder="Where should we eat?" />
            <p class="field__status" id="pg-new-title-error"></p>
          </div>
          <div class="field">
            <label for="pg-new-options">Choices <span class="field__hint">separated by commas</span></label>
            <input id="pg-new-options" class="input" placeholder="Noodles, Tacos" />
            <p class="field__status" id="pg-new-options-error"></p>
          </div>
          <div class="field">
            <label for="pg-new-minutes">Voting closes in</label>
            <span class="select"><select id="pg-new-minutes" class="input"><button><selectedcontent></selectedcontent></button><option value="2">2 minutes</option><option value="10">10 minutes</option><option value="60">1 hour</option><option value="1440">1 day</option></select></span>
            <p class="field__status" aria-hidden="true"></p>
          </div>
        </div>
        <div>
          <button type="submit" id="pg-new-create" class="btn btn--write" disabled>Create election</button>
        </div>
        <div class="action-error" id="pg-new-error" role="alert" hidden></div>
        <p class="pg-hint">When the voting time ends, only your organisation can close the election. Closing counts the private ballots and publishes the result.</p>
      </form>
    </details>
  </section>

  <PrivateElection />

  <section class="pg-card" id="pg-explorers" aria-labelledby="pg-ex-heading" hidden>
    <div class="pg-head">
      <h2 id="pg-ex-heading">5. Compare the explorers</h2>
      <button type="button" id="pg-ex-refresh" class="btn btn--text">Refresh</button>
    </div>
    <p class="pg-hint">
      Each organisation runs its own <a href={docs("/operators/explorer/")}>explorer</a>, reads the ledger from its own peer, and publishes only what its
      policy allows. They compare signed checkpoints, so every block page says how many organisations report the same block.
    </p>
    <div class="action-error" id="pg-ex-error" role="alert" hidden></div>
    <ul class="pg-explorers" id="pg-ex-list"></ul>
    <h3>Things to try</h3>
    <ul class="pg-try" id="pg-ex-try"></ul>
  </section>

  </div>

  <aside class="pg-card pg-log-card" aria-labelledby="pg-log-heading">
    <div class="pg-head">
      <h2 id="pg-log-heading">Provider log</h2>
      <button type="button" id="pg-clear" class="btn btn--text">Clear log</button>
    </div>
    <p class="pg-hint">Every <code>window.weft</code> request and response, with timings, as this page sends and receives them.</p>
    <p class="pg-hint" id="pg-log-empty">No requests yet. Connect or call a function to see them here.</p>
    <ol id="pg-log" class="pg-log"></ol>
  </aside>
</div>

<script>
  import { announce, clearError, closesInReverse, conceal, fetchProblem, isBusy, isWebUrl, reveal, setBusy, shortened, showError, technical, watchFields } from "@weftwallet/ui/ui";
  import { onWallets, wallets } from "@weftwallet/ui/wallets";
  import { log, logged } from "../scripts/provider-log.ts";

  const LOCAL_INVITE = "http://localhost:8787/.well-known/weft-invite.json";

  type Preset = { fn: string; args: string[]; kind: "evaluate" | "submit" };
  const PRESETS: Record<string, Preset> = {
    InitLedger: { fn: "InitLedger", args: [], kind: "submit" },
    GetAllAssets: { fn: "GetAllAssets", args: [], kind: "evaluate" },
    ReadAsset: { fn: "ReadAsset", args: ["asset1"], kind: "evaluate" },
    CreateAsset: { fn: "CreateAsset", args: ["asset7", "teal", "5", "Ifeanyi", "300"], kind: "submit" },
    TransferAsset: { fn: "TransferAsset", args: ["asset6", "Christopher"], kind: "submit" },
    DeleteAsset: { fn: "DeleteAsset", args: ["asset7"], kind: "submit" },
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const w = window as any;
  /** The other products this page links to, from @weftwallet/brand's registry. */
  const root = document.querySelector<HTMLElement>(".pg")!;
  /** The public demo network's invite, when one is hosted (products.json, "demo"). */
  const DEMO_INVITE = root.dataset.demoInvite || null;
  const docsAt = (path: string) => new URL(path, root.dataset.docs).toString();
  const networkPage = (explorer: string) => `${new URL("/", root.dataset.network)}?explorer=${encodeURIComponent(explorer)}`;
  const dateOf = (d: string | number) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
  const timeOf = (d: string | number) => new Date(d).toLocaleString("en-GB", { day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" });
  let weft: any = null;
  let connected = false;
  /** The organisation's explorer, when the invite names one. */
  let explorerBase: string | null = null;
  // Declared here because updateButtons, which runs as the page loads, reads them.
  let election: Election | null = null;
  let myMsp: string | null = null;
  /** Elections this page has voted in, so it doesn't offer a second ballot. */
  const votedIn = new Set<string>();

  /** What a wallet error means for the person, in words. */
  function walletProblem(error: any, fallback = "Weft couldn't complete the request.", declined = "You rejected the request in Weft, so nothing was sent. Try again when you're ready."): string {
    switch (error?.code) {
      case 4001:
        return declined;
      case 4100:
        return "This page isn't connected to Weft. Connect in step 2, then try again.";
      case 4300:
        return "Weft has no identity yet. Use Join with Weft in step 2 first.";
      case 4301:
        return "Your certificate has expired. Renew it in Weft, then try again.";
      case -32002:
        return "Weft already has a request from this page waiting. Finish it in the Weft window first.";
      case 5001:
        return "The network rejected the call. The reason is under Details.";
      case 5002:
        return "Weft couldn't reach the network's relay. Check that the network is running, then try again.";
      default:
        return fallback;
    }
  }

  /* ---------------- log ---------------- */

  async function call(method: string, params?: unknown) {
    if (!weft) throw Object.assign(new Error("Weft isn't installed in this browser."), { code: "missing" });
    try {
      return await logged(weft, method, params);
    } catch (error: any) {
      // 4100: the wallet no longer treats this site as connected.
      if (error?.code === 4100 && connected) setConnected(false);
      throw error;
    }
  }

  /* ---------------- wallet detection ---------------- */

  /**
   * Whether Weft is in this browser. Not a warning when it isn't: the chip
   * stays neutral and offers the install page.
   */
  function setWeftPill(state: "ok" | "missing") {
    const pill = $("pg-weft");
    clearTimeout(lookingLoader);
    pill.classList.remove("is-working");
    pill.dataset.state = state;
    if (state === "ok") {
      pill.textContent = `Weft ${weft.version} detected`;
      return;
    }
    pill.replaceChildren("Weft not found. ", Object.assign(document.createElement("a"), { href: docsAt("/start/install/"), textContent: "Install it" }));
  }
  // The chip says it is looking; the loader joins it only if the look takes a while.
  const lookingLoader = window.setTimeout(() => $("pg-weft").dataset.state === "pending" && $("pg-weft").classList.add("is-working"), 300);

  /**
   * Sections for a feature only some Weft builds have, marked data-feature
   * (PrivateElection.astro): shown only when a Weft in this browser lists it,
   * window.weft or another that announced itself (docs/adr/0010). With Weft
   * and Weft Experimental both installed, the section uses the one that
   * lists it.
   */
  function showFeatureSections() {
    const features = new Set<unknown>(Array.isArray(weft?.features) ? weft.features : []);
    for (const wallet of wallets()) for (const feature of wallet.provider.features ?? []) features.add(feature);
    for (const section of document.querySelectorAll<HTMLElement>("[data-feature]")) {
      section.hidden = !features.has(section.dataset.feature);
    }
  }
  onWallets(showFeatureSections);

  function detect() {
    if (w.weft?.isWeft) {
      if (weft) return;
      weft = w.weft;
      setWeftPill("ok");
      showFeatureSections();
      weft.on("identityChanged", (identity: any) => {
        log("•", "event identityChanged", identity);
        showIdentity(identity);
        announce(`Identity in Weft is now ${identity?.name ?? "none"}.`);
      });
      weft.on("networkChanged", (payload: any) => {
        log("•", "event networkChanged", payload);
        selectChannel(payload.channel);
      });
      weft.on("certificateStatus", (payload: any) => {
        log("•", "event certificateStatus", payload);
        $("pg-id-exp").textContent = payload.state === "expired" ? "Expired, renew it in Weft" : `${dateOf(payload.notAfter)} (${payload.daysLeft} days left)`;
      });
      weft.on("disconnect", (payload: any) => {
        log("•", "event disconnect", payload);
        setConnected(false, DISCONNECT_REASONS[payload?.reason] ?? "Disconnected");
      });
      void refreshIdentity();
      updateButtons();
      return;
    }
    setWeftPill("missing");
    updateButtons();
  }
  // Weft may announce itself after the page gives up looking; detect() then runs again.
  window.addEventListener("weft#initialized", detect);
  setTimeout(() => !weft && detect(), 1200);

  const DISCONNECT_REASONS: Record<string, string> = {
    user: "Disconnected in Weft",
    site: "Disconnected",
    "no-identity": "No identity in Weft",
    "wallet-updated": "Weft was updated. Reload this page.",
    "identity-changed": "Identity switched in Weft. Connect again.",
  };

  function setConnected(value: boolean, label?: string) {
    const changed = value !== connected;
    connected = value;
    const pill = $("pg-conn");
    pill.dataset.state = value ? "ok" : "pending";
    pill.textContent = label ?? (value ? "Connected" : "Not connected");
    if (!value) showIdentity(null);
    // The button that had focus may be hidden now: focus what took its place.
    const had = document.activeElement;
    updateButtons();
    if (had === $("pg-connect") && value) $("pg-disconnect").focus();
    if (had === $("pg-disconnect") && !value) $("pg-connect").focus();
    if (changed || label) announce(value ? "Connected to Weft." : `${pill.textContent}.`.replace(/\.\.$/, "."));
  }

  function selectChannel(channel: string) {
    const select = $<HTMLSelectElement>("pg-channel");
    if (![...select.options].some((o) => o.value === channel)) {
      select.append(Object.assign(document.createElement("option"), { value: channel, textContent: channel }));
    }
    select.value = channel;
  }

  async function refreshIdentity() {
    try {
      const identity = await weft.request({ method: "weft_identity" });
      if (identity) {
        showIdentity(identity);
        setConnected(true);
        return;
      }
    } catch {
      /* not connected */
    }
    updateButtons();
  }

  function showIdentity(identity: any) {
    if (!identity) {
      conceal($("pg-identity"));
      return;
    }
    $("pg-id-name").textContent = identity.name;
    $("pg-id-msp").textContent = identity.mspId;
    $("pg-id-role").textContent = identity.role ?? "none";
    const attrs = Object.entries(identity.attributes ?? {}).filter(([k]) => !k.startsWith("hf."));
    $("pg-id-attrs").textContent = attrs.length ? attrs.map(([k, v]) => `${k}=${v}`).join(", ") : "none";
    $("pg-id-exp").textContent = dateOf(identity.notAfter);
    reveal($("pg-identity"));
  }

  /**
   * Says why a control is unavailable, next to it (SYSTEM.md, Disabled).
   * While the page looks for Weft each line holds its place, unseen, with
   * the words it shows if Weft isn't found (data-looking), so the answer
   * never moves what is below it.
   */
  function why(id: string, text: string | Node[] | null) {
    const p = $(id);
    delete p.dataset.looking;
    if (!text) {
      p.hidden = true;
      return;
    }
    if (typeof text === "string") p.textContent = text;
    else p.replaceChildren(...text);
    p.hidden = false;
  }

  const installLink = () => Object.assign(document.createElement("a"), { href: docsAt("/start/install/"), textContent: "Install Weft" });

  function updateButtons() {
    const haveInvite = Boolean(inviteUrl());
    const looking = !weft && $("pg-weft").dataset.state === "pending";
    $<HTMLButtonElement>("pg-join").disabled = !weft || !haveInvite;
    $<HTMLButtonElement>("pg-connect").disabled = !weft;
    $("pg-connect").hidden = connected;
    $("pg-disconnect").hidden = !connected;
    for (const id of ["pg-evaluate", "pg-submit", "pg-el-load", "pg-new-create"]) {
      const b = $<HTMLButtonElement>(id);
      if (!isBusy(b)) b.disabled = !weft || !connected;
    }
    // While looking, the lines keep their reserved place (why()).
    if (!looking) {
      if (!weft) why("pg-id-why", [installLink(), document.createTextNode(" in this browser, then reload this page to join and connect.")]);
      else if (!haveInvite && !connected) why("pg-id-why", "To join, load an invite in step 1 first. Connect works once you've joined.");
      else why("pg-id-why", null);
      const callWhy = !weft ? "Calls go through Weft, which isn't installed in this browser." : !connected ? "Connect in step 2 to call the contract." : null;
      why("pg-call-why", callWhy);
      why("pg-el-why", callWhy && callWhy.replace("call the contract", "load an election"));
    }
    updateElectionButtons();
    if (!connected) setElectionState("pending", weft ? "Connect first" : "Install Weft");
    else if ($("pg-el-state").textContent === "Connect first") setElectionState("pending", "Not loaded");
  }

  /* ---------------- invite ---------------- */

  function inviteUrl(): string | null {
    const value = $<HTMLInputElement>("pg-invite").value.trim();
    return isWebUrl(value) ? new URL(value).toString() : null;
  }

  const inviteField = watchFields([
    {
      field: $<HTMLInputElement>("pg-invite"),
      after: $("pg-invite-row"),
      check: () => {
        const value = $<HTMLInputElement>("pg-invite").value.trim();
        if (!value) return "Enter your organisation's invite URL.";
        return isWebUrl(value) ? null : "Enter a full address starting with http:// or https://.";
      },
    },
  ]);

  async function loadInvite(quiet = false) {
    const url = inviteUrl();
    updateButtons();
    if (!url) return;
    const button = $("pg-load");
    setBusy(button, true);
    clearError($("pg-invite-failed"));
    try {
      const response = await fetch(url, { headers: { accept: "application/json" }, signal: AbortSignal.timeout(8000) });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const invite = await response.json();
      if (!invite?.network || !Array.isArray(invite.channels)) throw new Error("Not a Weft invite: it has no network or channels.");
      $("pg-net").textContent = invite.network;
      $("pg-org").textContent = `${invite.organization} (${invite.mspId})`;
      $("pg-channels").textContent = invite.channels.join(", ");
      reveal($("pg-invite-details"));
      $("pg-invite-status").textContent = `Loaded from ${new URL(url).host}.`;
      const select = $<HTMLSelectElement>("pg-channel");
      // Options only: the button shows the chosen one (select.css).
      select.querySelectorAll("option").forEach((o) => o.remove());
      select.append(...invite.channels.map((c: string) => Object.assign(document.createElement("option"), { value: c, textContent: c })));
      explorerBase = typeof invite.explorerUrl === "string" ? invite.explorerUrl.replace(/\/+$/, "") : null;
      // The Private election section lists elections from this explorer (PrivateElection.astro).
      root.dataset.explorer = explorerBase ?? "";
      // Elections with voter credentials have their voter invites at the relay (PrivateElection.astro).
      const relayBase = typeof invite.relayUrl === "string" ? invite.relayUrl.replace(/\/+$/, "") : null;
      root.dataset.relay = relayBase ?? "";
      root.dispatchEvent(new CustomEvent("pg:invite", { detail: { explorerUrl: explorerBase, relayUrl: relayBase, network: invite.network } }));
      if (!quiet) announce(`Invite loaded: ${invite.network}.`);
      void loadExplorers();
    } catch (error: any) {
      conceal($("pg-invite-details"));
      $("pg-invite-status").textContent = DEMO_INVITE && url === new URL(DEMO_INVITE).toString() ? "The demo network didn't answer. Try again in a moment, or paste another organisation's invite URL." : "No invite loaded.";
      if (!quiet) {
        const sentence = /^Not a Weft invite/.test(error?.message) ? "That address answered, but not with a Weft invite. Check you have the invite's URL." : fetchProblem(error, "The invite's address");
        showError($("pg-invite-failed"), sentence, `${url}\n${error?.message ?? error}`);
      }
    } finally {
      setBusy(button, false);
      updateButtons();
    }
  }

  const fromQuery = new URLSearchParams(location.search).get("invite");
  if (fromQuery) {
    $<HTMLInputElement>("pg-invite").value = fromQuery;
    void loadInvite();
  } else if (DEMO_INVITE) {
    // The demo network is the default; the chip says so.
    $<HTMLInputElement>("pg-invite").value = DEMO_INVITE;
    $("pg-demo").hidden = false;
    void loadInvite(true);
  } else {
    // Quietly look for the local playground stack.
    fetch(LOCAL_INVITE, { signal: AbortSignal.timeout(1500) })
      .then((r) => {
        if (!r.ok) return;
        $<HTMLInputElement>("pg-invite").value = LOCAL_INVITE;
        $("pg-invite-status").textContent = "Found the local playground stack.";
        void loadInvite(true);
      })
      .catch(() => {});
  }
  $("pg-invite-form").addEventListener("submit", (e) => {
    e.preventDefault();
    if (isBusy($("pg-load")) || !inviteField.checkAll()) return;
    void loadInvite();
  });
  $("pg-invite").addEventListener("input", () => {
    $("pg-demo").hidden = !DEMO_INVITE || inviteUrl() !== new URL(DEMO_INVITE).toString();
    updateButtons();
  });

  /* ---------------- identity actions ---------------- */

  $("pg-join").addEventListener("click", async () => {
    const button = $("pg-join");
    const url = inviteUrl();
    if (!url || isBusy(button)) return;
    setBusy(button, true);
    clearError($("pg-id-error"));
    try {
      const result = await call("weft_addNetwork", { url });
      const text = result?.added === false ? "Weft already has this network. Connect this page to use it." : "Weft added the network. Now connect this page.";
      why("pg-id-why", text);
      announce(text);
    } catch (error) {
      showError($("pg-id-error"), walletProblem(error, "Weft couldn't add the network.", "You rejected the request in Weft, so the network wasn't added. Join again when you're ready."), technical(error));
    } finally {
      setBusy(button, false);
    }
  });

  $("pg-connect").addEventListener("click", async () => {
    const button = $<HTMLButtonElement>("pg-connect");
    if (isBusy(button)) return;
    setBusy(button, true);
    clearError($("pg-id-error"));
    try {
      showIdentity(await call("weft_connect"));
      setBusy(button, false);
      setConnected(true);
    } catch (error) {
      showError($("pg-id-error"), walletProblem(error, "Weft couldn't connect this page.", "You rejected the request in Weft, so this page isn't connected. Connect again when you're ready."), technical(error));
    } finally {
      setBusy(button, false);
      updateButtons();
    }
  });

  // The wallet answers with a disconnect event, which updates the page.
  $("pg-disconnect").addEventListener("click", () =>
    void call("weft_disconnect").catch((error) => showError($("pg-id-error"), walletProblem(error, "Weft couldn't disconnect this page."), technical(error))),
  );

  /* ---------------- contract calls ---------------- */

  function argInputs() {
    return Array.from($("pg-args").querySelectorAll<HTMLInputElement>("input"));
  }

  /** Numbers the arguments from 1, after one is added or removed. */
  function renumber() {
    argInputs().forEach((input, i) => {
      input.setAttribute("aria-label", `Argument ${i + 1}`);
      input.placeholder = `Argument ${i + 1}`;
      input.nextElementSibling?.setAttribute("aria-label", `Remove argument ${i + 1}`);
    });
    $("pg-args-empty").hidden = argInputs().length > 0;
  }

  function addArg(value = "") {
    const row = document.createElement("div");
    row.className = "pg-arg";
    const input = Object.assign(document.createElement("input"), { value, className: "input mono", spellcheck: false });
    const remove = Object.assign(document.createElement("button"), { type: "button", textContent: "Remove", className: "btn btn--text" });
    remove.addEventListener("click", () => {
      // Focus goes to the next argument, or the previous, or Add argument.
      const rows = [...$("pg-args").children];
      const next = (rows[rows.indexOf(row) + 1] ?? rows[rows.indexOf(row) - 1])?.querySelector("input");
      row.remove();
      renumber();
      (next ?? $("pg-add-arg")).focus();
    });
    row.append(input, remove);
    $("pg-args").append(row);
    renumber();
    return input;
  }
  $("pg-add-arg").addEventListener("click", () => addArg().focus());

  function applyPreset(name: string) {
    const preset = PRESETS[name];
    if (!preset) return;
    $<HTMLInputElement>("pg-fn").value = preset.fn;
    $("pg-args").replaceChildren();
    preset.args.forEach((a) => addArg(a));
    renumber();
    document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.preset === name)));
    callFields.clear();
    const suggest = $("pg-suggest");
    suggest.textContent = preset.kind === "evaluate" ? `${preset.fn} only reads the ledger: use Evaluate.` : `${preset.fn} changes the ledger: use Submit.`;
    suggest.hidden = false;
  }
  document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((b) => b.addEventListener("click", () => applyPreset(b.dataset.preset!)));
  // Typing a function of your own means no example is chosen.
  $("pg-fn").addEventListener("input", () => {
    document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.preset === $<HTMLInputElement>("pg-fn").value.trim())));
    $("pg-suggest").hidden = true;
  });
  renumber();

  const callFields = watchFields([
    { field: $<HTMLInputElement>("pg-chaincode"), check: () => ($<HTMLInputElement>("pg-chaincode").value.trim() ? null : "Enter the contract's chaincode name, for example basic.") },
    { field: $<HTMLInputElement>("pg-fn"), check: () => ($<HTMLInputElement>("pg-fn").value.trim() ? null : "Enter the function to call, for example GetAllAssets.") },
  ]);

  function currentCall() {
    return {
      channel: $<HTMLSelectElement>("pg-channel").value,
      chaincode: $<HTMLInputElement>("pg-chaincode").value.trim(),
      fn: $<HTMLInputElement>("pg-fn").value.trim(),
      args: argInputs().map((i) => i.value),
    };
  }

  function codeFor(kind: "evaluate" | "submit", c: ReturnType<typeof currentCall>) {
    const args = c.args.map((a) => JSON.stringify(a)).join(", ");
    return `import { getWeft } from "@weftwallet/sdk";

const weft = await getWeft();
const contract = weft.contract({ channel: ${JSON.stringify(c.channel)}, chaincode: ${JSON.stringify(c.chaincode)} });
const result = await contract.${kind}(${[JSON.stringify(c.fn), args].filter(Boolean).join(", ")});`;
  }

  async function run(kind: "evaluate" | "submit") {
    const pressed = $<HTMLButtonElement>(kind === "submit" ? "pg-submit" : "pg-evaluate");
    const other = $<HTMLButtonElement>(kind === "submit" ? "pg-evaluate" : "pg-submit");
    if (isBusy(pressed) || isBusy(other) || !callFields.checkAll()) return;
    const c = currentCall();
    // One wait, one loader: the pressed button's (setBusy). The result box
    // says what it is waiting for, in words, in a space kept for the result,
    // and a commit's explorer link has its line kept too, so nothing below
    // moves when the answer arrives.
    reveal($("pg-result-wrap"));
    const link = $<HTMLAnchorElement>("pg-result-explorer");
    link.hidden = !(kind === "submit" && explorerBase);
    link.dataset.waiting = "";
    clearError($("pg-result-error"));
    $("pg-code").textContent = codeFor(kind, c);
    const result$ = $("pg-result");
    result$.hidden = false;
    result$.textContent = kind === "submit" ? "Waiting for approval, endorsement and commit…" : "Waiting for approval…";
    result$.dataset.tone = "pending";
    setBusy(pressed, true);
    other.disabled = true;
    try {
      const result = await call(kind === "submit" ? "weft_submit" : "weft_evaluate", c);
      let pretty = result.text;
      try {
        pretty = JSON.stringify(JSON.parse(result.text), null, 2);
      } catch {
        /* not JSON */
      }
      const meta = kind === "submit" ? `Committed in block ${result.blockNumber}, transaction ${shortened(String(result.transactionId))}\n\n` : "";
      result$.textContent = `${meta}${pretty ?? `(binary result, base64) ${result.base64}`}` || "(empty result)";
      result$.dataset.tone = "ok";
      showTxLink(link, kind === "submit" ? c.channel : null, result.transactionId);
      delete link.dataset.waiting;
      announce(kind === "submit" ? `Committed in block ${result.blockNumber}. The result is below.` : "The result is below.");
      if (kind === "submit") void loadExplorers();
    } catch (error) {
      result$.hidden = true;
      showError($("pg-result-error"), walletProblem(error, kind === "submit" ? "The transaction wasn't committed." : "The call didn't return a result."), technical(error));
    } finally {
      setBusy(pressed, false);
      updateButtons();
    }
  }

  $("pg-evaluate").addEventListener("click", () => void run("evaluate"));
  $("pg-submit").addEventListener("click", () => void run("submit"));
  $("pg-clear").addEventListener("click", () => {
    $("pg-log").replaceChildren();
    $("pg-log-empty").hidden = false;
  });

  /** Links a committed transaction to the organisation's explorer, if there is one. */
  function showTxLink(link: HTMLAnchorElement, channel: string | null, txId: string | undefined) {
    if (!explorerBase || !channel || !txId) {
      link.hidden = true;
      return;
    }
    link.href = `${explorerBase}/channels/${encodeURIComponent(channel)}/transactions/${encodeURIComponent(txId)}`;
    link.hidden = false;
  }

  /* ---------------- elections ---------------- */

  type Election = {
    id: string;
    title: string;
    options: string[];
    closesAt: string;
    creatorMsp: string;
    state: "open" | "closed";
    tally?: { counts: Record<string, number>; total: number };
  };

  const electionChannel = () => $<HTMLSelectElement>("pg-channel").value;
  const ballot = (fn: string, args: string[], transient?: Record<string, string>) => ({
    channel: electionChannel(),
    chaincode: "ballot",
    fn,
    args,
    ...(transient ? { transient } : {}),
  });

  function setElectionState(state: "ok" | "pending" | "missing", text: string) {
    const pill = $("pg-el-state");
    pill.dataset.state = state;
    pill.textContent = text;
  }

  function electionMessage(text: string) {
    $("pg-el-message").textContent = text;
    if (text) announce(text);
  }

  const RUN_AN_ELECTION = "This network has no ballot contract. The local playground deploys one; for your own network, see Run an election in the docs.";

  /** The contract's own sentence, when it gave one; null otherwise. */
  function contractSays(error: any): string | null {
    const detail = error?.data?.details?.map((d: any) => d.message).find(Boolean) ?? error?.message ?? String(error);
    if (/chaincode ballot not found|could not find chaincode with name 'ballot'|ballot.*not.*(found|installed|defined)/i.test(detail)) return RUN_AN_ELECTION;
    const m = detail.match(/(There's no election.*|Voting has closed.*|This identity has already voted.*|Only \S+ can close.*|Voting is open until.*)/);
    return m ? m[1] : null;
  }

  /** Shows an election error: the contract's sentence or a plain one, with the rest behind Details. */
  function electionError(box: string, error: any, fallback: string) {
    showError($(box), contractSays(error) ?? walletProblem(error, fallback), technical(error));
  }

  const isOpen = (e: Election) => e.state === "open" && Date.now() < Date.parse(e.closesAt);

  function chosen(): string | null {
    return $("pg-el-options").querySelector<HTMLInputElement>("input:checked")?.value ?? null;
  }

  function updateElectionButtons() {
    const vote = $<HTMLButtonElement>("pg-el-vote");
    const voted = !!election && votedIn.has(election.id);
    if (!isBusy(vote)) {
      vote.disabled = !connected || !election || !isOpen(election) || !chosen() || voted;
      vote.textContent = voted ? "Voted" : "Cast vote";
    }
    $("pg-el-options").querySelectorAll<HTMLInputElement>("input").forEach((i) => (i.disabled = !election || !isOpen(election) || voted));
    const close = $<HTMLButtonElement>("pg-el-close");
    close.hidden = !election || election.state !== "open" || isOpen(election) || election.creatorMsp !== myMsp;
    if (!isBusy(close)) close.disabled = !connected;
  }

  /** Updates the election in place, so a chosen or focused option survives. */
  function showElection(e: Election) {
    election = e;
    reveal($("pg-el"));
    $("pg-el-title").textContent = e.title;
    const closes = timeOf(e.closesAt);
    $("pg-el-closes").textContent = e.state === "closed" ? "Closed and counted" : isOpen(e) ? `Open until ${closes}` : `Closed at ${closes}, not counted yet`;
    $("pg-el-result").textContent = e.tally
      ? Object.entries(e.tally.counts)
          .sort((a, b) => b[1] - a[1])
          .map(([o, n]) => `${o} ${n}`)
          .join(" · ") + ` (${e.tally.total} ballots)`
      : "Published when the election is closed";
    const options = $("pg-el-options");
    const have = [...options.querySelectorAll<HTMLInputElement>("input")].map((i) => i.value);
    if (have.join("\n") !== e.options.join("\n")) {
      const previous = chosen();
      options.querySelectorAll("label").forEach((l) => l.remove());
      for (const option of e.options) {
        const label = document.createElement("label");
        label.className = "pg-option";
        const input = Object.assign(document.createElement("input"), { type: "radio", name: "pg-el-option", value: option, checked: option === previous });
        input.addEventListener("change", updateElectionButtons);
        label.append(input, document.createTextNode(option));
        options.append(label);
      }
    }
    options.hidden = e.state === "closed";
    setElectionState("ok", e.state === "closed" ? "Counted" : isOpen(e) ? "Open" : "Voting closed");
    updateElectionButtons();
  }

  const electionField = watchFields([
    { field: $<HTMLInputElement>("pg-el-id"), after: $("pg-el-row"), check: () => ($<HTMLInputElement>("pg-el-id").value.trim() ? null : "Enter the election's ID, for example board-2026.") },
  ]);

  /**
   * Loads an election. The busy control is Load election, or, when another
   * action ends by loading (Create election), that action's button, which
   * stays busy through the load: one wait, one loader.
   */
  async function loadElection(id = $<HTMLInputElement>("pg-el-id").value.trim(), button = $("pg-el-load")) {
    if (!id) return;
    setBusy(button, true);
    clearError($("pg-el-error"));
    $("pg-el-message").textContent = "";
    try {
      myMsp = (await weft.request({ method: "weft_identity" }))?.mspId ?? null;
      const result = await call("weft_evaluate", ballot("GetElection", [id]));
      const e = JSON.parse(result.text) as Election;
      if (election?.id !== e.id) {
        $("pg-el-options").querySelectorAll("label").forEach((l) => l.remove());
        clearError($("pg-vote-error"));
      }
      showElection(e);
      announce(`Loaded ${e.title}. ${$("pg-el-closes").textContent}.`);
    } catch (error) {
      election = null;
      conceal($("pg-el"));
      const said = contractSays(error);
      setElectionState("missing", said && /There's no election/.test(said) ? "Not found" : "Not loaded");
      electionError("pg-el-error", error, "The election couldn't be loaded.");
      updateElectionButtons();
    } finally {
      setBusy(button, false);
      updateButtons();
    }
  }

  async function castVote() {
    const option = chosen();
    const button = $<HTMLButtonElement>("pg-el-vote");
    if (!election || !option || isBusy(button)) return;
    setBusy(button, true);
    clearError($("pg-vote-error"));
    // The salt is the voter's secret: without it, no one can tell which choice
    // the commitment is for. Weft chooses it, and puts it in both the ballot
    // and the receipt, when this page sends "generate" in both.
    const salt = "generate";
    const channel = electionChannel();
    try {
      electionMessage(`You're voting for ${option}. Weft lists it as a private input called "ballot", hidden until you choose Show.`);
      const result = await call("weft_submit", {
        ...ballot("CastVote", [election.id], { ballot: JSON.stringify({ option, salt }) }),
        // Weft checks this against the ballot, and offers to keep it.
        receipt: { type: "weft-ballot-receipt", version: 1, channel, electionId: election.id, option, salt },
      });
      // Weft returns the finished receipt whether or not the voter kept it.
      const receipt: Receipt = result.receipt!.receipt;
      votedIn.add(election.id);
      showReceipt(receipt, result.receipt ?? null);
      electionMessage(`Your ballot is in block ${result.blockNumber}. Your receipt is below.`);
      void loadExplorers();
    } catch (error: any) {
      if (/already voted/.test(contractSays(error) ?? "")) votedIn.add(election.id);
      $("pg-el-message").textContent = "";
      if (error?.code === -32602) {
        // Weft checks the receipt before it opens a window.
        showError($("pg-vote-error"), "Weft refused the request because of the receipt this page sent. Nothing was signed.", technical(error));
      } else {
        electionError("pg-vote-error", error, "Your vote wasn't committed.");
      }
    } finally {
      setBusy(button, false);
      updateElectionButtons();
    }
  }

  /**
   * A ballot receipt: what the voter needs to check their ballot later. The
   * file Download receipt saves and the text Copy receipt copies are the same
   * JSON, which the explorer's Check your receipt form reads back.
   */
  type Receipt = {
    type: "weft-ballot-receipt";
    version: 1;
    channel: string;
    electionId: string;
    txId: string;
    blockNumber: number;
    commitment: string;
    option: string;
    salt: string;
  };
  let shownReceipt: Receipt | null = null;
  /** Whether Weft kept the receipt shown, so the saved line can say it has a copy too. */
  let keptInWeft = false;
  const receiptFileName = (r: Receipt) => `weft-receipt-${r.electionId.replace(/[^A-Za-z0-9_-]/g, "-")}-block-${r.blockNumber}.json`;

  /** What Weft said about the receipt: null from a Weft that doesn't make receipts. */
  type ReceiptResult = { kept: true; receipt: Receipt } | { kept: false; reason: "declined" | "storage" | "mismatch"; receipt: Receipt };

  function showReceipt(r: Receipt, weftSays: ReceiptResult | null) {
    shownReceipt = r;
    keptInWeft = weftSays?.kept === true;
    // This page keeps nothing, so until the receipt is saved somewhere, it
    // says so. When Weft kept it, the same line says that instead.
    const line = $("pg-receipt-saved");
    const [tone, text] = keptInWeft
      ? ["kept", "Weft kept your receipt. It's with this vote in your Weft activity, and you can still download or copy it here."]
      : weftSays?.kept === false && weftSays.reason === "storage"
        ? ["unsaved", "Weft couldn't keep your receipt. Save it before you leave."]
        : weftSays?.kept === false && weftSays.reason === "mismatch"
          ? ["unsaved", "Weft didn't keep your receipt. Save it before you leave."]
          : ["unsaved", "This page doesn't keep your receipt. Save it before you leave."];
    line.className = `pg-receipt-line pg-receipt-line--${tone}`;
    line.textContent = text;
    clearError($("pg-receipt-error"));
    reveal($("pg-receipt"));
    $("pg-receipt-json").textContent = JSON.stringify(r, null, 2);
    const link = $<HTMLAnchorElement>("pg-receipt-check");
    if (explorerBase) {
      // Only the public part goes in the address. The choice and salt go to
      // the explorer's page by message once it asks (checkInExplorer).
      const query = new URLSearchParams({ tx: r.txId, commitment: r.commitment });
      link.href = `${explorerBase}/channels/${encodeURIComponent(r.channel)}/elections/${encodeURIComponent(r.electionId)}?${query}#receipt`;
      link.hidden = false;
    } else {
      link.hidden = true;
    }
  }

  /**
   * Opens the explorer's election page and, once it asks, gives it the
   * choice and salt by postMessage, to that window and the explorer's exact
   * origin only, so they never go in an address the browser's history keeps.
   * The page asks with a message that carries nothing, and sends nothing
   * back. Without noopener, or it couldn't ask.
   */
  let handoff: { win: Window; origin: string; receipt: Receipt } | null = null;
  function checkInExplorer(e: MouseEvent) {
    const link = e.currentTarget as HTMLAnchorElement;
    if (!shownReceipt || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const win = window.open(link.href, "_blank");
    if (!win) return; // the link opens it, and the voter enters the choice and salt there
    e.preventDefault();
    handoff = { win, origin: new URL(link.href).origin, receipt: shownReceipt };
  }
  window.addEventListener("message", (e) => {
    if (!handoff || e.source !== handoff.win || e.origin !== handoff.origin) return;
    if (e.data?.type !== "weft-receipt-check:ready" || e.data.version !== 1) return;
    const r = handoff.receipt;
    handoff.win.postMessage({ type: "weft-receipt-check:receipt", version: 1, electionId: r.electionId, txId: r.txId, option: r.option, salt: r.salt }, handoff.origin);
    if (r === shownReceipt) receiptSaved("The explorer asked for your choice and salt, and this page gave them to it. It checks them in your browser.");
  });

  /** The notice is replaced, in its place, by where the receipt went, so nothing below it moves. */
  function receiptSaved(text: string) {
    const line = $("pg-receipt-saved");
    line.textContent = text;
    line.className = "pg-receipt-line pg-receipt-line--saved arrive";
    announce(text);
  }

  function downloadReceipt() {
    if (!shownReceipt) return;
    const name = receiptFileName(shownReceipt);
    const url = URL.createObjectURL(new Blob([$("pg-receipt-json").textContent ?? ""], { type: "application/json" }));
    const a = Object.assign(document.createElement("a"), { href: url, download: name });
    a.hidden = true;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    clearError($("pg-receipt-error"));
    receiptSaved(`Downloaded as ${name}.${keptInWeft ? " Weft has a copy too." : ""}`);
  }

  async function closeElection() {
    const button = $<HTMLButtonElement>("pg-el-close");
    if (!election || isBusy(button)) return;
    setBusy(button, true);
    clearError($("pg-vote-error"));
    try {
      const result = await call("weft_submit", ballot("CloseElection", [election.id]));
      setBusy(button, false);
      showElection(JSON.parse(result.text));
      // The close button is gone now: focus the result it produced.
      if (document.activeElement === button || !document.activeElement || document.activeElement === document.body) $("pg-el-message").focus();
      electionMessage(`Counted in block ${result.blockNumber}. Each explorer now compares this result with the commitments it has.`);
      void loadExplorers();
    } catch (error) {
      electionError("pg-vote-error", error, "The election couldn't be closed.");
    } finally {
      setBusy(button, false);
      updateElectionButtons();
    }
  }

  const newFields = watchFields([
    {
      field: $<HTMLInputElement>("pg-new-id"),
      check: () => {
        const v = $<HTMLInputElement>("pg-new-id").value.trim();
        if (!v) return "Give the election an ID, for example lunch-friday.";
        return /\s/.test(v) ? "Use an ID without spaces, for example lunch-friday." : null;
      },
    },
    { field: $<HTMLInputElement>("pg-new-title"), check: () => ($<HTMLInputElement>("pg-new-title").value.trim() ? null : "Write the question people will vote on.") },
    {
      field: $<HTMLInputElement>("pg-new-options"),
      check: () => {
        const options = $<HTMLInputElement>("pg-new-options").value.split(",").map((o) => o.trim()).filter(Boolean);
        if (options.length < 2) return "Give at least two choices, separated by commas.";
        return new Set(options).size < options.length ? "Each choice can appear only once." : null;
      },
    },
  ]);

  async function createElection() {
    const button = $<HTMLButtonElement>("pg-new-create");
    if (isBusy(button) || !newFields.checkAll()) return;
    const id = $<HTMLInputElement>("pg-new-id").value.trim();
    const title = $<HTMLInputElement>("pg-new-title").value.trim();
    const options = $<HTMLInputElement>("pg-new-options").value.split(",").map((o) => o.trim()).filter(Boolean);
    const minutes = Number($<HTMLSelectElement>("pg-new-minutes").value);
    const closesAt = new Date(Date.now() + minutes * 60_000).toISOString();
    setBusy(button, true);
    clearError($("pg-new-error"));
    try {
      await call("weft_submit", ballot("CreateElection", [id, title, JSON.stringify(options), closesAt]));
      $<HTMLInputElement>("pg-el-id").value = id;
      conceal($("pg-receipt"));
      await loadElection(id, button);
      setBusy(button, false);
      closeNew();
      $("pg-el-id").focus();
      electionMessage(`Created ${id}. Vote now; once voting closes, come back and close it to count.`);
    } catch (error) {
      electionError("pg-new-error", error, "The election wasn't created.");
    } finally {
      setBusy(button, false);
      updateButtons();
    }
  }
  const closeNew = closesInReverse($<HTMLDetailsElement>("pg-new"));

  $("pg-el-form").addEventListener("submit", (e) => {
    e.preventDefault();
    if (isBusy($("pg-el-load")) || isBusy($("pg-new-create")) || $<HTMLButtonElement>("pg-el-load").disabled || !electionField.checkAll()) return;
    void loadElection();
  });
  $("pg-el-vote").addEventListener("click", () => void castVote());
  $("pg-el-close").addEventListener("click", () => void closeElection());
  $("pg-new-form").addEventListener("submit", (e) => {
    e.preventDefault();
    if (!$<HTMLButtonElement>("pg-new-create").disabled) void createElection();
  });
  $("pg-receipt-download").addEventListener("click", downloadReceipt);
  $<HTMLAnchorElement>("pg-receipt-check").addEventListener("click", checkInExplorer);
  $("pg-receipt-copy").addEventListener("click", async () => {
    const button = $("pg-receipt-copy");
    clearError($("pg-receipt-error"));
    try {
      await navigator.clipboard.writeText($("pg-receipt-json").textContent ?? "");
      button.textContent = "Copied";
      receiptSaved(keptInWeft ? "Copied. Weft has a copy too." : "Copied. Paste it somewhere you'll keep it.");
      setTimeout(() => (button.textContent = "Copy receipt"), 2000);
    } catch {
      getSelection()?.selectAllChildren($("pg-receipt-json"));
      showError($("pg-receipt-error"), "This browser didn't allow copying. The receipt is selected: press Ctrl+C, or Cmd+C on a Mac.");
    }
  });
  // An open election closes while the page is open; keep the buttons honest.
  // Updated in place, so nothing the person is doing is disturbed.
  setInterval(() => election && election.state === "open" && showElection(election), 15_000);

  /* ---------------- explorers ---------------- */

  type ChannelStatus = {
    channel: string;
    height: number;
    level: string;
    publishes?: { values: "show" | "hash"; submitter: "show" | "hide"; privateData?: "names" | "hashes"; membersOnly: string[]; elections: boolean };
  };
  type Peer = { url: string; mspId: string | null; state: string; agreedUpTo: number | null; mismatchAt: number | null };

  async function getJson(url: string) {
    const response = await fetch(url, { signal: AbortSignal.timeout(4000), headers: { accept: "application/json" } });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json();
  }

  function describe(c: ChannelStatus | undefined): string {
    if (!c) return "Doesn't publish this channel to everyone. If it's for members, sign in on this explorer to see it.";
    if (!c.publishes) return `Publishes ${c.channel} (${c.level}).`;
    const p = c.publishes;
    const parts = [
      p.values === "show" ? "values shown" : "values as hashes",
      p.submitter === "show" ? "submitters shown" : "submitters hidden",
    ];
    if (p.membersOnly.length) parts.push(`members only: ${p.membersOnly.join(", ")}`);
    if (p.privateData === "hashes") parts.push("private data hashes");
    if (p.elections) parts.push("election pages");
    return `${c.level === "members" ? "Members only" : "Public"}: ${parts.join(", ")}.`;
  }

  function agreement(peers: Peer[]): string {
    if (peers.length === 0) return "Not comparing with other organisations.";
    return peers
      .map((p) => {
        const who = p.mspId ?? new URL(p.url).host;
        if (p.state === "agree") return `Agrees with ${who} up to block ${p.agreedUpTo}.`;
        if (p.state === "mismatch") return `Disagrees with ${who} from block ${p.mismatchAt}.`;
        if (p.state === "unreachable") return `Can't reach ${who}.`;
        return `Checking with ${who}…`;
      })
      .join(" ");
  }

  /** One explorer's row, made once and updated in place on every refresh. */
  function explorerRow(base: string) {
    const list = $("pg-ex-list");
    let li = list.querySelector<HTMLElement>(`li[data-base="${CSS.escape(base)}"]`);
    if (!li) {
      li = Object.assign(document.createElement("li"), { className: "pg-explorer arrive" });
      li.dataset.base = base;
      const head = Object.assign(document.createElement("div"), { className: "pg-head" });
      head.append(Object.assign(document.createElement("a"), { target: "_blank", rel: "noreferrer" }), Object.assign(document.createElement("span"), { className: "pg-pill" }));
      li.append(head, Object.assign(document.createElement("p"), { className: "pg-hint" }), Object.assign(document.createElement("p"), { className: "pg-hint" }));
      list.append(li);
    }
    return li;
  }

  /**
   * Reads the explorers. Busy only on a press of Refresh: after a commit or
   * an invite, the pressed control has had its loader for that wait, and the
   * rows update in place without another.
   */
  async function loadExplorers(pressed = false) {
    const card = $("pg-explorers");
    if (!explorerBase) {
      conceal(card);
      return;
    }
    reveal(card);
    const button = $("pg-ex-refresh");
    if (pressed) setBusy(button, true);
    clearError($("pg-ex-error"));
    const channel = electionChannel();
    // The invite names this organisation's explorer; it knows the others.
    let peers: Peer[] = [];
    try {
      peers = await getJson(`${explorerBase}/api/v1/channels/${encodeURIComponent(channel)}/organisations`);
    } catch (error: any) {
      showError($("pg-ex-error"), `Couldn't ask ${new URL(explorerBase).host} for the other organisations' explorers. Refresh to try again.`, `${explorerBase}\n${error?.message ?? error}`);
    }
    const bases = [explorerBase, ...peers.map((p) => p.url.replace(/\/+$/, ""))];
    const rows = await Promise.all(
      bases.map(async (base) => {
        try {
          const [status, theirPeers] = await Promise.all([
            getJson(`${base}/api/v1/status`),
            getJson(`${base}/api/v1/channels/${encodeURIComponent(channel)}/organisations`).catch(() => []),
          ]);
          const c = (status.channels as ChannelStatus[]).find((x) => x.channel === channel);
          return { base, name: status.name as string, c, peers: theirPeers as Peer[], ok: true };
        } catch {
          return { base, name: new URL(base).host, c: undefined, peers: [], ok: false };
        }
      }),
    );
    const list = $("pg-ex-list");
    list.querySelectorAll<HTMLElement>("li[data-base]").forEach((li) => !bases.includes(li.dataset.base!) && li.remove());
    for (const r of rows) {
      const li = explorerRow(r.base);
      const link = li.querySelector("a")!;
      link.href = `${r.base}/channels/${encodeURIComponent(channel)}`;
      link.textContent = `${r.name}'s explorer`;
      const pill = li.querySelector<HTMLElement>(".pg-pill")!;
      pill.textContent = r.ok ? (r.c ? `${r.c.height} blocks` : "Not public") : "Unreachable";
      pill.dataset.state = r.ok ? (r.c ? "ok" : "pending") : "missing";
      const [what, agree] = li.querySelectorAll("p");
      what!.textContent = r.ok ? describe(r.c) : `Couldn't reach ${r.base}. Check that it's running, then refresh.`;
      agree!.textContent = r.ok && r.c ? agreement(r.peers) : "";
      agree!.hidden = !(r.ok && r.c);
      list.append(li);
    }
    const block = Math.max(1, (rows[0]?.c?.height ?? 2) - 1);
    const tries: [string, string | null][] = rows.some((r) => r.c)
      ? [[`Open block ${block} on each explorer: the same block, and each says how many organisations report it.`, null]]
      : [];
    const members = rows.find((r) => r.c?.publishes?.membersOnly.length);
    if (members) {
      tries.push([
        `Sign in to ${members.name}'s explorer with Weft to see what it publishes to members only (${members.c!.publishes!.membersOnly.join(", ")}).`,
        `${members.base}/channels/${encodeURIComponent(channel)}`,
      ]);
    }
    const hiding = rows.find((r) => r.c?.publishes?.submitter === "hide");
    if (hiding) tries.push([`Compare a transaction on ${hiding.name}'s explorer: it doesn't say who submitted it.`, null]);
    const ballots = rows.find((r) => r.c?.publishes?.elections);
    if (ballots) {
      tries.push([`See the elections, their ballots and results, and check a receipt.`, `${ballots.base}/channels/${encodeURIComponent(channel)}/elections`]);
    }
    if (rows.every((r) => r.ok && !r.c)) {
      tries.push([`Sign in on Weft Network with Weft to see ${channel}, if your organisation is a member.`, networkPage(explorerBase)]);
    }
    tries.push([`See every organisation's explorer on one page, and compare a block's hash across them.`, networkPage(explorerBase)]);
    // The suggestions change rarely; only rebuilt when they do, so focus on a link survives.
    const key = JSON.stringify(tries);
    const tryList = $("pg-ex-try");
    if (tryList.dataset.key !== key) {
      tryList.dataset.key = key;
      tryList.replaceChildren(
        ...tries.map(([text, href]) => {
          const li = document.createElement("li");
          if (href) li.append(Object.assign(document.createElement("a"), { href, target: "_blank", rel: "noreferrer", textContent: text }));
          else li.textContent = text;
          return li;
        }),
      );
    }
    if (pressed) setBusy(button, false);
  }
  $("pg-ex-refresh").addEventListener("click", () => !isBusy($("pg-ex-refresh")) && void loadExplorers(true));
</script>

<style is:global>
  /* Global because the arguments and log rows are created by the script, which
     Astro's scoped styles would not reach. Every selector is under .pg.
     Buttons, inputs, fields and errors are base.css's. */
  .pg,
  .pg-main {
    display: flex;
    flex-direction: column;
    gap: var(--weft-space-5);
  }
  .pg {
    margin-top: var(--weft-space-6);
    /* A chip's height: its line, its padding and its border. */
    --pg-chip-height: calc(var(--weft-leading-xs) + var(--weft-space-1) * 2 + 2px);
  }
  /* At desktop widths the provider log sits beside the form and stays in
     view, so a request and its decoded form can be read together. */
  @media (min-width: 1100px) {
    .pg {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 400px);
      align-items: start;
    }
    .pg-log-card {
      position: sticky;
      top: calc(60px + var(--weft-space-4));
      max-height: calc(100vh - 60px - var(--weft-space-8));
      overflow: hidden;
    }
    .pg-log-card .pg-log {
      max-height: none;
      flex: 1 1 auto;
      min-height: 0;
    }
  }
  .pg-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--weft-space-2);
  }
  /* A card's status: its own line under the heading, with the chips from
     its start, so a chip that changes (Looking for Weft…, then Weft not
     found, or Connected) grows into empty space and never moves anything.
     The line is a chip tall even before a chip shows. In a card too narrow
     for Weft's chip and the demo network's side by side they stack, and
     with a demo network the line keeps room for both, since the demo chip
     goes when another invite is typed. */
  .pg-head.pg-head--status {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--weft-space-2);

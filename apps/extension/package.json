{
  "name": "@weftwallet/extension",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Weft: an identity wallet for Hyperledger Fabric",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:experimental": "WEFT_EXPERIMENTAL=1 wxt",
    "dev:firefox:experimental": "WEFT_EXPERIMENTAL=1 wxt -b firefox",
    "build": "wxt build",
    "build:experimental": "WEFT_EXPERIMENTAL=1 wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox:experimental": "WEFT_EXPERIMENTAL=1 wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "build:e2e": "WEFT_E2E=1 wxt build",
    "build:e2e:experimental": "WEFT_E2E=1 WEFT_EXPERIMENTAL=1 wxt build",
    "check:normal": "node scripts/check-normal-build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@weftwallet/brand": "workspace:*",
    "@weftwallet/core": "workspace:*",
    "@weftwallet/idemix": "workspace:*",
    "@weftwallet/protocol": "workspace:*",
    "@weftwallet/tally": "workspace:*",
    "@weftwallet/ui": "workspace:*",
    "jsqr": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@peculiar/x509": "^2.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}

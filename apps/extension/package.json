    "@weftwallet/protocol": "workspace:*",
    "jsqr": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }

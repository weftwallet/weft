{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM for the full check's worker, which runs in the browser, and for the
    // idemix module's types (WebAssembly), which the indexer runs in Node.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/test"]
}

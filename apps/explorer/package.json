{
  "name": "@weftwallet/explorer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "A block explorer that one Fabric organisation runs for the channels it chooses to publish",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node ../../scripts/dev.mjs --conditions=weft-source --disable-warning=ExperimentalWarning --watch src/main.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/main.js",
    "test": "vitest run",
    "sample": "node --disable-warning=ExperimentalWarning src/test/serve-sample.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@grpc/grpc-js": "^1.14.6",
    "@hyperledger/fabric-gateway": "^1.13.0",
    "@hyperledger/fabric-protos": "^0.3.7",
    "@weftwallet/brand": "workspace:*",
    "@weftwallet/core": "workspace:*",
    "@weftwallet/ui": "workspace:*",
    "fastify": "^5.12.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@peculiar/x509": "^2.2.0",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^26.6.5",
    "google-protobuf": "^3.21.4",
    "reflect-metadata": "^0.2.2",
    "vitest": "^5.0.5"
  }
}
